# HakiOS fragment: the OnePlus 13 (dodge, devices/dodge) -- what is true of this phone and of no other
# with the same SoC. The SoC's facts (the SM8750 family's addresses) are soc/configs/sun.config's;
# the common kernel's defaults build in what a phone of this project shares. Here: the drivers this
# phone replaces or adds, what stays out, and the boot arguments of the working boot.
CONFIG_DEVICE="dodge"

# ---- what is built in: this phone's own drivers (drivers/<subsystem>/conf in this repository) ----
# the touch screen: a Synaptics S3910, this phone's own (synaptics=1) -- it takes the common GOODIX
# slot, which stays out with the reference phone's SPI bus and pins
CONFIG_HAKIOS_SYNAPTICS=y
# CONFIG_HAKIOS_GOODIX is not set
# the panel's own brightness (/dev/brightness, DCS51), and the alert slider's three positions
CONFIG_HAKIOS_BRIGHTNESS=y
CONFIG_HAKIOS_SLIDER=y
# the AudioReach graph builder, beside the common audio drivers (adsp=1 sound=4)
CONFIG_HAKIOS_APM_GRAPH=y
# the battery through the audio DSP's GLINK service (batt_dsp=4 batt_dsp_wait=20)
CONFIG_HAKIOS_BATTERY_ADSP=y
# Bluetooth over PCIe (bt=4 pcie_bt_en=1), and the WCN7850's MHI state adopted from the
# loader's bring-up (wifi=1) -- the common BT (the reference's WCN6750 pin probe) stays out
CONFIG_HAKIOS_BT_PCIE=y
# CONFIG_HAKIOS_BT is not set
CONFIG_HAKIOS_MHI=y
# the GPU: the Adreno 830 and the HakiosGPU service Mesa draws through (adreno8=23 gpu=1);
# the reference phone's Adreno 642L driver stays out
CONFIG_HAKIOS_ADRENO8=y
CONFIG_HAKIOS_GPU_SERVICE=y
# CONFIG_HAKIOS_ADRENO is not set

# ---- what the common kernel's defaults build in that this phone does not want ----
# the microphones (mic=N): the WCD9395's capture path, K90's shapes on this same silicon
CONFIG_HAKIOS_MIC=y
CONFIG_HAKIOS_RPMH=y
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_SOCINFO is not set
# the vibration motor (haptic=N): this phone's own, the PMIC's hv-haptics block
CONFIG_HAKIOS_HAPTIC=y
# the modem is not brought up: its arguments go with it
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# the phone's flash through the loader's block service: a block device for each GPT partition (ufs=1, ufs=2)
# and for the data volume mapped in Android's userdata (hakios_data=1, docs/data-persistence.md)
CONFIG_HAKIOS_UFS=y
# the Synaptics driver is started by synaptics=1, not the common touchscreen argument
# CONFIG_TOUCHSCREEN is not set
# the Iris VPU's hardware decode: written, not yet run on this phone
# the Iris VPU's H.264/HEVC hardware decode (the VideoToolbox plugin rides it)
CONFIG_HAKIOS_IRIS=y

# ---- the arguments of the working boot (SEEN on the phone, November 2026) ----
# four cores (the proven configuration; the loader's platform_dodge numbers all eight, and cpus=8
# has been seen to work too -- when the run is to try it, override on the command line)
CONFIG_CPUS=4
CONFIG_BUTTONS=y
# the touch screen and the buttons' pin: GPIO6 of the PM8550VS is peripheral 0x18d of slave 1,
# APID 610 owner EE 0 (buttons_swap=1: this phone's wiring is the reverse of the reference's)
CONFIG_BOOTARGS="synaptics=1 buttons_pin=0x18d buttons_swap=1"
