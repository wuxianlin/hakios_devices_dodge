# devices/dodge/drivers/wifi/conf: this phone's Wi-Fi support files (docs/drivers-config.md). The
# network itself is the common Wi-Fi driver, rewritten for the WCN7850 (patches/xnu-dodge.patch,
# the common WIFI symbol); what is here is the MHI state the loader's bring-up leaves, adopted.

driver MHI
	file    bsd/dev/hakios.mhi.c
	file    bsd/dev/hakios.mhi_transport.c
	file    bsd/dev/hakios.mhi_host.h
	file    bsd/dev/hakios.mhi_handoff.h
	file    bsd/dev/hakios.mhi_mmio.h
	file    bsd/dev/hakios.mhi_qrtr.h
	file    bsd/dev/hakios.mhi_qrtr.inc
	file    bsd/dev/hakios.mhi_wake.h
	file    bsd/dev/hakios.mhi_window.h
	file    bsd/dev/hakios.mhi_wire.h
	help    the WCN7850 radio's MHI state, adopted from the loader's bring-up: the reserved DMA
	help    lease the UEFI handoff leaves (touch_lease_pa=), its rings polled, the QRTR and WLFW
	help    capabilities verified -- no PCIe reset, SMMU remap or firmware bootstrap in the kernel
