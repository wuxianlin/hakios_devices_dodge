+					printf("adsp: THE GRAPH (variant %u) IS ANSWERED: opcode %#x, %u bytes: the echoed command %#x,"
+					    " the status %u\n", variant, apr_answer.opcode, apr_answer.length, apr_answer.words[0],
+					    apr_answer.words[1]);
