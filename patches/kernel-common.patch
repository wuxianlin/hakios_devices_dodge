+				    0x02001002u, NULL);
+				apr_wait_now = APR_WAIT_MS;
+			}
+			gpr_dst_port = was;
+		}
+	}
+	/* the starts, ALWAYS before the first write -- shennong's order (its audio
+	 * plays): the graph starts and is fed within milliseconds. A started graph
+	 * that no data ever reached has died about two minutes in, twice */
+	if (!reach_graph_cmd("the speaker's subgraph started", 0x01001002, REACH_SG_SPEAKER)) {
+		return false;
+	}
+	if (!reach_graph_cmd("the stream's subgraph started", 0x01001002, REACH_SG_PLAY)) {
+		return false;
+	}
+	{
+		uint32_t step = 0;
+
+		PE_parse_boot_argn("sound_step", &step, sizeof(step));
+		if (step == 5) {
+			say("sound: STEP 5: the flow stops here, both subgraphs started, no data written\n");
+			return false;
+		}
+	}
+
+		say("sound: the write block ENTERED\n");
+	/* the first write, exactly shennong's form -- the form that PLAYS there:
+	 * eleven words {addr, handle, size} and zeros to the end, fire-and-forget,
+	 * the token WRITE_TOKEN | the period. NO 0xff00 flags word and NO
