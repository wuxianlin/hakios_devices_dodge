+				}
+				sleep_ms(20);
+			}
+			if (!os_atomic_load(&apr_answer.there, acquire)) {
+				printf("adsp: the graph, variant %u: no answer in three seconds\n", variant);
+			}
+		}
+		lck_mtx_unlock(&apr_lock);
+		sleep_ms(300);
+	}
