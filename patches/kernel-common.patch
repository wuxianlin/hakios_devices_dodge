+static const char *
+hakios_status(struct hakios_volume *h, char out[64])
+{
+	char *p = out, tmp[24];
+	uint64_t v;
+	int i;
+
+	if (!h->loaded) {
+		return "none";
+	}
+	for (v = h->n_ext, i = 0; v; v /= 10) {
+		tmp[i++] = (char)('0' + v % 10);
+	}
+	while (i) {
+		*p++ = tmp[--i];
+	}
+	memcpy(p, " extents, ", 10), p += 9;
+	for (v = h->blocks, i = 0; v; v /= 10) {
+		tmp[i++] = (char)('0' + v % 10);
+	}
+	while (i) {
+		*p++ = tmp[--i];
+	}
+	memcpy(p, " blocks", 8);
+	return out;
