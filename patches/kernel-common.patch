+/* SPDX-License-Identifier: BSD-2-Clause
+ * Native CNSS notification/host-capability wire formats. Diagnostic only:
+ * collect memory requirements; do not supply unowned addresses to firmware.
+ */
+#ifndef OP13_WIFI_QMI_INIT_H
+#define OP13_WIFI_QMI_INIT_H
+#include "op13_wifi_qmi.h"
+struct op13_qmi_message {uint32_t flags,transaction,id;size_t size;const uint8_t *tlvs;};
+struct op13_qmi_memory {
+ unsigned count;
+ struct {uint32_t size,type,cfg_count;struct {uint64_t offset;uint32_t size;unsigned secure;} cfg[2];} seg[52];
+};
+static int op13_qmi_message_decode(const uint8_t *b,size_t n,struct op13_qmi_message *p)
+{
+ if(n<7||op13_qmi_u16(b+5)!=n-7)return -1;
+ p->flags=b[0];p->transaction=op13_qmi_u16(b+1);p->id=op13_qmi_u16(b+3);p->size=n-7;p->tlvs=b+7;
+ for(size_t at=0;at<p->size;){
+  if(p->size-at<3)return -1;
+  size_t len=op13_qmi_u16(p->tlvs+at+1);at+=3;if(len>p->size-at)return -1;at+=len;
+ }
+ return 0;
+}
+static int op13_qmi_result(const struct op13_qmi_message *p,uint32_t *result,uint32_t *error)
+{
+ if(p->flags!=2)return -1;
+ unsigned found=0;
+ for(size_t at=0;at<p->size;){
+  unsigned type=p->tlvs[at];size_t len=op13_qmi_u16(p->tlvs+at+1);at+=3;
+  if(type==2){if(len!=4||found++)return -1;*result=op13_qmi_u16(p->tlvs+at);*error=op13_qmi_u16(p->tlvs+at+2);}
+  at+=len;
+ }
+ return found?0:-1;
+}
+static int op13_qmi_mem_decode(const struct op13_qmi_message *p,struct op13_qmi_memory *m)
+{
+ if(p->flags!=4||p->id!=0x35)return -1;
+ m->count=0;unsigned found=0;
+ for(size_t at=0;at<p->size;){
+  unsigned type=p->tlvs[at];size_t len=op13_qmi_u16(p->tlvs+at+1);at+=3;
+  const uint8_t *v=p->tlvs+at;at+=len;
+  if(type!=1)continue;
+  if(!len||found++||v[0]>52)return -1;
+  unsigned count=v[0];size_t pos=1;
+  for(unsigned i=0;i<count;i++){
+   if(len-pos<9)return -1;
+   m->seg[i].size=op13_qrtr_u32(v+pos);m->seg[i].type=op13_qrtr_u32(v+pos+4);
+   unsigned n=v[pos+8];pos+=9;if(n>2||n*13>len-pos)return -1;m->seg[i].cfg_count=n;
+   for(unsigned j=0;j<n;j++,pos+=13){
+    uint64_t off=op13_qrtr_u32(v+pos)|(uint64_t)op13_qrtr_u32(v+pos+4)<<32;
+    uint32_t size=op13_qrtr_u32(v+pos+8);unsigned secure=v[pos+12];
+    if(off>m->seg[i].size||size>m->seg[i].size-off||secure>1)return -1;
+    m->seg[i].cfg[j].offset=off;m->seg[i].cfg[j].size=size;m->seg[i].cfg[j].secure=secure;
+   }
+  }
+  if(pos!=len)return -1;m->count=count;
+ }
+ return found?0:-1;
+}
+static size_t op13_qmi_request(uint8_t *b,size_t capacity,uint32_t node,uint32_t port,unsigned transaction,unsigned id,const uint8_t *tlvs,size_t size)
+{
+ size_t length=39+size,padded=(length+3)&~(size_t)3;
+ if(size>6200||padded>capacity||transaction>65535||id>65535)return 0;
+ for(size_t i=0;i<padded;i++)b[i]=0;
+ op13_qrtr_put(b,1);op13_qrtr_put(b+4,1);op13_qrtr_put(b+8,1);op13_qrtr_put(b+12,0x4000);
+ op13_qrtr_put(b+20,7+size);op13_qrtr_put(b+24,node);op13_qrtr_put(b+28,port);
+ b[33]=transaction;b[34]=transaction>>8;b[35]=id;b[36]=id>>8;b[37]=size;b[38]=size>>8;
+ for(size_t i=0;i<size;i++)b[39+i]=tlvs[i];return padded;
+}
+/* First32MiB contains live host/TX/RDDM buffers. Last page holds RX vectors.
+ * Plan the whole request before giving the endpoint any new addresses. */
+static int op13_qmi_memory_plan(const struct op13_qmi_memory *m,uint64_t pool_bytes,uint64_t offsets[52])
+{
+ uint64_t at=0x2000000ULL;unsigned seen=0;
+ if(!m->count||m->count>3||pool_bytes<at+4096)return -1;
+ for(unsigned i=0;i<m->count;i++){
+  uint32_t type=m->seg[i].type;uint64_t size=m->seg[i].size;
+  if((type!=1&&type!=4&&type!=11)||!size||size>pool_bytes||m->seg[i].cfg_count)return -1;
+  if(seen&(1u<<type))return -1;seen|=1u<<type;
+  uint64_t align=4096;while(align<size)align<<=1;
+  at=(at+align-1)&~(align-1);
+  if(at>pool_bytes-4096||size>pool_bytes-4096-at)return -1;
+  offsets[i]=at;at+=size;
+ }
+ return 0;
+}
+/* Native BDF request: total_size is remaining bytes, not original length. */
+static size_t op13_qmi_bdf_chunk(uint8_t *b,size_t capacity,unsigned board,unsigned type,unsigned segment,
+                               uint32_t remaining,const uint8_t *data,size_t bytes)
+{
+ if(!bytes||bytes>6144||bytes>remaining||capacity<38+bytes||!data||type>255)return 0;
+ size_t at=0;
+ b[at++]=1;b[at++]=1;b[at++]=0;b[at++]=1;
+ const uint32_t values[]={board,remaining,segment};
+ for(unsigned i=0;i<3;i++){b[at++]=0x10+i;b[at++]=4;b[at++]=0;op13_qrtr_put(b+at,values[i]);at+=4;}
+ b[at++]=0x13;b[at++]=(bytes+2)&255;b[at++]=(bytes+2)>>8;b[at++]=bytes&255;b[at++]=bytes>>8;
+ for(size_t i=0;i<bytes;i++)b[at++]=data[i];
+ b[at++]=0x14;b[at++]=1;b[at++]=0;b[at++]=bytes==remaining;
+ b[at++]=0x15;b[at++]=1;b[at++]=0;b[at++]=type;
+ return at;
+}
+/* Native QDSS config: TLVs10 total remaining,11 segment,12 bytes,13 end. */
+static size_t op13_qmi_config_chunk(uint8_t *b,size_t capacity,unsigned segment,
+                                  uint32_t remaining,const uint8_t *data,size_t bytes)
+{
+ if(!b||!data||!bytes||bytes>6144||bytes>remaining||capacity<23+bytes)return 0;
+ size_t at=0;const uint32_t values[]={remaining,segment};
+ for(unsigned i=0;i<2;i++){b[at++]=0x10+i;b[at++]=4;b[at++]=0;op13_qrtr_put(b+at,values[i]);at+=4;}
+ b[at++]=0x12;b[at++]=(bytes+2)&255;b[at++]=(bytes+2)>>8;b[at++]=bytes&255;b[at++]=bytes>>8;
+ for(size_t i=0;i<bytes;i++)b[at++]=data[i];
+ b[at++]=0x13;b[at++]=1;b[at++]=0;b[at++]=bytes==remaining;
+ return at;
+}
+#endif
diff --git a/xnuloader/op13_wifi_qmp.h b/xnuloader/op13_wifi_qmp.h
new file mode 100644
index 0000000..e5f50fe
--- /dev/null
+++ b/xnuloader/op13_wifi_qmp.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Bounded AOSS-QMP sender for the exact WLAN PDC initialization from phone DT.
+ * Protocol layout matches native battery's already validated AOP mailbox path.
+ * Does not reset an existing link or clear an unacknowledged message.
+ */
+#ifndef OP13_WIFI_QMP_H
+#define OP13_WIFI_QMP_H
+#include <stdint.h>
+struct op13_wifi_qmp_io {
+ void *context;
+ uint32_t (*read)(void *,uint32_t);
+ void (*write)(void *,uint32_t,uint32_t);
+ void (*ring)(void *);
+ void (*delay)(void *,unsigned);
+};
+static const char *const op13_wifi_pdc_messages[]={
+ "{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}",
+ "{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}",
+ "{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}",
+ "{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}"
+};
+static int op13_wifi_qmp_wait(const struct op13_wifi_qmp_io *io,uint32_t reg,uint32_t value)
+{
+ for(unsigned i=0;i<10000;i++){
+  if(io->read(io->context,reg)==value)return 0;
+  io->delay(io->context,100);
+ }
+ return -1;
+}
+static int op13_wifi_qmp_box(const struct op13_wifi_qmp_io *io,uint32_t *box)
+{
+ if(io->read(io->context,0)!=0x4d41494c||io->read(io->context,4)!=1)return -1;
+ uint32_t at=io->read(io->context,0x38),size=io->read(io->context,0x34);
+ if((at&3)||at<0x3c||at>0x3bc||size<68||size>0x400-at)return -2;
+ *box=at;return 0;
+}
+static int op13_wifi_qmp_open(const struct op13_wifi_qmp_io *io,uint32_t *box)
+{
+ if(op13_wifi_qmp_box(io,box))return -1;
+ if(io->read(io->context,0x24)==0xffff&&io->read(io->context,0x28)==0xffff&&
+    io->read(io->context,0x2c)==0xffff&&io->read(io->context,0x14)==0xffff&&
+    io->read(io->context,0x30)==0xffff)return 0;
+ /* Refuse a pending message before changing any handshake state. */
+ if(io->read(io->context,*box))return -2;
+ io->write(io->context,0x10,io->read(io->context,0x0c));
+ io->write(io->context,0x24,0xffff);io->ring(io->context);
+ if(op13_wifi_qmp_wait(io,0x28,0xffff))return -3;
+ io->write(io->context,0x2c,0xffff);io->ring(io->context);
+ if(op13_wifi_qmp_wait(io,0x14,0xffff))return -4;
+ io->write(io->context,0x18,0xffff);io->ring(io->context);
+ return op13_wifi_qmp_wait(io,0x30,0xffff)?-5:0;
+}
+static int op13_wifi_qmp_send(const struct op13_wifi_qmp_io *io,uint32_t box,const char *text)
+{
+ uint32_t expected=0,words[16]={0};
+ if(op13_wifi_qmp_box(io,&expected)||box!=expected||io->read(io->context,box))return -1;
+ unsigned len=0;while(len<64&&text[len])len++;
+ if(len==64)return -2;
+ for(unsigned i=0;i<len;i++)words[i/4]|=(uint32_t)(uint8_t)text[i]<<((i%4)*8);
+ for(unsigned i=0;i<16;i++)io->write(io->context,box+4+i*4,words[i]);
+ io->write(io->context,box,64);io->ring(io->context);
+ return op13_wifi_qmp_wait(io,box,0)?-3:0;
+}
+#endif
diff --git a/xnuloader/op13_wifi_qrtr.h b/xnuloader/op13_wifi_qrtr.h
new file mode 100644
index 0000000..2de6b27
--- /dev/null
+++ b/xnuloader/op13_wifi_qrtr.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Bounded QRTR wire decoding for the RAM-only IPCR diagnostic.
+ * Protocol reference: Linux net/qrtr and UniXNU Ath12kWifi nw_qrtr.c.
+ * No socket stack, credentials, scan or association implemented here.
+ */
+#ifndef OP13_WIFI_QRTR_H
+#define OP13_WIFI_QRTR_H
+#include <stdint.h>
+#include <stddef.h>
+struct op13_qrtr_packet {
+ uint32_t type,src_node,src_port,dst_node,dst_port,confirm,size;
+ const uint8_t *payload;
+};
+static uint32_t op13_qrtr_u32(const uint8_t *p)
+{return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+static uint32_t op13_qrtr_u16(const uint8_t *p)
+{uint32_t v=(uint32_t)p[0]|(uint32_t)p[1]<<8;return v==0xffff?~0u:v;}
+static void op13_qrtr_put(uint8_t *p,uint32_t v)
+{for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(v>>(i*8));}
+static int op13_qrtr_decode(const void *data,size_t n,struct op13_qrtr_packet *p)
+{
+ const uint8_t *b=data;size_t header;
+ if(!b||!p||n<4)return -1;
+ if(op13_qrtr_u32(b)==1&&n>=32){
+  header=32;p->type=op13_qrtr_u32(b+4);p->src_node=op13_qrtr_u32(b+8);
+  p->src_port=op13_qrtr_u32(b+12);p->confirm=op13_qrtr_u32(b+16);
+  p->size=op13_qrtr_u32(b+20);p->dst_node=op13_qrtr_u32(b+24);p->dst_port=op13_qrtr_u32(b+28);
+ }else if(b[0]==3&&n>=16){
+  header=16+(size_t)b[3];p->type=b[1];p->confirm=b[2]&1;p->size=op13_qrtr_u32(b+4);
+  p->src_node=op13_qrtr_u16(b+8);p->src_port=op13_qrtr_u16(b+10);if(p->src_port==~0u)p->src_port=0xfffffffeu;
+  p->dst_node=op13_qrtr_u16(b+12);p->dst_port=op13_qrtr_u16(b+14);if(p->dst_port==~0u)p->dst_port=0xfffffffeu;
+ }else return -1;
+ if(header>n||p->size>n-header)return -1;
+ p->payload=b+header;return 0;
+}
+static void op13_qrtr_hello(uint8_t packet[52])
+{
+ for(unsigned i=0;i<52;i++)packet[i]=0;
+ op13_qrtr_put(packet,1);op13_qrtr_put(packet+4,2);op13_qrtr_put(packet+8,1);
+ op13_qrtr_put(packet+12,0xfffffffeu);op13_qrtr_put(packet+20,20);
+ op13_qrtr_put(packet+24,~0u);op13_qrtr_put(packet+28,0xfffffffeu);op13_qrtr_put(packet+32,2);
+}
+#endif
diff --git a/xnuloader/op13_wifi_radio.h b/xnuloader/op13_wifi_radio.h
new file mode 100644
index 0000000..2e5c106
--- /dev/null
+++ b/xnuloader/op13_wifi_radio.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Native Kiwi/Peach target CE and service pipe wire configuration. Independent
+ * encoding from pinned CNSS schemas and ISC CE assignment/HTC headers.
+ */
+#ifndef OP13_WIFI_RADIO_H
+#define OP13_WIFI_RADIO_H
+#include "op13_wifi_qmi_init.h"
+static size_t op13_qmi_wlan_config(uint8_t *b,size_t capacity)
+{
+ /* All nine native target pipes. Host-only CE7 has direction4/zero size;
+  * CE6/8 are firmware-owned; CE9..11 belong to MHI and are never configured. */
+ static const uint32_t pipes[9][5]={
+  {0,2,32,2048,0},{1,1,32,2048,0},{2,1,32,3520,0},{3,2,32,3520,0},
+  {4,2,256,256,8},{5,1,0,2048,0},{6,3,32,16384,0},{7,4,0,0,8},{8,3,32,16384,0},
+ };
+ /* Native non-direct-link service map: control/HTC is returned on CE2. */
+ static const uint32_t services[14][3]={
+  {0x104,2,3},{0x104,1,2},{0x102,2,3},{0x102,1,2},
+  {0x101,2,3},{0x101,1,2},{0x103,2,3},{0x103,1,2},
+  {0x100,2,3},{0x100,1,2},{1,2,0},{1,1,2},{0x300,2,4},{0x300,1,1},
+ };
+ size_t total=4+9*20+4+14*12+4;if(!b||capacity<total)return 0;
+ size_t at=0;b[at++]=0x11;b[at++]=(1+9*20)&255;b[at++]=(1+9*20)>>8;b[at++]=9;
+ for(unsigned i=0;i<9;i++)for(unsigned j=0;j<5;j++){op13_qrtr_put(b+at,pipes[i][j]);at+=4;}
+ b[at++]=0x12;b[at++]=(1+14*12)&255;b[at++]=(1+14*12)>>8;b[at++]=14;
+ for(unsigned i=0;i<14;i++)for(unsigned j=0;j<3;j++){op13_qrtr_put(b+at,services[i][j]);at+=4;}
+ /* Native PEACH uses shadow-v3; no shadow writes requested in direct-MMIO polling mode. */
+ b[at++]=0x17;b[at++]=1;b[at++]=0;b[at++]=0;
+ return at;
+}
+struct op13_htc_frame {unsigned endpoint,flags,payload_bytes,data_bytes,message,credits,credit_size,max_endpoints,service,status,assigned,max_message;};
+static int op13_htc_decode(const uint8_t *b,size_t bytes,struct op13_htc_frame *out)
+{
+ if(!b||!out||bytes<8)return -1;
+ struct op13_htc_frame p={0};p.endpoint=b[0];p.flags=b[1];p.payload_bytes=op13_qmi_u16(b+2);
+ if(p.endpoint>=32||p.payload_bytes>bytes-8)return -2;
+ p.data_bytes=p.payload_bytes;
+ if(p.flags&2){if(b[4]>p.payload_bytes)return -9;p.data_bytes-=b[4];}
+ if(p.endpoint==0&&p.data_bytes){
+  if(p.data_bytes<2)return -3;p.message=op13_qmi_u16(b+8);
+  if(p.message==1){
+   if(p.data_bytes<8)return -4;
+   p.credits=op13_qmi_u16(b+10);p.credit_size=op13_qmi_u16(b+12);p.max_endpoints=b[14];
+   if(!p.credits||!p.credit_size||p.credit_size>4096||!p.max_endpoints||p.max_endpoints>32)return -5;
+  }
+  if(p.message==3){
+   if(p.data_bytes<12)return -6;
+   p.service=op13_qmi_u16(b+10);p.status=b[12];p.assigned=b[13];p.max_message=op13_qmi_u16(b+14);
+   if(b[16]>p.data_bytes-12)return -7;
+   if(!p.status&&(!p.assigned||p.assigned>=32||p.max_message<4))return -8;
+  }
+ }
+ *out=p;return 0;
+}
+static size_t op13_htc_encode(uint8_t *b,size_t capacity,unsigned endpoint,unsigned seq,
+                              const uint8_t *payload,size_t bytes)
+{
+ if(!b||!payload||endpoint>=32||!bytes||bytes>4088||capacity<bytes+8)return 0;
+ b[0]=endpoint;b[1]=0;b[2]=bytes;b[3]=bytes>>8;b[4]=0;b[5]=seq;b[6]=b[7]=0;
+ for(size_t i=0;i<bytes;i++)b[8+i]=payload[i];return 8+bytes;
+}
+static int op13_ce_tx_desc(uint32_t b[4],uint64_t address,unsigned bytes,uint64_t first,uint64_t last)
+{
+ if(!b||!bytes||bytes>3520||address<first||address>=last||bytes>last-address||(address&3)||address>>40)return -1;
+ b[0]=(uint32_t)address;b[1]=(uint32_t)(address>>32)|(bytes<<16);b[2]=0;b[3]=0;return 0;
+}
+#endif
