+static struct hakios_volume hakios[HAKIOS_VOLUMES] = {
+	{ .name = "hakios_data" },
+	{ .name = "hakios_system" },
+};
+static char hakios_text[HAKIOS_VOLUMES][HAKIOS_MAP_BYTES];     /* the maps as they come off the USB */
+static int download_to_hakios = -1;            /* the volume whose map the next download is (-1: none) */
+static int hakios_data_requested;              /* hakios_data=1 on the command line */
+static int8_t block_part_volume[BLOCK_MAX_PARTS];   /* of a page entry with BLOCK_PART_EXTENTS: which volume */
+static efi_block_io *partition_bio(const char *name);      /* (below, in front of fb_command) */
+
+static uint64_t
+hakios_number(const char **s)
+{
+	uint64_t v = 0;
+
+	while (**s >= '0' && **s <= '9') {
+		v = v * 10 + (uint64_t)(**s - '0');
+		(*s)++;
+	}
+	return v;
+}
+
+static void
+hakios_spaces(const char **s)
+{
+	while (**s == ' ') {
+		(*s)++;
+	}
+}
+
+/* by pblk, for the overlap check (the extents come in the volume's own order) */
+static void
+hakios_sort(struct hakios_extent *e, int64_t lo, int64_t hi)
+{
+	while (lo < hi) {
+		uint64_t pivot = e[(lo + hi) / 2].pblk;
+		int64_t i = lo, j = hi;
+
+		while (i <= j) {
+			while (e[i].pblk < pivot) {
+				i++;
+			}
+			while (e[j].pblk > pivot) {
+				j--;
+			}
+			if (i <= j) {
+				struct hakios_extent t = e[i];
+
+				e[i] = e[j], e[j] = t, i++, j--;
+			}
+		}
+		/* the smaller side by recursion, the larger by the loop: so many levels only */
+		if (j - lo < hi - i) {
+			hakios_sort(e, lo, j);
+			lo = i;
+		} else {
+			hakios_sort(e, i, hi);
+			hi = j;
+		}
+	}
+}
+
+/* a few words of this loader's own in OUT, a number where there is one (NO_NUMBER: none), and the rest */
+#define NO_NUMBER         ~0ULL
+
+static void
+hakios_say(char out[64], const char *what, uint64_t number, const char *after)
+{
+	char tmp[24];
+	uint32_t n = 0;
+	int i = 0;
+
+	while (*what && n < 64 - 26) {
+		out[n++] = *what++;
+	}
+	if (number != NO_NUMBER) {
+		do {
+			tmp[i++] = (char)('0' + number % 10);
+			number /= 10;
+		} while (number);
+		while (i) {
+			out[n++] = tmp[--i];
+		}
+	}
+	while (*after && n < 63) {
+		out[n++] = *after++;
+	}
+	out[n] = 0;
+}
+
+static void
+hakios_say_verdict(struct hakios_volume *h, const char *what, uint64_t number, const char *after)
+{
+	hakios_say(h->verdict, what, number, after);
+}
+
+/* N bytes as 2N hex digits at *s, and on past them. 0 when there are that many */
+static int
+hakios_hex(const char **s, uint8_t *out, unsigned n)
+{
+	unsigned i;
+
+	for (i = 0; i < n; i++) {
+		char hc = (*s)[2 * i], lc = (*s)[2 * i + 1];
+		int hi = hc >= '0' && hc <= '9' ? hc - '0' : hc >= 'a' && hc <= 'f' ? hc - 'a' + 10 :
+		    hc >= 'A' && hc <= 'F' ? hc - 'A' + 10 : -1;
+		int lo = lc >= '0' && lc <= '9' ? lc - '0' : lc >= 'a' && lc <= 'f' ? lc - 'a' + 10 :
+		    lc >= 'A' && lc <= 'F' ? lc - 'A' + 10 : -1;
+
+		if (hi < 0 || lo < 0) {
+			return 1;
+		}
+		out[i] = (uint8_t)(hi * 16 + lo);
+	}
+	*s += 2 * n;
+	return 0;
+}
+
+/* The map's text, as the host sent it. 0 when it is a map this loader can serve. */
+static int
+hakios_map_parse(struct hakios_volume *h)
+{
+	const char *s = hakios_text[h - hakios];
+	uint64_t blocks = 0, bytes = 0;
+	uint32_t n = 0, guarded = 0;
+	uint8_t marker[16];
+	int marker_said = 0, readonly = 0, bad = 0;
+	uint32_t had = h->loaded ? h->n_ext : 0;
+	int same = 1;                               /* the extents, the marker and the size of the map that is here already */
+
+	h->loaded = 0;
+	memset(marker, 0, sizeof(marker));
+	while (*s && !bad) {
+		if (memcmp(s, "extent ", 7) == 0) {
+			uint64_t l, pb, k;
+
+			s += 7;
+			l = hakios_number(&s);
+			hakios_spaces(&s);
+			pb = hakios_number(&s);
+			hakios_spaces(&s);
+			k = hakios_number(&s);
+			if (n < had) {
+				same &= h->ext[n].lblk == l && h->ext[n].pblk == pb && h->ext[n].n == k;
+			}
+			if (k == 0 || l != blocks || pb > ~0ULL - k) {
+				print("hakios: %s: the map's extent %d (%d blocks at %d after the volume's block %d) is out of order"
+				    " or empty: refused\n", h->name, (uint64_t)n, k, pb, l);
+				bad = 1;
+			} else if (n == HAKIOS_MAX_EXT) {
+				print("hakios: %s: more extents in the map than this loader holds (%d): refused\n", h->name,
+				    (uint64_t)n);
+				bad = 1;
+			} else {
+				h->ext[n].lblk = l;
+				h->ext[n].pblk = pb;
+				h->ext[n].n = k;
+				h->ext[n].guarded = 0;
+				n++;
+				blocks = l + k;
+			}
+		} else if (memcmp(s, "marker 0x", 9) == 0) {
+			s += 9;
+			if (hakios_hex(&s, marker, 16) != 0) {
+				print("hakios: %s: the map's marker is not 32 hex digits: refused\n", h->name);
+				bad = 1;
+			}
+			marker_said = 1;
+		} else if (memcmp(s, "guard ", 6) == 0) {
+			uint64_t index;
+
+			s += 6;
+			index = hakios_number(&s);
+			hakios_spaces(&s);
+			if (index >= n) {
+				print("hakios: %s: the map's guard %d is for an extent it does not have (it has %d): refused\n",
+				    h->name, index, (uint64_t)n);
+				bad = 1;
+			} else if (memcmp(s, "0x", 2) != 0) {
+				print("hakios: %s: the map's guard %d does not begin with 0x: refused\n", h->name, index);
+				bad = 1;
+			} else {
+				s += 2;
+				if (hakios_hex(&s, h->ext[index].guard, 16) != 0) {
+					print("hakios: %s: the map's guard %d is not 32 hex digits: refused\n", h->name, index);
+					bad = 1;
+				} else {
+					h->ext[index].guarded = 1;
+				}
+			}
+		} else if (memcmp(s, "readonly", 8) == 0 && (s[8] == '\n' || s[8] == 0)) {
+			readonly = 1;
+			s += 7;
+		} else if (memcmp(s, "bytes ", 6) == 0) {
+			s += 6;
+			bytes = hakios_number(&s);
+			s--;
+		}
+		while (*s && *s != '\n') {
+			s++;
+		}
+		if (*s) {
+			s++;
+		}
+	}
+	if (!bad && n == 0) {
+		print("hakios: %s: the map holds no extent\n", h->name);
+		bad = 1;
+	}
+	if (!bad && bytes > blocks * 4096) {
+		print("hakios: %s: the map's %d bytes are more than its %d blocks hold: refused\n", h->name, bytes,
+		    blocks * 4096);
+		bad = 1;
+	}
+	if (bad) {
+		h->verified = 0;
+		hakios_say_verdict(h, "refused: its log says why", NO_NUMBER, "");
+		return 1;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		guarded += h->ext[i].guarded != 0;
+	}
+	if (n != had || memcmp(h->marker, marker, sizeof(marker)) != 0 || bytes != h->map_bytes ||
+	    readonly != h->readonly) {
+		same = 0;
+	}
+	h->n_ext = n;
+	h->blocks = blocks;
+	h->map_bytes = bytes;
+	h->bytes = bytes != 0 ? bytes : blocks * 4096;
+	h->readonly = readonly;
+	memcpy(h->marker, marker, sizeof(marker));
+	h->loaded = 1;
+	/* the map that was verified, sent again as it was, stays verified; anything else is looked at when asked of */
+	h->verified = h->verified && same;
+	hakios_say_verdict(h, h->verified ? "whole: as verified before" : "a map is here; not looked at yet", NO_NUMBER, "");
+	print("hakios: the map of %s: %d extents, %d blocks (%d MiB%s), %d bytes of image; %s; a guard for %d of %d"
+	    " extents\n", h->name, (uint64_t)n, blocks, blocks * 4096 >> 20, readonly ? ", read only" : "", bytes,
+	    marker_said ? "a marker is named" : readonly ? "no marker (read only)" : "NO marker: nothing will be served from it",
+	    (uint64_t)guarded, (uint64_t)n);
+	return 0;
+}
+
+/* The extents against the partition as UEFI lists it: every block of the volume inside it, and no two on one. */
+static int
+hakios_fits(struct hakios_volume *h, efi_block_io *bio)
+{
+	struct hakios_extent *sorted;
+	uint64_t part_blocks = bio->media->last_block + 1;
+	uint32_t i;
+
+	if (bio->media->block_size != 4096) {
+		print("hakios: %s's blocks are %d bytes, not 4096: refused\n", HAKIOS_BACKING, (uint64_t)bio->media->block_size);
+		return 0;
+	}
+	for (i = 0; i < h->n_ext; i++) {
+		if (h->ext[i].pblk + h->ext[i].n > part_blocks) {
+			print("hakios: extent %d of the map is past the end of %s: refused\n", (uint64_t)i, HAKIOS_BACKING);
+			return 0;
+		}
+	}
+	if (h->n_ext * sizeof(*sorted) > sizeof(ufs_buffer)) {
+		print("hakios: more extents in the map than this loader sorts at once (%d): refused\n", (uint64_t)h->n_ext);
+		return 0;
+	}
+	/* (ufs_buffer is the survey's: free while no kernel runs, which is when this is asked) */
+	sorted = (struct hakios_extent *)(void *)ufs_buffer;
+	memcpy(sorted, h->ext, h->n_ext * sizeof(*sorted));
+	hakios_sort(sorted, 0, (int64_t)h->n_ext - 1);
+	for (i = 1; i < h->n_ext; i++) {
+		if (sorted[i].pblk < sorted[i - 1].pblk + sorted[i - 1].n) {
+			print("hakios: two extents of the map are on one block: refused\n");
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* Does the volume's first block hold the marker the map names? Read the way the kernel will read it.
+ * 1 when it does, 0 when it holds something else, -1 when it could not be read. */
+static int
+hakios_marker_ok(struct hakios_volume *h)
+{
+	if (EFI_ERROR(h->bio->read_blocks(h->bio, h->bio->media->media_id, h->ext[0].pblk, 4096, ufs_buffer))) {
+		print("hakios: %s: its first block could not be read\n", h->name);
+		return -1;
+	}
+	if (memcmp(ufs_buffer + HAKIOS_MARKER_AT, h->marker, sizeof(h->marker)) != 0) {
+		print("hakios: %s: its first block does NOT hold the marker the map names: these are not the volume's"
+		    " blocks\n", h->name);
+		return 0;
+	}
+	return 1;
+}
+
+/* the same sum hakios-pin makes of a block (hakios-pin.c, fnv) */
+static uint64_t
+hakios_fnv64(const uint8_t *b, uint64_t n)
+{
+	uint64_t h = 0xcbf29ce484222325ULL;
+
+	while (n--) {
+		h ^= *b++;
+		h *= 0x100000001b3ULL;
+	}
+	return h;
+}
+
+/* v as 8 bytes, the greatest first: the order the map's guards are written in */
+static void
+hakios_put64(uint8_t *out, uint64_t v)
+{
+	for (unsigned i = 0; i < 8; i++) {
+		out[i] = (uint8_t)(v >> (56 - 8 * i));
+	}
+}
+
+static uint64_t
+hakios_get64(const uint8_t *in)
+{
+	uint64_t v = 0;
+
+	for (unsigned i = 0; i < 8; i++) {
+		v = (v << 8) | in[i];
+	}
+	return v;
+}
+
+/* the guard of the partition's block pblk, into out: 0 when it could not be read */
+static int
+hakios_guard_of(struct hakios_volume *h, uint64_t pblk, uint8_t *out)
+{
+	if (EFI_ERROR(h->bio->read_blocks(h->bio, h->bio->media->media_id, pblk, 4096, ufs_buffer))) {
+		return 0;
+	}
+	hakios_put64(out, hakios_fnv64(ufs_buffer, 4096));
+	return 1;
+}
+
+/*
+ * Does every extent still begin and end where it did when the host read its guard in Android? 0 when the map has
+ * no guard for each of them, or when one of them does not -- having said which: the blocks have moved since the
+ * map was made, and what the map names is somebody else's now.
+ */
+static int
+hakios_guards_hold(struct hakios_volume *h)
+{
+	uint32_t i, guarded = 0;
+
+	for (i = 0; i < h->n_ext; i++) {
+		guarded += h->ext[i].guarded != 0;
+	}
+	if (guarded != h->n_ext) {
+		print("hakios: %s: the map names a guard for %d of its %d extents: not whole, nothing is served\n", h->name,
+		    (uint64_t)guarded, (uint64_t)h->n_ext);
+		hakios_say_verdict(h, "not whole: a guard for ", (uint64_t)guarded, " extents only");
+		return 0;
+	}
+	for (i = 0; i < h->n_ext; i++) {
+		const struct hakios_extent *e = &h->ext[i];
+		uint8_t g[16];
+
+		if (!hakios_guard_of(h, e->pblk, g) || !hakios_guard_of(h, e->pblk + e->n - 1, g + 8)) {
+			print("hakios: %s: extent %d's first or last block could not be read: nothing is served\n", h->name,
+			    (uint64_t)i);
+			hakios_say_verdict(h, "unreadable: extent ", (uint64_t)i, "");
+			return 0;
+		}
+		if (memcmp(g, e->guard, 16) != 0) {
+			print("hakios: %s: extent %d (the volume's blocks from %d, at %s's %d) does not hold what it held in"
+			    " Android: its first block sums to %x there and %x in the map, its last to %x and %x. The blocks"
+			    " have moved: nothing is served\n", h->name, (uint64_t)i, e->lblk, HAKIOS_BACKING, e->pblk,
+			    hakios_get64(g), hakios_get64(e->guard), hakios_get64(g + 8), hakios_get64(e->guard + 8));
+			hakios_say_verdict(h, "moved: extent ", (uint64_t)i, " is not what the map says");
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/*
+ * Is the volume where its map says it is: the marker in its first block (unless the map says read only), and
+ * every extent at its guard. 0 when it is not, or the map is not whole -- having said which.
+ */
+static int
+hakios_whole(struct hakios_volume *h)
+{
+	unsigned i;
+	int named = 0, held;
+
+	for (i = 0; i < sizeof(h->marker); i++) {
+		named |= h->marker[i] != 0;
+	}
+	if (!named && !h->readonly) {
+		print("hakios: %s: the map names no marker: nothing is served from it\n", h->name);
+		hakios_say_verdict(h, "no marker in the map", NO_NUMBER, "");
+		return 0;
+	}
+	if (named) {
+		held = hakios_marker_ok(h);
+		if (held < 0) {
+			hakios_say_verdict(h, "its first block could not be read", NO_NUMBER, "");
+			return 0;
+		}
+		if (held == 0) {
+			hakios_say_verdict(h, "its first block does not hold the marker", NO_NUMBER, "");
+			return 0;
+		}
+	}
+	return hakios_guards_hold(h);
+}
+
+/*
+ * The volume for this run, against userdata as UEFI lists it now (block_start): 1 only when the map is whole and
+ * the volume is where it says -- *writable then says whether this run may write it: the data volume's, with
+ * hakios_data=1 -- and 0 otherwise: nothing is served from a map that is not the volume's now, not even a read.
+ */
+static int
+hakios_offer(struct hakios_volume *h, int *writable)
+{
+	efi_block_io *bio = partition_bio(HAKIOS_BACKING);
+
+	*writable = 0;
+	if (!h->loaded) {
+		hakios_say_verdict(h, "no map", NO_NUMBER, "");
+		return 0;
+	}
+	if (bio == NULL || !hakios_fits(h, bio)) {
+		print("hakios: %s: not served this run: the map does not fit %s as UEFI lists it\n", h->name, HAKIOS_BACKING);
+		hakios_say_verdict(h, "does not fit userdata as UEFI lists it", NO_NUMBER, "");
+		return 0;
+	}
+	h->bio = bio;
+	if (!h->verified && !hakios_whole(h)) {
+		return 0;
+	}
+	h->verified = 1;
+	print("hakios: %s: %d extents, %d blocks (%d MiB) on %s; whole, where the map says: %s; %s\n", h->name,
+	    (uint64_t)h->n_ext, h->blocks, h->blocks * 4096 >> 20, HAKIOS_BACKING,
+	    h->readonly ? "every extent at its guard" : "the marker in its first block, every extent at its guard",
+	    (h == hakios + HAKIOS_DATA && hakios_data_requested) ?
+	    "it takes writes this run, all of it, and everything else stays read only" : "read only this run");
+	hakios_say_verdict(h, "whole: ", (uint64_t)h->n_ext, " extents where the map says");
+	*writable = h == hakios + HAKIOS_DATA && hakios_data_requested;
+	return 1;
+}
+
+/* the extent the volume's block lba is in (the extents cover the volume without a gap) */
+static uint32_t
+hakios_extent_of(struct hakios_volume *h, uint64_t lba)
+{
+	uint32_t lo = 0, hi = h->n_ext - 1;
+
+	while (lo < hi) {
+		uint32_t mid = (lo + hi) / 2;
+
+		if (lba < h->ext[mid].lblk + h->ext[mid].n) {
+			hi = mid;
+		} else {
+			lo = mid + 1;
+		}
+	}
+	return lo;
+}
+
+/*
+ * One request to the volume, block_poll's contract: [lba, lba + count) read into block_buffer, or written from it,
+ * the same way as a write of darwin's -- WRITE_FAST written and nothing more, WRITE flushed and read back and
+ * compared, piece by piece. *bytes says what was moved.
+ */
+static efi_status
+hakios_serve(struct hakios_volume *h, uint64_t lba, uint64_t count, uint32_t op, uint64_t *bytes)
+{
+	efi_block_io *bio = h->bio;
+	uint64_t media = bio->media->media_id, done = 0;
+	uint32_t e = hakios_extent_of(h, lba);
+	efi_status s = 0;
+
+	*bytes = 0;
+	while (count != 0) {
+		/* n blocks of this extent are asked for: the partition's blocks pblk on */
+		uint64_t in = h->ext[e].lblk + h->ext[e].n - lba, n = count < in ? count : in;
+		uint64_t pblk = h->ext[e].pblk + (lba - h->ext[e].lblk), len = n * 4096;
+		uint8_t *buf = block_buffer + done;
+		uint64_t at = (uint64_t)(uintptr_t)buf;
+
+		if (op == BLOCK_OP_READ) {
+			s = bio->read_blocks(bio, media, pblk, len, buf);
+			/* what the controller wrote is in memory; drop whatever this core held of it */
+			flush_dcache(at, at + len);
+		} else if (op == BLOCK_OP_WRITE_FAST) {
+			/* the kernel filled the buffer and cleaned its lines of it: drop whatever this core holds, write */
+			flush_dcache(at, at + len);
+			s = bio->write_blocks(bio, media, pblk, len, buf);
+		} else {
+			/* write, flush, read back into the same place, compare: the answer says the blocks hold what the
+			 * kernel gave, or the write is no good (the kernel does not need the buffer back) */
+			uint32_t want;
+
+			flush_dcache(at, at + len);
+			want = ufs_crc32(buf, len);
+			s = bio->write_blocks(bio, media, pblk, len, buf);
+			if (!EFI_ERROR(s)) {
+				bio->flush_blocks(bio);
+				s = bio->read_blocks(bio, media, pblk, len, buf);
+				flush_dcache(at, at + len);
+				if (!EFI_ERROR(s) && ufs_crc32(buf, len) != want) {
+					print("hakios: %s: blocks %d..%d read back DIFFERENT\n", h->name, lba, lba + n - 1);
+					s = 0x800000000000000AULL;      /* EFI_VOLUME_CORRUPTED */
+				}
+			}
+		}
+		if (EFI_ERROR(s)) {
+			return s;
+		}
+		done += len, lba += n, count -= n, e++;
+	}
+	*bytes = done;
+	return 0;
+}
