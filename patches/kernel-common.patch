+	w[at++] = apm_graph_table[variant].sg_count;
+	for (uint32_t g = 0; g < apm_graph_table[variant].sg_count; g++) {
+		w[at++] = apm_graph_table[variant].sg[g].id;
+		w[at++] = apm_graph_table[variant].sg[g].container;
+		w[at++] = apm_graph_table[variant].sg[g].count;
+		for (uint32_t m = 0; m < apm_graph_table[variant].sg[g].count; m++) {
+			w[at++] = apm_graph_table[variant].sg[g].module[m].id;
+			w[at++] = module_base[g] + m;
+		}
+		count += apm_graph_table[variant].sg[g].count;
+	}
+	if ((at - began) & 1) {
+		w[at++] = 0;                      /* the block's padding to eight bytes */
+	}
+	w[size_at] = (at - began) * 4 - 16;
+
+	/* the modules' ports */
+	began = at;
+	w[at++] = APM_MODULE_INSTANCE_ID; w[at++] = APM_PARAM_ID_MODULE_PROP; size_at = at; w[at++] = 0; w[at++] = 0;
+	w[at++] = count;
+	for (uint32_t g = 0; g < apm_graph_table[variant].sg_count; g++) {
+		for (uint32_t m = 0; m < apm_graph_table[variant].sg[g].count; m++) {
+			w[at++] = module_base[g] + m; w[at++] = 1; w[at++] = APM_MODULE_PROP_ID_PORT_INFO; w[at++] = 8;
+			w[at++] = apm_graph_table[variant].sg[g].module[m].in_ports;
+			w[at++] = apm_graph_table[variant].sg[g].module[m].out_ports;
+		}
+	}
+	if ((at - began) & 1) {
+		w[at++] = 0;
+	}
+	w[size_at] = (at - began) * 4 - 16;
+
+	/* the connections: each sub-graph's chain, and the stream's logger feeding the device's */
+	began = at;
+	w[at++] = APM_MODULE_INSTANCE_ID; w[at++] = APM_PARAM_ID_MODULE_CONN; size_at = at; w[at++] = 0; w[at++] = 0;
+	w[at++] = 0;                             /* the count: filled once the links are written */
+	size_at = at - 1;
+	for (uint32_t g = 0; g < apm_graph_table[variant].sg_count; g++) {
+		for (uint32_t m = 0; m + 1 < apm_graph_table[variant].sg[g].count; m++) {
+			w[at++] = module_base[g] + m; w[at++] = 1; w[at++] = module_base[g] + m + 1; w[at++] = 1;
+			conns++;
+		}
+	}
+	if (apm_graph_table[variant].sg_count == 2) {
+		w[at++] = module_base[0] + apm_graph_table[0].sg[0].count - 1; w[at++] = 1; w[at++] = module_base[1]; w[at++] = 1;
+		conns++;
+	}
+	if ((at - began) & 1) {
+		w[at++] = 0;
+	}
+	w[size_at] = conns;
+	w[began + 3] = (at - began) * 4 - 16;
+
+	w[block] = (at - block - 1) * 4;
+	total = at * 4;
+	w[0] = (total << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = apm_graph_table[variant].port;
+	w[3] = APM_MODULE_INSTANCE_ID;
+	w[5] = APM_CMD_GRAPH_OPEN;
+	return total;
+}
