+/*
+ * iOS 26 VideoToolbox hardware decoder plugin for SM8750 Iris VPU v3.5 (/dev/hakios-iris).
+ * Probes IRIS_IOC_GET_INFO at load time and registers 'avc1', 'hvc1', and 'hev1' only when
+ * IRIS_INFO_HW_READY is set; otherwise leaves Apple's software decoders untouched.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
