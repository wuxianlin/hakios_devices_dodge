diff --git a/xnuloader/op13_wifi_handoff.inc b/xnuloader/op13_wifi_handoff.inc
new file mode 100644
index 0000000..319f41a
--- /dev/null
+++ b/xnuloader/op13_wifi_handoff.inc
@@ -0,0 +1,28 @@
+#include "op13_mhi_handoff.h"
+_Static_assert(sizeof(struct mhi_host)==840,"MHI host ARM64 ABI changed");
+_Static_assert(sizeof(struct op13_mhi_handoff)==936,"MHI handoff ARM64 ABI changed");
+static struct op13_mhi_handoff op13_wifi_handoff_snapshot;
+static int op13_wifi_handoff_export(void);
+static int op13_wifi_transfer_prepare(void)
+{
+ int rc=op13_wifi_handoff_export();
+ if(!rc){op13_wifi_handoff_snapshot.flags=OP13_MHI_TRANSFER;}
+ return rc;
+}
+static int op13_wifi_handoff_export(void)
+{
+ struct mhi_host *h=&op13_wifi_mhi_host;
+ if(!op13_wifi_fw_init_done||!op13_wifi_dma_mapped||!op13_wifi_cap_received||
+    op13_wifi_radio_requested||op13_wifi_wmi_endpoint||op13_wifi_mhi_stopped||
+    h->failed||!h->powered||h->ee!=MHI_HOST_EE_AMSS||h->state!=MHI_HOST_STATE_M0||op13_wifi_qrtr_ack_pending)return -1;
+ struct op13_mhi_handoff *s=&op13_wifi_handoff_snapshot;memset(s,0,sizeof(*s));
+ s->magic=OP13_MHI_HANDOFF_MAGIC;s->version=1;s->bytes=sizeof(*s);s->host_bytes=sizeof(*h);s->flags=OP13_MHI_SNAPSHOT;
+ s->source_host_pa=(uint64_t)(uintptr_t)h;s->pool_pa=op13_wifi_dma_pool;s->pool_bytes=OP13_WIFI_DMA_BYTES;s->iova=OP13_WIFI_IOVA;
+ s->bar0=0x40400000;s->bar0_bytes=0x200000;s->tables_pa=op13_wifi_dma_tables;
+ s->smmu_context=op13_wifi_dma_plan.context;s->smmu_slot=op13_wifi_dma_plan.slot;s->wlfw_node=op13_wifi_wlfw_node;s->wlfw_port=op13_wifi_wlfw_port;
+ __asm__ volatile("dsb sy":::"memory");s->host=*h;
+ struct mhi_host relocated;int rc=op13_mhi_adopt(&relocated,s,(void *)(uintptr_t)op13_wifi_dma_pool,h->ops,h->context,1);
+ print("op13-wifi-handoff: snapshot bytes=%d validated=%d transfer=0 FW_INIT_DONE=%d; no kernel launched\n",(uint64_t)sizeof(*s),(uint64_t)(!rc),(uint64_t)op13_wifi_fw_init_done);
+ if(rc)return rc;
+ staged_data=(const char*)s;staged_len=sizeof(*s);return 0;
+}
diff --git a/xnuloader/op13_wifi_htt.h b/xnuloader/op13_wifi_htt.h
new file mode 100644
index 0000000..5aab495
--- /dev/null
+++ b/xnuloader/op13_wifi_htt.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Independent wire encoding of Linux ath12k dp_htt.[ch] version exchange. */
+#ifndef OP13_WIFI_HTT_H
+#define OP13_WIFI_HTT_H
+#include "op13_wifi_qrtr.h"
+static size_t op13_htt_version_request(uint8_t *b,size_t n)
+{
+ if(!b||n<8)return 0;
+ op13_qrtr_put(b,0);op13_qrtr_put(b+4,5u|(4u<<8)|(2u<<16));return 8;
+}
+static int op13_htt_version_response(const uint8_t *b,size_t n,unsigned *major,unsigned *minor)
+{
+ if(!b||!major||!minor||(n<4||n>2040||(n&3)))return -1;
+ uint32_t v=op13_qrtr_u32(b);if((v&255)||(v>>24))return -2;
+ /* ath12k reads the fixed first word; appended option TLVs are not
+  * used by this version-only probe and are not interpreted as ring data. */
+ unsigned hi=(v>>16)&255,lo=(v>>8)&255;if(hi!=3)return -3;
+ *major=hi;*minor=lo;return 0;
+}
+#endif
diff --git a/xnuloader/op13_wifi_link_probe.inc b/xnuloader/op13_wifi_link_probe.inc
new file mode 100644
index 0000000..3b83dad
--- /dev/null
+++ b/xnuloader/op13_wifi_link_probe.inc
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Dodge PCIe0 root/link/config probe. No firmware download, DMA or MSI setup.
+ * Register definitions/order: pinned vendor-pcie/pci-msm.c; rails/pins: phone DT.
+ * Retain all client votes and controller state until a cold reset.
+ */
+static int op13_wifi_link_ready,op13_wifi_link_fault;
+static int op13_wifi_link_address(uint32_t a,int write)
+{
+ static const uint32_t parf[]={0x1000,0x350,0x354,0x358,0x35c,0x634,0x638,0x1a8,0x22c,0x2c4,0x1b0,0x2c48};
+ static const uint32_t dbi[]={0,4,8,0xc,0x18,0x7c,0x80,0xa0,0x70c,0x714,0x80c,0x8bc,0xb40};
+ if(a&3)return 0;
+ if(!write&&(a==0x1c00000||a==0x1c00040||a==0x1c00174||a==0x40000710||a==0x40000890||a==0x400008a8||a==0x400008ac||a==0x16b000||a==0x16c01c||a==0x16b054||a==0x16b080))return 1;
+
+ if(a==0x0f204008)return 1; /* DT sun-tcsrcc base, PCIe0 clkref only. */
+ for(unsigned i=0;i<sizeof(parf)/sizeof(*parf);i++)if(a==0x1c00000+parf[i])return 1;
+ for(unsigned i=0;i<sizeof(dbi)/sizeof(*dbi);i++)if(a==0x40000000+dbi[i])return 1;
+ for(unsigned i=0;i<7;i++)if(a==0x40001000+4*i)return 1;
+ const unsigned pins[]={16,18,19,102,103,104,202,203};
+ for(unsigned i=0;i<8;i++)if(a==0xf100000+0x1000*pins[i]||a==0xf100004+0x1000*pins[i])return 1;
+ /* Endpoint configuration and ELBI status are read-only in this probe. */
+ if(!write&&(a==0x40100000||a==0x40100004||a==0x40100008||a==0x40000f28))return 1;
+ return 0;
+}
+static uint32_t op13_wifi_link_read(uint32_t a)
+{
+ uint64_t par=uefi_page_translation(a);
+ if(!op13_wifi_link_address(a,0)||(par&1)||((par&0x000ffffffffff000ULL)!=(a&~0xfffULL))){
+  op13_wifi_link_fault=1;print("op13-wifi-link: refused read=%x PAR=%x\n",(uint64_t)a,par);return ~0u;
+ }
+ return *(volatile uint32_t *)(uintptr_t)a;
+}
+static void op13_wifi_link_write(uint32_t a,uint32_t v)
+{
+ uint64_t par=uefi_page_translation(a);
+ if(op13_wifi_link_fault||!op13_wifi_link_address(a,1)||(par&1)||((par&0x000ffffffffff000ULL)!=(a&~0xfffULL))){
+  op13_wifi_link_fault=1;print("op13-wifi-link: refused write=%x PAR=%x\n",(uint64_t)a,par);return;
+ }
+ *(volatile uint32_t *)(uintptr_t)a=v;__asm__ volatile("dsb sy":::"memory");
+}
+static void op13_wifi_link_update(uint32_t a,uint32_t clear,uint32_t set)
+{uint32_t v=op13_wifi_link_read(a);if(!op13_wifi_link_fault)op13_wifi_link_write(a,(v&~clear)|set);}
+
+static int op13_wifi_link_power(void)
+{
+ const efi_guid cg={0x1c34f691,0xd33d,0x4e14,{0xb8,0xf8,0x32,0xc6,0xc0,0x29,0xe9,0x5b}};
