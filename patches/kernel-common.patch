diff --git a/userland/src/bluetool.c b/userland/src/bluetool.c
new file mode 100644
index 0000000..297d535
--- /dev/null
+++ b/userland/src/bluetool.c
@@ -0,0 +1,128 @@
+/*
+ * BlueTool's replacement for this phone's WCN7850 Bluetooth controller (installed over
+ * /usr/sbin/BlueTool in the system image; launchd job com.apple.BlueTool).
+ *
+ * bluetoothd asks BlueTool over XPC to run the "boot" and "init" scripts before it opens the
+ * H4 transport: a dictionary with kMsgId = "RunBuiltinScript" (or "RunExternalScript",
+ * "RunCommand") and kMsgArgs = { script = "boot" | "init" | "deepsleep", btaddress = ... }.
+ * The stock BlueTool only knows Apple PCIe and Broadcom UART controllers; the kernel's
+ * hakios.bt_hci.c has downloaded the WCN7850 TLV rampatch and NVM over SE14 and run HCI
+ * Reset by then. (Ported from hackios-redmi-k90-annibale's userland/src/services/bluetool.c.)
+ *
+ * Waiting for kern.hakios.bt_ready before answering holds bluetoothd until the controller
+ * is up. The reply carries result = 0, manufacturer = 15 (Broadcom, whose vendor commands
+ * hakios.bt_ios.c answers locally), and a firmware description string.
+ */
+#include <dispatch/dispatch.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+
+/*
+ * XPC's C API is private: the iPhoneOS SDK ships no xpc/xpc.h. These few declarations
+ * (the symbols libSystem has exported since the beginning) are all a BlueTool needs;
+ * the types are opaque pointers, the type constants plain externs.
+ */
+typedef struct _xpc_object_s *xpc_object_t;
+typedef struct _xpc_type_s *xpc_type_t;
+typedef xpc_object_t xpc_connection_t;
+typedef void (^xpc_handler_t)(xpc_object_t object);
+
+extern xpc_type_t xpc_get_type(xpc_object_t object);
+extern const struct _xpc_type_s _xpc_type_connection;
+extern const struct _xpc_type_s _xpc_type_dictionary;
+#define XPC_TYPE_CONNECTION ((xpc_type_t)&_xpc_type_connection)
+#define XPC_TYPE_DICTIONARY ((xpc_type_t)&_xpc_type_dictionary)
+extern xpc_object_t xpc_dictionary_create_reply(xpc_object_t original);
+extern const char *xpc_dictionary_get_string(xpc_object_t dict, const char *key);
+extern xpc_object_t xpc_dictionary_get_value(xpc_object_t dict, const char *key);
+extern void xpc_dictionary_set_int64(xpc_object_t dict, const char *key, int64_t value);
+extern void xpc_dictionary_set_string(xpc_object_t dict, const char *key, const char *value);
+extern void xpc_connection_send_message(xpc_connection_t connection, xpc_object_t message);
+extern void xpc_connection_set_event_handler(xpc_connection_t connection, xpc_handler_t handler);
+extern void xpc_connection_resume(xpc_connection_t connection);
+extern void xpc_release(xpc_object_t object);
+/* xpc_connection_t xpc_dictionary_get_remote_connection(xpc_object_t message) */
+extern xpc_connection_t xpc_dictionary_get_remote_connection(xpc_object_t message);
+
+/* xpc_connection_t xpc_connection_create_mach_service(name, targetq, flags) */
+extern xpc_connection_t listen_on(const char *name, dispatch_queue_t queue, uint64_t flags)
+	__asm__("_xpc_connection_create_mach_service");
+#define XPC_CONNECTION_MACH_SERVICE_LISTENER (1ULL << 0)
+
+static int
+wait_bt_ready(int *waited_ms)
+{
+	int ready = 0;
+	int waited = 0;
+
+	for (waited = 0; waited < 40000; waited += 50) {
+		size_t len = sizeof(ready);
+
+		if (sysctlbyname("kern.hakios.bt_ready", &ready, &len, NULL, 0) == 0 && ready != 0) {
+			break;
+		}
+		usleep(50 * 1000);
+	}
+	if (waited_ms != NULL) {
+		*waited_ms = waited;
+	}
+	return ready;
+}
+
+static void
+answer(xpc_object_t message)
+{
+	const char *id = xpc_dictionary_get_string(message, "kMsgId");
+	xpc_object_t args = xpc_dictionary_get_value(message, "kMsgArgs");
+	const char *script = args != NULL && xpc_get_type(args) == XPC_TYPE_DICTIONARY ?
+	    xpc_dictionary_get_string(args, "script") : NULL;
+	xpc_object_t reply = xpc_dictionary_create_reply(message);
+	xpc_connection_t peer = xpc_dictionary_get_remote_connection(message);
+	int waited_ms = 0;
+	int ready = wait_bt_ready(&waited_ms);
+
+	fprintf(stderr, "bluetool: %s, script %s: done (bt_ready=%d, waited %d ms)\n",
+	    id != NULL ? id : "(no id)", script != NULL ? script : "(none)", ready, waited_ms);
+	if (reply == NULL || peer == NULL) {
+		return;
+	}
+	xpc_dictionary_set_int64(reply, "result", 0);
+	xpc_dictionary_set_int64(reply, "manufacturer", 15);
+	xpc_dictionary_set_string(reply, "firmware", "Qualcomm WCN7850, brought up by the kernel");
+	xpc_dictionary_set_string(reply, "output", "");
+	xpc_connection_send_message(peer, reply);
+	xpc_release(reply);
+}
+
+int
+main(void)
+{
+	xpc_connection_t listener;
+	int waited_ms = 0;
+	int ready;
+
+	setvbuf(stderr, NULL, _IOLBF, 0);
+	ready = wait_bt_ready(&waited_ms);
+	listener = listen_on("com.apple.BlueTool", NULL, XPC_CONNECTION_MACH_SERVICE_LISTENER);
+	if (listener == NULL) {
+		fprintf(stderr, "bluetool: no mach service com.apple.BlueTool\n");
+		return 1;
+	}
+	xpc_connection_set_event_handler(listener, ^(xpc_object_t peer) {
+		if (xpc_get_type(peer) != XPC_TYPE_CONNECTION) {
+			return;
+		}
+		xpc_connection_set_event_handler((xpc_connection_t)peer, ^(xpc_object_t message) {
+			if (xpc_get_type(message) == XPC_TYPE_DICTIONARY) {
+				answer(message);
+			}
+		});
+		xpc_connection_resume((xpc_connection_t)peer);
+	});
+	xpc_connection_resume(listener);
+	fprintf(stderr, "bluetool: serving com.apple.BlueTool (bt_ready=%d, waited %d ms)\n", ready, waited_ms);
+	dispatch_main();
+}
diff --git a/userland/src/brightness_agent.c b/userland/src/brightness_agent.c
new file mode 100644
index 0000000..1a4ab90
--- /dev/null
+++ b/userland/src/brightness_agent.c
@@ -0,0 +1,35 @@
+/* Poll the system UI brightness; send only changed, validated levels.
+ * BKSDisplayBrightnessGetCurrent: float(void), verified in iOS16.5.
+ */
+#include <CoreFoundation/CoreFoundation.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void)
+{
+ setbuf(stdout,0);setbuf(stderr,0);
+ void *bks=dlopen("/System/Library/PrivateFrameworks/BackBoardServices.framework/BackBoardServices",RTLD_NOW);
+ float (*current)(void)=bks?(float (*)(void))dlsym(bks,"BKSDisplayBrightnessGetCurrent"):0;
+ if(!current){fprintf(stderr,"brightness-agent: BKS getter unavailable\n");return 1;}
+ fprintf(stderr,"brightness-agent: BKS polling started\n");
+ int fd=-1;uint32_t last=~0u;
+ for(;;){
+  if(fd<0)fd=open("/dev/brightness",O_WRONLY);
+  float value=current();
+  if(fd>=0&&isfinite(value)&&value>=0.0f&&value<=1.0f){
+   uint32_t level=(uint32_t)(value*1000.0f+0.5f);
+   if(level!=last){
+    if(write(fd,&level,sizeof(level))!=sizeof(level)){
+     perror("brightness-agent: write");close(fd);return 2;
+    }
+    fprintf(stderr,"brightness-agent: brightness=%u/1000\n",level);last=level;
+   }
+  }
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode,0.001,false);
+  usleep(100000);
+ }
+}
