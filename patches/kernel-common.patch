+	rb_param_end(at);
+	at = rb_param_begin(REACH_IID_SPK_I2S, 0x08001018);
+	rb_put32(1);
+	rb_param_end(at);
+	at = rb_param_begin(REACH_IID_SPK_I2S, 0x08001017);
+	rb_put32(RATE); rb_put16(32); rb_put16(CHANNELS); rb_put32(1);
+	rb_param_end(at);
