+		uint32_t step = 0;
+
+		PE_parse_boot_argn("sound_step", &step, sizeof(step));
+		if (step == 1 || step == 2) {
+			/* the truncation ladder: everything above is known good (open ACCEPTED,
+			 * the interface config ACCEPTED) -- if the phone lives the round, the
