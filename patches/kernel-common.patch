+			printf("adsp: the out-of-band graphs: no staging page or no handle\n");
+			return;
+		}
+		for (uint32_t variant = 0; variant < 4; variant++) {
+			const uint8_t *graph = hakios_apm_speaker_graphs[variant];
+			uint32_t length = lengths[variant];
+			uint32_t total, token;
+			bool answered = false;
+
+			bzero(packet, sizeof(packet));
+			for (uint32_t i = 0; i < length / 4; i++) {
