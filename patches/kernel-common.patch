+				return hakios_adsp_oob_send(src_port, opcode, payload, length, ms, answer);
+			}
+		}
+		for (uint32_t i = 0; i < (length + 3) / 4; i++) {
+			stage[i] = ((const uint32_t *)payload)[i];
+		}
+		__asm__ volatile ("dsb sy");
+		bzero(w, sizeof(w));
+		w[0] = (40u << 8) | (6u << 4);
+		w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		w[2] = src_port;
+		w[3] = 1;
+		w[5] = opcode;
+		w[6] = (uint32_t)(desc_addr != 0 ? desc_addr : stage_pa);
+		w[7] = (uint32_t)((desc_addr != 0 ? desc_addr : stage_pa) >> 32);
+		w[8] = handle;
+		w[9] = length;
+		lck_mtx_lock(&apr_lock);
+		token = apr_next_token++;
+		w[4] = token;
+		apr_answer.there = false;
+		apr_waited_for = token;
+		if (apr_channel_send(w, 40) == 0) {
+			bool answered = false;
+
+			apr_out++;
