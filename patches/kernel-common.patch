+					reach_link_port = 1;
+					if (ok) {
+						goto opened;
+					}
+					break;
+				}
+				case 2:                                     /* no cross-subgraph link */
+					if (reach_graph_open("ladder 2: the links within", REACH_SG_PLAY, 2, play_mods, 3,
+					    inner_links, 2)) {
+						goto opened;
+					}
+					break;
+				case 3:                                     /* no links at all */
+					if (reach_graph_open("ladder 3: no links", REACH_SG_PLAY, 2, play_mods, 3, NULL, 0)) {
+						goto opened;
+					}
+					break;
+				case 4:                                     /* the endpoint alone */
+					if (reach_graph_open("ladder 4: the endpoint alone", REACH_SG_PLAY, 2, one_mod, 1, NULL, 0)) {
+						goto opened;
+					}
+					break;
+				}
+			}
