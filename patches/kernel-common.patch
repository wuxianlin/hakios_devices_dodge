diff --git a/tools/adhoc-sign.py b/tools/adhoc-sign.py
new file mode 100644
index 0000000..6817e1f
--- /dev/null
+++ b/tools/adhoc-sign.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Ad-hoc codesign for a thin arm64 Mach-O, the exact shape ldid -S writes for this
+kernel: a CodeDirectory of 16-K pages (the kernel runs 16384-byte pages), with the two
+special slots an empty Requirements set and an empty Entitlements dict fill, whose
+hashes the kernel checks (csblob_find_special_slot_blob). No CMS: ad hoc.
+
+The kernel's mini-AMFI takes any ad-hoc signature for a platform binary, which is what
+launchd demands of the daemons it starts (kern_minimac.c); there is no ldid here.
+
+Usage: adhoc-sign.py BINARY [IDENT]
+"""
+import hashlib
+import struct
+import sys
+
+PAGE = 16384
+PAGE_LOG2 = 14
+MH_MAGIC_64 = 0xFEEDFACF
+LC_SEGMENT_64 = 0x19
+LC_CODE_SIGNATURE = 0x1D
+CSMAGIC_REQUIREMENTS = 0xFADE0C01
+CSMAGIC_CODEDIRECTORY = 0xFADE0C02
+CSMAGIC_EMBEDDED_ENTITLEMENTS = 0xFADE0B01
+CSMAGIC_EMBEDDED_SIGNATURE = 0xFADE0CC0
+CSSLOT_CODEDIRECTORY = 0
+CSSLOT_REQUIREMENTS = 2
+CSSLOT_ENTITLEMENTS = 0x10000
+CS_ADHOC = 0x2
+CS_HASHTYPE_SHA256 = 2
+CS_EXECSEG_MAIN_BINARY = 1
+CD_HEADER = 88                       # version 0x20400, through execSegFlags, no padding
+
+REQUIREMENTS_EMPTY = struct.pack('>III', CSMAGIC_REQUIREMENTS, 12, 0)
+ENTITLEMENTS_EMPTY = struct.pack('>II', CSMAGIC_EMBEDDED_ENTITLEMENTS, 8)
+
+
+def main():
+    path = sys.argv[1]
+    ident = (sys.argv[2] if len(sys.argv) > 2 else path.rsplit('/', 1)[-1]).encode() + b'\0'
+    data = bytearray(open(path, 'rb').read())
+
+    if struct.unpack_from('<I', data, 0)[0] != MH_MAGIC_64:
+        sys.exit(f'{path}: not a 64-bit little-endian Mach-O')
+    ncmds, sizeofcmds = struct.unpack_from('<II', data, 16)
+    off = 32
+    text_vm = None
+    text_file = 0
+    linkedit = None
+    sig_lc = None
+    for _ in range(ncmds):
+        cmd, cmdsize = struct.unpack_from('<II', data, off)
+        if cmd == LC_SEGMENT_64:
+            name = bytes(data[off + 8:off + 24]).rstrip(b'\0')
+            vmaddr, vmsize, fileoff, filesize = struct.unpack_from('<QQQQ', data, off + 24)
+            if name == b'__TEXT':
+                text_vm, text_file = vmsize, fileoff
+            elif name == b'__LINKEDIT':
+                linkedit = (off, fileoff)
+        elif cmd == LC_CODE_SIGNATURE:
+            sig_lc = off
+        off += cmdsize
+    if text_vm is None or linkedit is None:
+        sys.exit(f'{path}: no __TEXT/__LINKEDIT')
+    commands_end = off
+
+    if sig_lc is None:
+        if commands_end + 16 > PAGE:
+            sys.exit(f'{path}: no room for LC_CODE_SIGNATURE in the header')
+        sig_lc = commands_end
+        struct.pack_into('<II', data, sig_lc, LC_CODE_SIGNATURE, 16)
+        struct.pack_into('<II', data, 16, ncmds + 1, sizeofcmds + 16)
+
+    while len(data) % 16:
+        data.append(0)
+    dataoff = len(data)
+    nslots = (dataoff + PAGE - 1) // PAGE
+
+    # the CodeDirectory: header, identifier, the two special slots' hashes, the code pages'
+    ident_at = CD_HEADER
+    special_at = CD_HEADER + len(ident)
+    hash_at = special_at + 64
+    cd = bytearray(CD_HEADER + len(ident) + 64 + 32 * nslots)
+    struct.pack_into('>9I4B4I4Q', cd, 0,
+                     CSMAGIC_CODEDIRECTORY, len(cd), 0x20400, CS_ADHOC,
+                     hash_at, ident_at,
+                     2, nslots, dataoff,
+                     32, CS_HASHTYPE_SHA256, 0, PAGE_LOG2,
+                     0, 0, 0, 0,
+                     0,
+                     text_file, text_vm, CS_EXECSEG_MAIN_BINARY)
+    cd[ident_at:ident_at + len(ident)] = ident
+    cd[special_at:special_at + 32] = hashlib.sha256(ENTITLEMENTS_EMPTY).digest()      # slot -1
+    cd[special_at + 32:special_at + 64] = hashlib.sha256(REQUIREMENTS_EMPTY).digest()  # slot -2
+
+    blob_placeholder_len = len(cd) + len(REQUIREMENTS_EMPTY) + len(ENTITLEMENTS_EMPTY)
+    cd_at = 12 + 3 * 8
+    req_at = cd_at + len(cd)
+    ent_at = req_at + len(REQUIREMENTS_EMPTY)
+    blob_size = ent_at + len(ENTITLEMENTS_EMPTY)
+    assert blob_size == 12 + 3 * 8 + blob_placeholder_len
+
+    seg_off, linkedit_fileoff = linkedit
+    linkedit_size = dataoff + blob_size - linkedit_fileoff
+    struct.pack_into('<Q', data, seg_off + 48, linkedit_size)                        # filesize
+    struct.pack_into('<Q', data, seg_off + 32, (linkedit_size + PAGE - 1) & ~(PAGE - 1))
+    struct.pack_into('<II', data, sig_lc + 8, dataoff, blob_size)
+
+    # the hashes cover everything before the blob, load commands and all, in this kernel's pages
+    for i in range(nslots):
+        page = bytes(data[i * PAGE:min((i + 1) * PAGE, dataoff)])
+        cd[hash_at + 32 * i:hash_at + 32 * (i + 1)] = hashlib.sha256(page).digest()
+
+    blob = bytes(cd) + REQUIREMENTS_EMPTY + ENTITLEMENTS_EMPTY
+    superblob = struct.pack('>III', CSMAGIC_EMBEDDED_SIGNATURE, blob_size, 3) + \
+        struct.pack('>II', CSSLOT_CODEDIRECTORY, cd_at) + \
+        struct.pack('>II', CSSLOT_REQUIREMENTS, req_at) + \
+        struct.pack('>II', CSSLOT_ENTITLEMENTS, ent_at) + blob
+    assert len(superblob) == blob_size
+
+    out = bytes(data) + superblob
+    assert len(out) == dataoff + blob_size
+    open(path, 'wb').write(out)
+    print(f'adhoc-sign: {path}: {nslots} pages of {PAGE}, blob {blob_size} bytes at {dataoff}')
+
+
+if __name__ == '__main__':
+    main()
