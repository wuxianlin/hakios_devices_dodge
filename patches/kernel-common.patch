+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+#define EIO 5
+#define ENXIO 6
+#define ENOMEM 12
+#define EBUSY 16
+#define ENODEV 19
+#define EINVAL 22
+#define EMSGSIZE 90
+#define ENOTCONN 107
+#define ETIMEDOUT 110
+void *memset(void *,int,size_t);
