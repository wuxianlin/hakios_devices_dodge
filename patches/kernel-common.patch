+/* The Wi-Fi handoff lease page: 16 KiB-aligned, written before the kernel starts.
+ * The XNU transport (bsd/dev/op13wifi) reads the 936-byte snapshot at page+256
+ * when the boot argument touch_lease_pa names this page. */
+static uint8_t op13_wifi_lease_storage[0x4000 + 16] __attribute__((aligned(16)));
+static uint64_t op13_wifi_lease_page(void)
+{
+	return ((uint64_t)(uintptr_t)op13_wifi_lease_storage + 0x3fff) & ~0x3fffULL;
