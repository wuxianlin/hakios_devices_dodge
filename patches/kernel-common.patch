+/*
+ * The block device of the GPT partition of an ASCII name ("userdata"): the walk find_log_partition() makes, for
+ * any name, for the commands that only read. NULL when no partition has the name -- or when more than one does,
+ * for choosing between two would be a guess about someone else's data.
+ */
+static efi_block_io *
+partition_bio(const char *name)
+{
+	static const efi_guid part_guid = EFI_PARTITION_INFO_GUID;
+	static const efi_guid blk_guid = EFI_BLOCK_IO_GUID;
+	efi_handle *handles;
+	uint64_t count;
+	efi_block_io *found = NULL;
+	uint32_t seen = 0;
+
+	if (EFI_ERROR(BS->locate_handle_buffer(ByProtocol, &part_guid, NULL, &count, &handles))) {
+		return NULL;
+	}
+	for (uint64_t i = 0; i < count; i++) {
+		efi_partition_info *info;
+		efi_block_io *bio;
+		unsigned k = 0;
+
+		if (EFI_ERROR(BS->handle_protocol(handles[i], &part_guid, (void **)&info)) || info->type != 2) {
+			continue;
+		}
+		for (; name[k] != 0 && (unsigned char)name[k] < 0x80 && (char16)(unsigned char)name[k] == info->name[k]; k++) {
+		}
+		if (name[k] == 0 && info->name[k] == 0 &&
+		    !EFI_ERROR(BS->handle_protocol(handles[i], &blk_guid, (void **)&bio))) {
+			found = bio;
+			seen++;
+		}
+	}
+	BS->free_pool(handles);
+	if (seen > 1) {
+		print("ufs: %d partitions are named %s: refusing to choose between them\n", (uint64_t)seen, name);
+		return NULL;
+	}
+	return found;
