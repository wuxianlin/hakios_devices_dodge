+#include "op13_wifi_rails.h"
+static void *op13_wifi_rail_client;
+static unsigned op13_wifi_rails_ready;
+static int op13_wifi_rails_vote(void)
+{
+ if(op13_wifi_rail_client)return op13_wifi_rails_ready?0:-1;
+ const efi_guid cg={0x1c34f691,0xd33d,0x4e14,{0xb8,0xf8,0x32,0xc6,0xc0,0x29,0xe9,0x5b}};
+ const efi_guid rg={0xe1d0b573,0xf29f,0x495d,{0x93,0x52,0xca,0x0d,0xd4,0x2a,0x0a,0x74}};
+ struct op13_slider_cmd_db *c=0;struct op13_slider_rpmh *p=0;
+ efi_status cs=BS->locate_protocol(&cg,0,(void **)&c),rs=BS->locate_protocol(&rg,0,(void **)&p);
+ if(EFI_ERROR(cs)||EFI_ERROR(rs)||!c||!p||c->revision!=0x10000||p->revision!=0x10001||!c->address||!p->valid||!p->count||!p->create||!p->issue)return -2;
+ uint32_t address[6]={0},voltage[6]={0},count=0;uint8_t valid=0;
+ if(EFI_ERROR(p->valid(2,&valid))||!valid||EFI_ERROR(p->count(2,&count))||count<3)return -3;
+ for(unsigned i=0;i<6;i++){
+  cs=c->address(c,op13_wifi_rails[i].name,&address[i]);
+  print("op13-wifi-rails: %s address=%x query=%x\n",op13_wifi_rails[i].name,(uint64_t)address[i],cs);
+  if(EFI_ERROR(cs))return -4;
+ }
+ if(op13_wifi_rail_plan(address,voltage))return -5;
+ rs=p->create(2,"ios-dodge-wifi-rails",&op13_wifi_rail_client);
+ if(EFI_ERROR(rs)||!op13_wifi_rail_client)return -6;
+ /* Native Linux power.c sets voltage then enables each regulator. No mode
+  * writes here. Independent client votes aggregate with existing clients. */
+ for(unsigned i=0;i<6;i++)for(unsigned step=0;step<2;step++){
+  uint32_t request=0,value=step?1:voltage[i];
+  rs=p->issue(op13_wifi_rail_client,0,0,address[i]+(step?4:0),value,&request);
+  print("op13-wifi-rails: %s %s value=%d status=%x request=%d\n",op13_wifi_rails[i].name,step?"enable":"mV",(uint64_t)value,rs,(uint64_t)request);
+  if(EFI_ERROR(rs))return -7;
+ }
+ BS->stall(10000);op13_wifi_rails_ready=1;
+ print("op13-wifi-rails: six native supply votes retained until cold reset; no storage writes\n");return 0;
+}
diff --git a/xnuloader/op13_wifi_rx_queue.h b/xnuloader/op13_wifi_rx_queue.h
new file mode 100644
index 0000000..0a252ae
--- /dev/null
+++ b/xnuloader/op13_wifi_rx_queue.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Private fixed 64-slot CE buffer FIFO, independent of hardware access.
+ * Commit a completion only after parsing its buffer; commit posting only
+ * after DMA publication succeeds. Any I/O failure ends the hardware session.
+ */
+#ifndef OP13_WIFI_RX_QUEUE_H
+#define OP13_WIFI_RX_QUEUE_H
+struct op13_rx_queue {
+ unsigned slot[64],pending[64],read_slot,write_slot,posted,head,count;
+};
+static void op13_rx_queue_init(struct op13_rx_queue *q)
+{
+ for(unsigned i=0;i<64;i++)q->slot[i]=i;
+ q->read_slot=0;q->write_slot=63;q->posted=63;q->head=0;q->count=0;
+}
+static int op13_rx_queue_buffer(const struct op13_rx_queue *q,unsigned *id)
+{
+ if(!q||!id||!q->posted||q->posted>63||q->read_slot>=64||q->slot[q->read_slot]>=64)return -1;
+ *id=q->slot[q->read_slot];return 0;
+}
+static int op13_rx_queue_complete(struct op13_rx_queue *q)
+{
+ unsigned id;if(op13_rx_queue_buffer(q,&id)||q->count>=63||q->head>=64)return -1;
+ q->pending[(q->head+q->count)&63]=id;q->count++;
+ q->posted--;q->read_slot=(q->read_slot+1)&63;return 0;
+}
+static int op13_rx_queue_refill(const struct op13_rx_queue *q,unsigned hardware_tp,unsigned *slot,unsigned *id)
+{
+ if(!q||!slot||!id||q->posted>63||q->count>63||q->write_slot>=64||q->head>=64||hardware_tp>=128||(hardware_tp&1))return -1;
+ if(!q->count||q->posted==63||(((q->write_slot+1)&63)*2)==hardware_tp)return 0;
+ *slot=q->write_slot;*id=q->pending[q->head];if(*id>=64)return -1;return 1;
+}
+static int op13_rx_queue_post(struct op13_rx_queue *q)
+{
+ if(!q||!q->count||q->count>63||q->posted>=63||q->head>=64||q->write_slot>=64)return -1;
+ unsigned id=q->pending[q->head];if(id>=64)return -1;
+ q->slot[q->write_slot]=id;q->write_slot=(q->write_slot+1)&63;q->posted++;
+ q->head=(q->head+1)&63;q->count--;return 0;
+}
+#endif
diff --git a/xnuloader/op13_wifi_smmu_globals.inc b/xnuloader/op13_wifi_smmu_globals.inc
new file mode 100644
index 0000000..65277a9
--- /dev/null
+++ b/xnuloader/op13_wifi_smmu_globals.inc
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Global SMMU configuration reads only. Actual Apps SMMU DT has no clocks or
+ * supplies: vendor arm_smmu_device_probe reads these with empty power resources.
+ * New OnePlus8 reference likewise reads globals without a ClockDxe GDS vote.
+ * No context-bank reads (occupied display contexts can be protected), no votes,
+ * no SMMU writes, and no DMA. One INFO receipt before each possibly blocking read.
+ */
+#include "op13_wifi_smmu_plan.h"
+static int op13_wifi_smmu_context_ready;
+static struct op13_wifi_smmu_plan op13_wifi_dma_plan;
+static int op13_wifi_smmu_survey(unsigned step)
+{
+ if(step!=9)return -1;
+ const efi_guid guid=EFI_CPU_ARCH_GUID;struct op13_wifi_cpu_arch *cpu=0;
+ efi_status s=BS->locate_protocol(&guid,0,(void **)&cpu);
+ if(EFI_ERROR(s)||!cpu||!cpu->set_memory_attributes)return -2;
+ for(uint64_t at=0x15000000;at<0x15002000;at+=0x1000){
+  uint64_t par=uefi_page_translation(at);
+  if(!(par&1)&&((par&0x000ffffffffff000ULL)!=at))return -2;
+ }
+ s=cpu->set_memory_attributes(cpu,0x15000000,0x2000,0x4001);
+ if(EFI_ERROR(s))return -2;
+ for(uint64_t at=0x15000000;at<0x15002000;at+=0x1000){
+  uint64_t par=uefi_page_translation(at);
+  if((par&1)||((par&0x000ffffffffff000ULL)!=at))return -2;
+ }
+ s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -3;
+ volatile const uint32_t *regs=(volatile const uint32_t *)(uintptr_t)0x15000000;
+ fb_reply("INFO","SMMU IDR0 read next; no ClockDxe power vote");
+ uint32_t idr0=regs[0x20/4];
+ fb_reply("INFO","IDR0 returned; SMMU IDR1 read next");
+ uint32_t idr1=regs[0x24/4];
+ fb_reply("INFO","IDR1 returned; SMMU SCR0 read next");
+ uint32_t scr=regs[0];
+ print("op13-wifi-smmu: IDR0=%x IDR1=%x SCR0=%x\n",(uint64_t)idr0,(uint64_t)idr1,(uint64_t)scr);
+ fb_reply("INFO","SMMU globals returned; stream map reads next");
+ uint32_t matches=idr0&255,page=(idr1>>31)?0x10000:0x1000,pages=2u<<((idr1>>28)&7),contexts=idr1&255;
+ if(idr0==~0u||idr1==~0u||!matches||!contexts||contexts>pages||2u*pages*page!=0x100000){
+  BS->set_watchdog_timer(0,0,0,0);return -4;
+ }
+ print("op13-wifi-smmu: matches=%d contexts=%d page=%x pages=%d\n",(uint64_t)matches,(uint64_t)contexts,(uint64_t)page,(uint64_t)pages);
+ uint32_t smrs[256]={0},s2crs[256]={0};
+ for(unsigned i=0;i<matches;i++){
+  uint32_t smr=regs[(0x800+4*i)/4],s2cr=regs[(0xc00+4*i)/4];
+  smrs[i]=smr;s2crs[i]=s2cr;
+  if((smr>>31)||(s2cr&(1u<<10)))print("op13-wifi-smmu: SMR%d=%x S2CR=%x\n",(uint64_t)i,(uint64_t)smr,(uint64_t)s2cr);
+ }
+ if(op13_wifi_smmu_choose(scr,idr0,idr1,smrs,s2crs,&op13_wifi_dma_plan)){
+  BS->set_watchdog_timer(0,0,0,0);return -5;
+ }
+ struct op13_wifi_smmu_plan *p=&op13_wifi_dma_plan;
+ uint64_t cb=0x15000000ULL+(p->pages+p->context)*(uint64_t)p->page;
+ print("op13-wifi-smmu: candidate slot=%d context=%d address=%x; only unused context read\n",(uint64_t)p->slot,(uint64_t)p->context,cb);
+ uint64_t par=uefi_page_translation(cb);
+ if(!(par&1)&&((par&0x000ffffffffff000ULL)!=cb)){
+  BS->set_watchdog_timer(0,0,0,0);return -6;
+ }
+ s=cpu->set_memory_attributes(cpu,cb,p->page,0x4001);
+ par=uefi_page_translation(cb);
+ if(EFI_ERROR(s)||(par&1)||((par&0x000ffffffffff000ULL)!=cb)){
+  BS->set_watchdog_timer(0,0,0,0);return -6;
+ }
+ fb_reply("INFO","Unused SMMU context SCTLR read next; watchdog armed");
+ volatile const uint32_t *context=(volatile const uint32_t *)(uintptr_t)cb;
+ uint32_t ctl=context[0];
+ print("op13-wifi-smmu: candidate SCTLR=%x\n",(uint64_t)ctl);
+ if(ctl==~0u||(ctl&1)){
+  BS->set_watchdog_timer(0,0,0,0);return -7;
+ }
+ uint32_t low=context[0x20/4],high=context[0x24/4],fsr=context[0x58/4];
+ print("op13-wifi-smmu: candidate TTBR0=%x:%x FSR=%x\n",(uint64_t)high,(uint64_t)low,(uint64_t)fsr);
+ BS->set_watchdog_timer(0,0,0,0);
+ op13_wifi_smmu_context_ready=1;
+ print("op13-wifi-smmu: free context verified; no SMMU writes or DMA\n");return 0;
+}
diff --git a/xnuloader/op13_wifi_smmu_plan.h b/xnuloader/op13_wifi_smmu_plan.h
new file mode 100644
index 0000000..ed193bc
--- /dev/null
+++ b/xnuloader/op13_wifi_smmu_plan.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Dodge PCIe SID1401 only. Pure ownership/table planning, no MMIO or bypass.
+ */
+#ifndef OP13_WIFI_SMMU_PLAN_H
+#define OP13_WIFI_SMMU_PLAN_H
+#include <stdint.h>
+/* Captured cnss_audio_iommu_group0 geometry starts at 0x18000000. */
+#define OP13_WIFI_IOVA 0x18000000ULL
+#define OP13_WIFI_DMA_BYTES 0x8000000ULL
+#define OP13_WIFI_TABLES 66u
+struct op13_wifi_smmu_plan {uint32_t page,pages,contexts,matches,slot,context;};
+static int op13_wifi_smmu_choose(uint32_t scr,uint32_t id0,uint32_t id1,
+ const uint32_t *smr,const uint32_t *s2cr,struct op13_wifi_smmu_plan *p)
+{
+ if(scr==~0u||id0==~0u||id1==~0u||(scr&9)||!(id0&(1u<<30))||!(id0&(1u<<27)))return -1;
+ p->page=(id1>>31)?0x10000:0x1000;p->pages=2u<<((id1>>28)&7);
+ p->contexts=id1&255;p->matches=id0&255;p->slot=~0u;p->context=~0u;
+ if(2u*p->page*p->pages!=0x100000||!p->contexts||p->contexts>p->pages||!p->matches||p->matches>256)return -1;
+ uint8_t used[256]={0};
+ for(unsigned i=0;i<p->matches;i++){
+  if(smr[i]>>31){
+   used[s2cr[i]&255]=1;
+   uint32_t sid=smr[i]&0x7fff,mask=(smr[i]>>16)&0x7fff;
+   if(!((sid^0x1401)&~mask&0x7fff))return -2;
+  }else if(p->slot==~0u)p->slot=i;
+ }
+ for(unsigned i=(id1>>16)&255;i<p->contexts;i++)if(!used[i]){p->context=i;break;}
+ return p->slot==~0u||p->context==~0u?-3:0;
+}
+static int op13_wifi_smmu_tables(uint64_t tables[OP13_WIFI_TABLES][512],uint64_t table_pa,uint64_t pool_pa)
+{
+ if(!table_pa||!pool_pa||(table_pa>>36)||(pool_pa>>36)||(table_pa&4095)||(pool_pa&(OP13_WIFI_DMA_BYTES-1))||
+  table_pa+OP13_WIFI_TABLES*4096ULL>(1ULL<<36)||pool_pa+OP13_WIFI_DMA_BYTES>(1ULL<<36)||
+  (table_pa<pool_pa+OP13_WIFI_DMA_BYTES&&pool_pa<table_pa+OP13_WIFI_TABLES*4096ULL))return -1;
+ for(unsigned i=0;i<OP13_WIFI_TABLES;i++)for(unsigned j=0;j<512;j++)tables[i][j]=0;
+ tables[0][(OP13_WIFI_IOVA>>30)&511]=(table_pa+4096)|3;
+ for(unsigned block=0;block<OP13_WIFI_DMA_BYTES/0x200000ULL;block++){
+  tables[1][((OP13_WIFI_IOVA>>21)&511)+block]=(table_pa+(2+block)*4096)|3;
+  for(unsigned i=0;i<512;i++){
+   /* Normal NC (MAIR index0), unprivileged RW, outer shareable, AF/nG/XN. */
+   tables[2+block][i]=(pool_pa+(block*512ULL+i)*4096)|0xe43ULL|(3ULL<<53);
+  }
+ }
+ return 0;
+}
+#endif
diff --git a/xnuloader/op13_wifi_smmu_survey.inc b/xnuloader/op13_wifi_smmu_survey.inc
new file mode 100644
index 0000000..cffe94d
--- /dev/null
+++ b/xnuloader/op13_wifi_smmu_survey.inc
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * One firmware resource vote per host command, with watchdog and INFO receipt.
+ * SMMU register survey is read-only and requires clock-on confirmation first.
+ * No audio resources, DMA, stream programming or context changes.
+ */
+static unsigned op13_wifi_smmu_next=1;
+static const char *const op13_wifi_smmu_names[]={
+ "gcc_hlos1_vote_all_smmu_mmu_gds","gcc_hlos1_vote_mmu_tcu_gds",
+ "gcc_hlos1_vote_aggre_noc_mmu_pcie_qtb_gds",
+ "gcc_hlos1_vote_all_smmu_mmu_clk","gcc_hlos1_vote_mmu_tcu_clk",
+ "gcc_hlos1_vote_aggre_noc_mmu_pcie_qtb_clk","gcc_mmu_tcu_vote_clk"
+};
+static int op13_wifi_smmu_survey(unsigned step)
+{
+ struct op13_wifi_clock_protocol *p=0;uint64_t ids[7]={0};
+ efi_status s=BS->locate_protocol(&op13_wifi_clock_guid,0,(void **)&p);
+ if(EFI_ERROR(s)||!p||p->revision!=0x1000b||!p->get_id||!p->enable||!p->is_on)return -1;
+ for(unsigned i=0;i<7;i++){
+  s=p->get_id(p,op13_wifi_smmu_names[i],&ids[i]);
+  print("op13-wifi-smmu: resolve %s status=%x id=%x\n",op13_wifi_smmu_names[i],s,ids[i]);
+  if(EFI_ERROR(s)||!ids[i])return -2;
+  for(unsigned j=0;j<i;j++)if(ids[i]==ids[j])return -2;
+ }
+ if(step==0){
+  for(unsigned i=3;i<7;i++){
+   uint8_t on=0;s=p->is_on(p,ids[i],&on);
+   print("op13-wifi-smmu: clock %s status=%x on=%d\n",op13_wifi_smmu_names[i],s,(uint64_t)on);
+  }
+  return 0;
+ }
+ if(step>=1&&step<=7){
+  if(step!=op13_wifi_smmu_next)return -3;
+  /* INFO is sent synchronously before every potentially blocking operation. */
+  fb_reply("INFO",op13_wifi_smmu_names[step-1]);
+  s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -4;
+  s=p->enable(p,ids[step-1]);
+  BS->set_watchdog_timer(0,0,0,0);
+  print("op13-wifi-smmu: enable step=%d %s status=%x; retained until reset\n",(uint64_t)step,op13_wifi_smmu_names[step-1],s);
+  if(EFI_ERROR(s))return -5;
+  op13_wifi_smmu_next++;
+  return 0;
+ }
+ if(step!=9||op13_wifi_smmu_next!=8)return -6;
+ for(unsigned i=3;i<6;i++){
+  uint8_t on=0;s=p->is_on(p,ids[i],&on);
+  print("op13-wifi-smmu: pre-read %s status=%x on=%d\n",op13_wifi_smmu_names[i],s,(uint64_t)on);
+  if(EFI_ERROR(s)||!on)return -7;
+ }
+ const efi_guid guid=EFI_CPU_ARCH_GUID;struct op13_wifi_cpu_arch *cpu=0;
+ s=BS->locate_protocol(&guid,0,(void **)&cpu);
+ if(EFI_ERROR(s)||!cpu||!cpu->set_memory_attributes)return -8;
+ for(uint64_t at=0x15000000;at<0x15100000;at+=0x1000){
+  uint64_t par=uefi_page_translation(at);
+  if(!(par&1)&&((par&0x000ffffffffff000ULL)!=at))return -8;
+ }
+ s=cpu->set_memory_attributes(cpu,0x15000000,0x100000,0x4001);
+ if(EFI_ERROR(s))return -8;
+ for(uint64_t at=0x15000000;at<0x15100000;at+=0x1000){
+  uint64_t par=uefi_page_translation(at);
+  if((par&1)||((par&0x000ffffffffff000ULL)!=at))return -8;
+ }
+ fb_reply("INFO","SMMU IDR read next; watchdog armed for 20 seconds");
+ s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -9;
+ volatile const uint32_t *regs=(volatile const uint32_t *)(uintptr_t)0x15000000;
+ uint32_t idr0=regs[0x20/4],idr1=regs[0x24/4],scr=regs[0];
+ print("op13-wifi-smmu: IDR0=%x IDR1=%x SCR0=%x\n",(uint64_t)idr0,(uint64_t)idr1,(uint64_t)scr);
+ fb_reply("INFO","SMMU IDR reads returned; checking stream ownership");
+ uint32_t matches=idr0&255,page=(idr1>>31)?0x10000:0x1000,pages=2u<<((idr1>>28)&7),contexts=idr1&255;
+ if(idr0==~0u||idr1==~0u||!matches||!contexts||contexts>pages||2u*pages*page!=0x100000){
+  BS->set_watchdog_timer(0,0,0,0);return -10;
+ }
+ print("op13-wifi-smmu: matches=%d contexts=%d page=%x pages=%d\n",(uint64_t)matches,(uint64_t)contexts,(uint64_t)page,(uint64_t)pages);
+ for(unsigned i=0;i<matches;i++){
+  uint32_t smr=regs[(0x800+4*i)/4],s2cr=regs[(0xc00+4*i)/4];
+  if(smr>>31)print("op13-wifi-smmu: SMR%d=%x S2CR=%x\n",(uint64_t)i,(uint64_t)smr,(uint64_t)s2cr);
+ }
+ for(unsigned i=0;i<contexts;i++){
+  uint32_t sctlr=regs[((pages+i)*page)/4];
+  print("op13-wifi-smmu: CB%d SCTLR=%x\n",(uint64_t)i,(uint64_t)sctlr);
+ }
+ BS->set_watchdog_timer(0,0,0,0);
+ print("op13-wifi-smmu: read-only survey complete; no SMMU writes or DMA\n");return 0;
+}
diff --git a/xnuloader/op13_wifi_wmi_command.h b/xnuloader/op13_wifi_wmi_command.h
new file mode 100644
index 0000000..8e8140d
--- /dev/null
+++ b/xnuloader/op13_wifi_wmi_command.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef OP13_WIFI_WMI_COMMAND_H
+#define OP13_WIFI_WMI_COMMAND_H
+#include "op13_wifi_radio.h"
+#include "op13_wifi_wmi_schema.h"
+static int op13_htc_credit_delta(const uint8_t *p,size_t bytes,unsigned endpoint,unsigned *out)
+{
+ if(!p||!out||endpoint>=32)return -1;
+ size_t at=0;unsigned total=0;
+ while(at<bytes){
+  if(bytes-at<4)return -2;
+  unsigned id=p[at],n=p[at+1];at+=4;if(n>bytes-at)return -3;
+  if(id==1){
+   if(n%4)return -4;
+   for(unsigned i=0;i<n;i+=4){if(p[at+i]>=32)return -5;if(p[at+i]==endpoint)total+=p[at+i+1];}
+  }
+  at+=n;
+ }
+ if(total>255)return -6;*out=total;return 0;
+}
+static int op13_wmi_validate(const uint8_t *b,size_t bytes,const uint32_t abi[6],int init_sent,int ready,unsigned *command)
+{
+ if(!b||!abi||!command||bytes<8||bytes>3512||(bytes&3)||b[3])return -1;
+ unsigned cmd=op13_qrtr_u32(b);if(cmd!=1&&cmd!=0x5001&&cmd!=0x3001&&cmd!=0x3002&&cmd!=0x3003&&cmd!=0x4003)return -2;
+ if(cmd!=1&&!ready)return -3;
+ if(cmd==1&&init_sent)return -4;
+ /* Native ath12k radio start, matched to stock Peach wmi_unified.h. Limit
+  * this experiment to the exact pdev/parameter/value pairs being tested. */
+ if(cmd==0x4003){
+  if(bytes!=20||op13_qrtr_u32(b+4)!=((82u<<16)|12)||op13_qrtr_u32(b+8)!=1)return -13;
+  unsigned id=op13_qrtr_u32(b+12),v=op13_qrtr_u32(b+16);
+  if(!((id==0x22&&v==1)||(id==0xa&&v==1)||(id==0x23&&v==0)||((id==1||id==2)&&v==3)))return -14;
+ }
+
+ size_t at=4;unsigned count=0;
+ const unsigned tags[6]={74,75,18,515,18,18};
+ const unsigned lengths[6]={28,OP13_WMI_RESOURCE_BYTES-4,0,12,0,0};
+ while(at<bytes){
+  if(bytes-at<4)return -5;
+  uint32_t h=op13_qrtr_u32(b+at);unsigned tag=h>>16,n=h&65535;
+  if(n>bytes-at-4||(n&3))return -6;
+  if(cmd==1){
+   if(count>=6||tag!=tags[count]||n!=lengths[count])return -7;
+   if(count==0){
+    for(unsigned i=0;i<6;i++)if(op13_qrtr_u32(b+at+4+4*i)!=abi[i])return -8;
+    if(op13_qrtr_u32(b+at+28))return -9; /* No host memory chunks requested. */
+   }
+   if(count==1){
+    const uint8_t *r=b+at;
+    unsigned vdevs=op13_qrtr_u32(r+OP13_RSC_NUM_VDEVS*4),peers=op13_qrtr_u32(r+OP13_RSC_NUM_PEERS*4);
+    unsigned tids=op13_qrtr_u32(r+OP13_RSC_NUM_TIDS*4),descs=op13_qrtr_u32(r+OP13_RSC_NUM_MSDU_DESC*4);
+    if(!vdevs||vdevs>16||peers<=vdevs||peers>128||tids<peers||tids>1024||!descs||descs>1024)return -10;
+   }
+   if(count==3){for(unsigned i=0;i<n;i++)if(b[at+4+i])return -11;}
+  }
+  count++;at+=4+n;
+ }
+ if(at!=bytes||!count||(cmd==1&&count!=6))return -12;
+ *command=cmd;return 0;
+}
+#endif
