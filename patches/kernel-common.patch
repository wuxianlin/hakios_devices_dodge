+			 * kernel's physical range (the panic said so); the smem window is coherent
+			 * everywhere else this driver writes it */
+			w = (uint32_t *)packet;
+			total = 40;
+			w[0] = (total << 8) | (6u << 4);
+			w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+			w[2] = hakios_apm_speaker_graph_ports[variant];
+			w[3] = 1;                                 /* the APM module instance, as the HAL */
+			w[5] = APM_CMD_GRAPH_OPEN;
+			w[6] = 0;
+			w[7] = 0;
+			w[8] = h;
+			w[9] = length;
+			printf("adsp: the graph (%s): %u bytes out of band, from port %#x\n",
+			    hakios_apm_speaker_graph_names[variant], length, hakios_apm_speaker_graph_ports[variant]);
+			lck_mtx_lock(&apr_lock);
+			token = apr_next_token++;
+			w[4] = token;
+			apr_answer.there = false;
+			apr_waited_for = token;
+			if (apr_channel_send(packet, total) == 0) {
+				apr_out++;
+				for (uint32_t t = 0; t < 4000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+					sleep_ms(20);
+				}
+				if (os_atomic_load(&apr_answer.there, acquire)) {
+					answered = true;
+					printf("adsp: THE OUT-OF-BAND GRAPH (%s) ANSWERED: opcode %#x: command %#x, the status %u (%s)\n",
+					    hakios_apm_speaker_graph_names[variant], apr_answer.opcode,
+					    apr_answer.words[0], apr_answer.words[1],
+					    apr_answer.words[1] == 0 ? "ACCEPTED" : "refused");
+				}
+				if (!answered) {
+					printf("adsp: the graph (%s): no answer in four seconds\n",
+					    hakios_apm_speaker_graph_names[variant]);
+				}
+			}
+			lck_mtx_unlock(&apr_lock);
+			sleep_ms(300);
+		}
+	}
+}
