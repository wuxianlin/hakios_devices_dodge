+/*
+ * The phone's speaker use case, composed of its own ACDB graphs and sent the way its own audio
+ * sends a graph: the payload not in the packet but in memory APM maps once, every variant of the
+ * ask written into the same page.
+ */
+static void
+apm_graph_composed_probe(void)
+{
+	/* the four graphs sent INLINE, whole: a gpr header, the APM command header with no mapping
+	 * (the payload rides the packet), and the payload itself */
+	for (uint32_t variant = 0; variant < 4; variant++) {
+		const uint8_t *graph = hakios_apm_speaker_graphs[variant];
+		uint32_t length = (uint32_t)(sizeof(uint32_t) * 6 + 16);   /* set per variant below */
+		uint8_t packet[3100];
+		uint32_t *w = (uint32_t *)packet, total, token;
+		int error;
+		bool answered = false;
+
+		total = 40 + (uint32_t)strlen("") + 0;                     /* placeholder, fixed below */
+		/* compute the payload length from the externed arrays via a helper: lengths are baked
+		 * per variant at build time by the emitter; store them here */
+		static const uint32_t lengths[4] = { 472, 640, 2416, 2824 };
+		total = 40 + lengths[variant];
+		bzero(packet, sizeof(packet));
+		w[0] = (total << 8) | (6u << 4);
+		w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		w[2] = hakios_apm_speaker_graph_ports[variant];
+		w[3] = APM_MODULE_INSTANCE_ID;
+		w[5] = APM_CMD_GRAPH_OPEN;
+		w[6] = 0;                                                 /* payload in the packet: no address */
+		w[7] = 0;
+		w[8] = 0;                                                 /* no mapping */
+		w[9] = lengths[variant];
+		memcpy(packet + 40, graph, lengths[variant]);            /* the blob's first word is the first
+		                                                         * block's module_instance_id (1 = the
+		                                                         * APM itself), NOT a version: skipping it
+		                                                         * broke every block after */
+		printf("adsp: the graph (%s): %u bytes inline, from port %#x\n",
+		    hakios_apm_speaker_graph_names[variant], total, hakios_apm_speaker_graph_ports[variant]);
+		lck_mtx_lock(&apr_lock);
+		token = apr_next_token++;
+		w[4] = token;
+		apr_answer.there = false;
+		apr_waited_for = token;
+		error = apr_channel_send(packet, total);
+		if (error != 0) {
+			printf("adsp: the graph (%s): NOT SENT (%d)\n", hakios_apm_speaker_graph_names[variant], error);
+		} else {
+			apr_out++;
+			for (uint32_t waited = 0; waited < 4000 && !answered; waited += 20) {
+				if (os_atomic_load(&apr_answer.there, acquire)) {
+					answered = true;
+					{
+						char l[180];
+						snprintf(l, sizeof(l), "adsp: THE GRAPH (%s) IS ANSWERED: the status %u -- %s\n", hakios_apm_speaker_graph_names[variant], apr_answer.words[1], apr_answer.words[1] == 0 ? "ACCEPTED" : "refused");
+						say_line(l, true);
+					}
+				}
+				sleep_ms(20);
+			}
+			if (!answered) {
+				{
+					char l[160];
+					snprintf(l, sizeof(l), "adsp: the graph (%s): no answer in four seconds\n", hakios_apm_speaker_graph_names[variant]);
+					say_line(l, true);
+				}
+			}
+		}
+		lck_mtx_unlock(&apr_lock);
+		sleep_ms(300);
+	}
+
+	/* the discriminator: a graph open with GARBAGE in the payload.  A parser that is
+	 * reached answers AR_EBADPARAM (2); the same EFAILED (1) as the real graphs would mean
+	 * the command dies before any payload is looked at */
+	{
+		uint32_t bad[10 + 32], token;
+
+		bzero(bad, sizeof(bad));
+		for (unsigned i = 0; i < 32; i++) {
+			bad[10 + i] = 0xDEADBEEF;
+		}
+		bad[0] = ((24u + 16u + 128u) << 8) | (6u << 4);
+		bad[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		bad[2] = 0x2011;                                  /* src: a graph client port */
+		bad[3] = 1;                                       /* dst: the APM */
+		bad[4] = token = apr_next_token++;
+		bad[5] = APM_CMD_GRAPH_OPEN;
+		bad[8] = 0;                                       /* in band */
+		bad[9] = 128;                                     /* payload size */
+		lck_mtx_lock(&apr_lock);
+		apr_answer.there = false;
+		apr_waited_for = token;
+		if (apr_channel_send(bad, 24 + 16 + 128) == 0) {
+			apr_out++;
+			for (uint32_t t = 0; t < 2000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+				sleep_ms(20);
+			}
+			printf("adsp: THE GARBAGE GRAPH: %s (the status %u: 2=EBADPARAM means the parser looked,"
+			    " 1=EFAILED means it died before)\n",
+			    os_atomic_load(&apr_answer.there, acquire) ? "answered" : "no answer",
+			    apr_answer.words[1]);
+		}
+		lck_mtx_unlock(&apr_lock);
+		sleep_ms(200);
+	}
+
+	/* the bisection: the same graph's blocks, one more with every ask -- whichever prefix
+	 * first answers differently pinpoints the failing block */
+	{
+		static const uint32_t lengths[4] = { 472, 640, 2416, 2824 };
+		const uint8_t *graph = hakios_apm_speaker_graphs[3];
+		uint32_t bounds[8], nb = 0, off = 0;
+
+		while (off + 16 <= lengths[3] && nb < 8) {
+			uint32_t size = ((const uint32_t *)graph)[off / 4 + 2];
+
+			off += 16 + ((size + 7) & ~7u);
+			bounds[nb++] = off;
+		}
+		printf("adsp: the bisection: %u blocks, bounds:", nb);
+		for (unsigned i = 0; i < nb; i++) {
+			printf(" %#x", bounds[i]);
+		}
+		printf("\n");
+		for (unsigned ii = 0; ii < nb; ii++) {
+			unsigned i = nb - 1 - ii;         /* DESCENDING: the full graph first, on the
+			                                    * freshest state -- every shorter prefix after */
+			uint32_t packet[900], token, total;
+			uint8_t *pk = (uint8_t *)packet;
+			bool answered = false;
+
+			if (ii > 0) {
+				apm_close_all();          /* the previous ask left its sub-graphs behind */
+				sleep_ms(1000);           /* the close runs through the sequencer: give it a
+				                             * second before the next ask races it */
+			}
+			bzero(packet, sizeof(packet));
+			total = 24 + 16 + bounds[i];
+			packet[0] = (total << 8) | (6u << 4);
+			packet[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+			packet[2] = 0x2012;                     /* the device graph's client port */
+			packet[3] = 1;
+			packet[4] = token = apr_next_token++;
+			packet[5] = APM_CMD_GRAPH_OPEN;
+			packet[8] = 0;                          /* in band */
+			packet[9] = bounds[i];
+			memcpy(pk + 40, graph, bounds[i]);
+			lck_mtx_lock(&apr_lock);
+			apr_answer.there = false;
+			apr_waited_for = token;
+			if (apr_channel_send(packet, total) == 0) {
+				apr_out++;
+				for (uint32_t t = 0; t < 2500 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+					sleep_ms(20);
+				}
+				answered = os_atomic_load(&apr_answer.there, acquire);
+			}
+			lck_mtx_unlock(&apr_lock);
+			printf("adsp: the prefix of %u blocks (%u bytes): %s the status %u\n",
+			    i + 1, bounds[i], answered ? "answered;" : "no answer;", apr_answer.words[1]);
+			sleep_ms(200);
+		}
+
+		/* the minimal container: the phone's SG block plus ONE synthetic container of the
+		 * plainest kind (SC, graph position 1, a 512-byte stack, the audio DSP, the default
+		 * heap) -- if THIS opens, container creation works and the phone's own container
+		 * properties are the refusal; if it fails too, containers cannot be created at all
+		 * in this DSP boot (heap/thread) */
+		for (unsigned variant = 0; variant < 2; variant++) {
+			uint32_t packet[128], token, total, csz;
+			uint8_t *pk = (uint8_t *)packet;
+			bool answered = false;
+
+			apm_close_all();
+			sleep_ms(1000);
+			/* variant 0: SC type with a 512-byte stack; variant 1: GC with 4096 */
+			uint32_t ctype = variant == 0 ? 0x0B001000 : 0x0B001001;
+			uint32_t cstack = variant == 0 ? 512 : 4096;
+			uint8_t cont[96];
+			uint32_t at = 0;
+
+			*(uint32_t *)(cont + at) = 1; at += 4;               /* one container */
+			*(uint32_t *)(cont + at) = 0xE0000990 + variant; at += 4;   /* a fresh container id */
+			*(uint32_t *)(cont + at) = 5; at += 4;               /* five properties */
+			/* type {version 1, type} */
+			*(uint32_t *)(cont + at) = 0x08001011; at += 4;
+			*(uint32_t *)(cont + at) = 8; at += 4;
+			*(uint32_t *)(cont + at) = 1; *(uint32_t *)(cont + at + 4) = ctype; at += 8;
+			/* graph position */
+			*(uint32_t *)(cont + at) = 0x08001012; at += 4;
+			*(uint32_t *)(cont + at) = 4; at += 4;
+			*(uint32_t *)(cont + at) = 1; at += 4;
+			/* stack */
+			*(uint32_t *)(cont + at) = 0x08001013; at += 4;
+			*(uint32_t *)(cont + at) = 4; at += 4;
+			*(uint32_t *)(cont + at) = cstack; at += 4;
+			/* domain: the audio DSP */
+			*(uint32_t *)(cont + at) = 0x08001014; at += 4;
+			*(uint32_t *)(cont + at) = 4; at += 4;
+			*(uint32_t *)(cont + at) = 2; at += 4;
+			/* heap id 1 */
+			*(uint32_t *)(cont + at) = 0x08001174; at += 4;
+			*(uint32_t *)(cont + at) = 4; at += 4;
+			*(uint32_t *)(cont + at) = 1; at += 4;
+			csz = (at + 7) & ~7u;
+
+			bzero(packet, sizeof(packet));
+			/* a fully synthetic SG block (ONE fresh sub-graph, no properties) then our
+			 * container: no id the DSP has ever seen -- EDUPLICATE cannot be the answer */
+			uint8_t sg[32];
+			uint32_t sat = 0;
+
+			*(uint32_t *)(sg + sat) = 1; sat += 4;                 /* one sub-graph */
+			*(uint32_t *)(sg + sat) = 0xB0000990 + variant; sat += 4;   /* a fresh SG id */
+			*(uint32_t *)(sg + sat) = 0; sat += 4;                 /* no properties */
+			uint32_t ssz = (sat + 7) & ~7u;
+
+			/* SG block header then CONT block header */
+			*(uint32_t *)(pk + 40) = 1;                            /* module instance 1 */
+			*(uint32_t *)(pk + 44) = 0x08001001;                   /* the SG param */
+			*(uint32_t *)(pk + 48) = ssz;
+			*(uint32_t *)(pk + 52) = 0;
+			memcpy(pk + 56, sg, ssz);
+			*(uint32_t *)(pk + 56 + ssz) = 1;
+			*(uint32_t *)(pk + 60 + ssz) = 0x08001000;             /* the CONT param */
+			*(uint32_t *)(pk + 64 + ssz) = csz;
+			*(uint32_t *)(pk + 68 + ssz) = 0;
+			memcpy(pk + 72 + ssz, cont, csz);
+			total = 24 + 16 + (16 + ssz) + (16 + csz);
+			packet[0] = (total << 8) | (6u << 4);
+			packet[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+			packet[2] = 0x2012;
+			packet[3] = 1;
+			packet[4] = token = apr_next_token++;
+			packet[5] = APM_CMD_GRAPH_OPEN;
+			packet[8] = 0;
+			packet[9] = (16 + ssz) + (16 + csz);
+			printf("adsp: the minimal container (type %#x, stack %u): asking\n", ctype, cstack);
+			lck_mtx_lock(&apr_lock);
+			apr_answer.there = false;
+			apr_waited_for = token;
+			if (apr_channel_send(packet, total) == 0) {
+				apr_out++;
+				for (uint32_t t = 0; t < 2500 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+					sleep_ms(20);
+				}
+				answered = os_atomic_load(&apr_answer.there, acquire);
+			}
+			lck_mtx_unlock(&apr_lock);
+			{
+				char l[180];
+				snprintf(l, sizeof(l), "adsp: the minimal container: %s the status %u\n", answered ? "answered;" : "no answer;", apr_answer.words[1]);
+				say_line(l, true);
+			}
+			sleep_ms(300);
+		}
+	}
+
+	/* the same graphs OUT OF BAND -- the payload in a pool page the APM maps, the packet
+	 * carrying only (0, 0, handle, size): the way the phone's own HAL sends every graph
+	 * (its opens were captured; this build's answer to inline payloads is EFAILED) */
+	{
+		static const uint32_t lengths[4] = { 472, 640, 2416, 2824 };
+		uint8_t packet[3100];
+		uint32_t *w;
+		uint64_t stage2_pa = smem_phys + 0x1fe000;
+		volatile uint32_t *stage2 = (volatile uint32_t *)ml_io_map(stage2_pa, 0x1000);
+		uint32_t h = apm_shmem_map(stage2_pa, 0x1000);
