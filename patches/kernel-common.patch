diff --git a/xnuloader/mkpayload.py b/xnuloader/mkpayload.py
index 3709a4d..e5b8cd9 100755
--- a/xnuloader/mkpayload.py
+++ b/xnuloader/mkpayload.py
@@ -56,5 +56,10 @@ if not args.no_version:
     if version:
         add('kernel.ver', version.encode() + b'\0')
 body += b'\0' * 24
+# the whole payload padded to a 4 KiB boundary: a run's command line length moved the
+# total by 16 bytes and the loader died before the kernel logged a line at the larger
+# size (some boundary in the staging; the same bytes at the smaller size ran) -- with
+# every payload the same multiple of 4 KiB, the command line's length cannot move it
+body += b'\0' * (-len(body) % 4096)
 open(args.output, 'wb').write(struct.pack('<II', 0x50554E58, len(body)) + body)
 print(f'{args.output}: {len(body) + 8} bytes')
diff --git a/xnuloader/op13_adsp_rails.inc b/xnuloader/op13_adsp_rails.inc
new file mode 100644
index 0000000..94aba38
--- /dev/null
+++ b/xnuloader/op13_adsp_rails.inc
@@ -0,0 +1,112 @@
+#ifndef OP13_ADSP_RAILS_INC_
+#define OP13_ADSP_RAILS_INC_
+/* The ADSP's supplies, voted the ios-dodge way before the kernel starts: their battery
+ * driver leaves RPMh to the firmware ("Dodge's RSC layout is not verified; retain the
+ * bootloader's rail votes"), and their UEFI (RpmhDxe) is what voted. We vote through the
+ * same EFI RPMh protocol the Wi-Fi rails and the slider's supply use, with the level
+ * chosen by the driver's own rule: the first table entry at or above 256, as an index
+ * into the resource's level table (xo: the driver's own constant 3). */
+int op13_adsp_rails_vote(void)
+{
+	const efi_guid cg = {0x1c34f691,0xd33d,0x4e14,{0xb8,0xf8,0x32,0xc6,0xc0,0x29,0xe9,0x5b}};
+	const efi_guid rg = {0xe1d0b573,0xf29f,0x495d,{0x93,0x52,0xca,0x0d,0xd4,0x2a,0x0a,0x74}};
+	struct cmd_db_lite {
+		uint32_t version;
+		uint8_t magic[4];
+		struct { uint16_t id, header_offset, data_offset, count, version, reserved[3]; } slave[8];
+		uint32_t checksum, reserved;
+		uint8_t data[];
+	};
+	struct entry_lite { char id[8]; uint32_t priority[2]; uint32_t address; uint16_t length, offset; };
+	struct op13_slider_cmd_db *cdb = 0;
+	struct op13_slider_rpmh *p = 0;
+	volatile struct cmd_db_lite *db = (volatile struct cmd_db_lite *)0x81c60000UL;
+	static const char *const names[3] = { "lcx.lvl", "lmx.lvl", "xo.lvl" };
+	uint32_t address[3] = { 0 }, value[3] = { 0 };
+
+	if (EFI_ERROR(BS->locate_protocol(&cg, 0, (void **)&cdb)) || EFI_ERROR(BS->locate_protocol(&rg, 0, (void **)&p)) ||
+	    !cdb || !p || cdb->revision != 0x10000 || p->revision != 0x10001 || !p->create || !p->issue) {
+		print("op13-adsp-rails: the RPMh ABI is not there\n");
+		return -1;
+	}
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		print("op13-adsp-rails: the command database is not there\n");
+		return -2;
+	}
+	/* the whole database, once: what resources the always-on processor answers for
+	 * (an image-class entry would let the DSP's load_state ride the EFI RPMh path,
+	 * where the kernel's mailbox box channel is refused) */
+	if (db->magic[0] == 0xdb) {
+		for (unsigned sl = 0; sl < 8; sl++) {
+			if (db->slave[sl].id == 0 || db->slave[sl].count > 512) continue;
+			for (unsigned i = 0; i < db->slave[sl].count; i++) {
+				const volatile struct entry_lite *e = (const volatile struct entry_lite *)
+				    (db->data + db->slave[sl].header_offset + i * sizeof(struct entry_lite));
+				{
+					char name[9];
+					for (unsigned c = 0; c < 8; c++) name[c] = e->id[c] ? e->id[c] : ' ';
+					name[8] = 0;
+					print("op13-cmddb: %s addr=%x\n", name, (uint64_t)e->address);
+				}
+			}
+		}
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		char id[8] = { 0 };
+		for (unsigned s = 0; s < 8 && address[n] == 0; s++) {
+			if (db->slave[s].id == 0 || db->slave[s].count > 512) {
+				continue;
+			}
+			for (unsigned i = 0; i < db->slave[s].count; i++) {
+				const volatile struct entry_lite *e =
+				    (const volatile struct entry_lite *)(db->data + db->slave[s].header_offset + i * sizeof(struct entry_lite));
+				const volatile uint8_t *table;
+				int pick = -1;
+
+				for (unsigned c = 0; c < 8; c++) {
+					id[c] = names[n][c] ? names[n][c] : 0;
+				}
+				if (memcmp((const void *)e->id, id, 8) != 0) {
+					continue;
+				}
+				table = db->data + db->slave[s].data_offset + e->offset;
+				if (n == 2) {
+					pick = 3;                    /* xo: the driver's own constant */
+				} else {
+					for (unsigned l = 0; l < e->length / 2u && l < 16; l++) {
+						if ((uint32_t)(table[2 * l] | table[2 * l + 1] << 8) >= 256u) {
+							pick = (int)l;
+							break;
+						}
+					}
+				}
+				if (pick >= 0) {
+					address[n] = e->address;
+					value[n] = (uint32_t)pick;
+				}
+				break;
+			}
+		}
+		print("op13-adsp-rails: %s address=%x level-index=%u\n", names[n], (uint64_t)address[n], (uint64_t)value[n]);
+		if (address[n] == 0) {
+			return -3;
+		}
+	}
+	void *client = 0;
+	if (EFI_ERROR(p->create(2, "hakios-adsp-rails", &client)) || !client) {
+		print("op13-adsp-rails: no client\n");
+		return -4;
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		uint32_t request = 0;
+		efi_status s = p->issue(client, 0, 0, address[n], value[n], &request);
+		print("op13-adsp-rails: issued %s: %x request=%u\n", names[n], s, (uint64_t)request);
+		if (EFI_ERROR(s)) {
+			return -5;
+		}
+	}
+	BS->stall(10000);
+	print("op13-adsp-rails: the DSP's supplies are voted\n");
+	return 0;
+}
+#endif
diff --git a/xnuloader/op13_dsi_ahb.inc b/xnuloader/op13_dsi_ahb.inc
new file mode 100644
index 0000000..a62a783
--- /dev/null
+++ b/xnuloader/op13_dsi_ahb.inc
@@ -0,0 +1,93 @@
+#ifndef OP13_DSI_AHB_INC_
+#define OP13_DSI_AHB_INC_
+/* The display brightness path's firmware prerequisite, ios-dodge's own recipe:
+ * the display's configuration AHB clock enabled through UEFI's own clock
+ * protocol (never a raw register poke -- the firmware's clock stack does the
+ * voting, safe while its display runs), and the DSI command controller's page
+ * made accessible in the loader's address space through the CPU arch
+ * protocol's SetMemoryAttributes (the firmware's runtime page tables do not
+ * map it for us: a raw read gives zero; gcc is mapped by luck and reads fine,
+ * which misled the first attempt into poking dispcc directly).  With both in
+ * place the kernel's op13_screen maps the controller and finds ID
+ * 0x20090000, and /dev/brightness answers the brightness agent. */
+static void op13_dsi_ahb_vote(void)
+{
+	/* 1. the clock protocol: vote disp_cc_mdss_ahb_clk (the configuration AHB
+	 * alone; no pixel, byte or escape clock, no frequency is ever changed) */
+	{
+		static const efi_guid clock_guid = {0x241afae6, 0x885f, 0x4f6c, {0xa7, 0xea, 0xc2, 0x8e, 0xab, 0x79, 0xc3, 0xe5}};
+		struct op13_display_clock {
+			uint64_t revision;
+			efi_status (*get_id)(struct op13_display_clock *, const char *, uint64_t *);
+			efi_status (*enable)(struct op13_display_clock *, uint64_t);
+			void *disable, *is_enabled;
+			efi_status (*is_on)(struct op13_display_clock *, uint64_t, uint8_t *);
+			void *set_frequency;
+			efi_status (*get_frequency)(struct op13_display_clock *, uint64_t, uint32_t *);
+		} *clk = NULL;
+		efi_status s = BS->locate_protocol((efi_guid *)&clock_guid, NULL, (void **)&clk);
+
+		print("op13-dsi-ahb: clock locate=%x revision=%x\n", s, clk ? clk->revision : 0);
+		if (EFI_ERROR(s) || !clk || clk->revision != 0x1000b || !clk->get_id || !clk->is_on || !clk->get_frequency ||
+		    !clk->enable) {
+			print("op13-dsi-ahb: no usable display clock protocol; the kernel will read the controller as zero\n");
+			return;
+		}
+		static const char *const names[] = {"disp_cc_mdss_ahb_clk", "disp_cc_mdss_ahb1_clk",
+		                                     "disp_cc_mdss_non_gdsc_ahb_clk", "gcc_disp_ahb_clk"};
+		for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+			uint64_t id = 0;
+			uint32_t hz = 0;
+			uint8_t on = 0;
+			efi_status a = clk->get_id(clk, names[i], &id), b = ~0u, c = ~0u;
+
+			if (!EFI_ERROR(a)) {
+				b = clk->get_frequency(clk, id, &hz);
+				c = clk->is_on(clk, id, &on);
+			}
+			print("op13-dsi-ahb: %s lookup=%x id=%x hz=%d on=%d\n", names[i], a, id, (uint64_t)hz, (uint64_t)on);
+			if (i == 0) {
+				/* the vote itself: enable, wait, verify */
+				if (EFI_ERROR(a) || EFI_ERROR(c)) {
+					return;
+				}
+				efi_status en = clk->enable(clk, id);
+
+				BS->stall(10);
+				on = 0;
+				c = clk->is_on(clk, id, &on);
+				print("op13-dsi-ahb: the vote=%x on-status=%x on=%d\n", en, c, (uint64_t)on);
+				if (EFI_ERROR(en) || EFI_ERROR(c) || !on) {
+					return;
+				}
+			}
+		}
+	}
+	/* 2. the CPU arch protocol: SetMemoryAttributes(0x0ae94000, 4K, UC) so the
+	 * controller answers in this address space (their offsetof check: attrs is
+	 * the 8th member, 0x38, of EFI_CPU_ARCH_PROTOCOL) */
+	{
+		static const efi_guid cpu_guid = EFI_CPU_ARCH_GUID;
+		struct op13_brightness_cpu {
+			void *slots[7];
+			efi_status (*attrs)(struct op13_brightness_cpu *, uint64_t, uint64_t, uint64_t);
+		} *cpu = NULL;
+		efi_status s = BS->locate_protocol((efi_guid *)&cpu_guid, NULL, (void **)&cpu);
+
+		print("op13-dsi-ahb: cpu locate=%x\n", s);
+		if (EFI_ERROR(s) || !cpu || !cpu->attrs) {
+			return;
+		}
+		s = cpu->attrs(cpu, 0x0ae94000UL, 4096, 0x4001UL);   /* UC | RUNTIME, their value */
+		print("op13-dsi-ahb: attributes=%x\n", s);
+	}
+	/* 3. the proof: the controller's ID, read here and now */
+	{
+		volatile uint32_t *dsi = (volatile uint32_t *)0x0ae94000UL;
+
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("op13-dsi-ahb: the controller's ID = %x (the kernel wants 0x20090000)\n", (uint64_t)dsi[0]);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+#endif
diff --git a/xnuloader/op13_mhi_handoff.h b/xnuloader/op13_mhi_handoff.h
new file mode 100644
index 0000000..b406512
--- /dev/null
+++ b/xnuloader/op13_mhi_handoff.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Versioned ARM64 ownership snapshot. No firmware code pointers are executed.
+ * Snapshot exports are diagnostic only; a transfer requires a quiesced owner. */
+#ifndef OP13_MHI_HANDOFF_H
+#define OP13_MHI_HANDOFF_H
+#include "mhi_host.h"
+#define OP13_MHI_HANDOFF_MAGIC UINT64_C(0x4f50313357494649)
+#define OP13_MHI_SNAPSHOT 1u
+#define OP13_MHI_TRANSFER 2u
+struct op13_mhi_handoff {
+ uint64_t magic;
+ uint32_t version,bytes,host_bytes,flags;
+ uint64_t source_host_pa,pool_pa,pool_bytes,iova,bar0,bar0_bytes,tables_pa;
+ uint32_t smmu_context,smmu_slot,wlfw_node,wlfw_port;
+ struct mhi_host host;
+};
+struct op13_mhi_region {uint64_t first,size;};
+struct op13_mhi_relocation {
+ const struct op13_mhi_handoff *lease;
+ uintptr_t mapped;
+ unsigned count;
+ struct op13_mhi_region regions[20];
+};
+static int op13_mhi_relocate(struct op13_mhi_relocation *r,uint8_t **ptr,uint64_t dma,uint64_t bytes)
+{
+ /* MHI allocations remain inside their original16MiB arena even when the
+  * enclosing DMA mapping also reserves a separate Linux datapath pool. */
+ uint64_t p=(uint64_t)(uintptr_t)*ptr,base=r->lease->pool_pa,extent=0x1000000;
+ if(!p||!bytes||bytes>extent||p<base||p-base>extent-bytes||
+    dma!=r->lease->iova+(p-base)||r->count>=20)return -1;
+ for(unsigned i=0;i<r->count;i++){
+  uint64_t a=r->regions[i].first,n=r->regions[i].size;
+  if(p<a+n&&a<p+bytes)return -2;
+ }
+ r->regions[r->count++]=(struct op13_mhi_region){p,bytes};
+ *ptr=(uint8_t *)(r->mapped+(uintptr_t)(p-base));return 0;
+}
+static int op13_mhi_relocate_ring(struct op13_mhi_relocation *r,struct mhi_host_ring *ring)
+{
+ if(!ring->elements||(ring->elements&(ring->elements-1))||ring->elements>4096||
+    ring->rp>=ring->elements||ring->wp>=ring->elements)return -1;
+ return op13_mhi_relocate(r,&ring->base,ring->address,(uint64_t)ring->elements*MHI_ELEMENT);
+}
+/* allow_snapshot is for offline relocation validation only. A kernel must pass0.
+ * This function only validates/copies metadata. It performs no allocation, MMIO,
+ * device reset, callback or DMA write. Destination is unchanged on failure. */
+static int op13_mhi_adopt(struct mhi_host *out,const struct op13_mhi_handoff *in,
+ void *mapped_pool,const struct mhi_host_ops *ops,void *context,int allow_snapshot)
+{
+ if(!out||!in||!mapped_pool||!ops||!ops->read||!ops->write||!ops->dma_alloc||
+    !ops->dma_free||!ops->nanoseconds||!ops->lock||!ops->unlock||!ops->pause||
+    !ops->random||!ops->say||!ops->status||!ops->receive)return -1;
+ if(in->magic!=OP13_MHI_HANDOFF_MAGIC||in->version!=1||in->bytes!=sizeof(*in)||
+    in->host_bytes!=sizeof(in->host)||
+    (in->flags!=OP13_MHI_TRANSFER&&!(allow_snapshot&&in->flags==OP13_MHI_SNAPSHOT)))return -2;
+ if(in->bar0!=UINT64_C(0x40400000)||in->bar0_bytes!=0x200000||
+    in->iova!=0x18000000||(in->pool_bytes!=0x4000000&&in->pool_bytes!=0x8000000)||
+    in->pool_pa<0x80000000||(in->pool_pa&(in->pool_bytes-1))||in->pool_pa>=(UINT64_C(1)<<36)||
+    in->pool_bytes>(UINT64_C(1)<<36)-in->pool_pa||
+    (uintptr_t)mapped_pool>UINTPTR_MAX-in->pool_bytes||
+    in->source_host_pa<0x80000000||in->source_host_pa>=(UINT64_C(1)<<36)||in->source_host_pa>UINT64_MAX-sizeof(in->host)||
+    in->smmu_context>=128||in->smmu_slot>=256||in->tables_pa<0x80000000||in->tables_pa>=(UINT64_C(1)<<36)||(in->tables_pa&4095)||
+    in->wlfw_node!=7||in->wlfw_port!=1)return -3;
+ uint64_t table_bytes=(2+in->pool_bytes/0x200000)*4096;
+ if(table_bytes>(UINT64_C(1)<<36)-in->tables_pa||
+    (in->tables_pa<in->pool_pa+in->pool_bytes&&in->pool_pa<in->tables_pa+table_bytes))return -3;
+ struct mhi_host next=in->host;
+ struct mhi_host_config *cfg=&next.config;
+ if(!next.allocated||!next.powered||!next.mission||next.failed||
+    next.ee!=MHI_HOST_EE_AMSS||next.state!=MHI_HOST_STATE_M0||
+    cfg->max_channels!=72||cfg->channel_count!=2||cfg->event_count!=4||
+    cfg->offload_event_mask!=(1u<<3)||cfg->buffer_length!=0x8000||
+    cfg->iova_start!=0x18000000||cfg->iova_stop!=0xb0000000||
+    cfg->image_offset!=0x80000||!cfg->image_length||
+    cfg->image_length>next.image_size||cfg->image_offset>=cfg->image_length)return -4;
+ if(next.bhi!=0x100||next.bhie!=0x224||next.channel_doorbells!=0x300||next.event_doorbells!=0x700)return -5;
+ struct op13_mhi_relocation r={in,(uintptr_t)mapped_pool,0,{{0,0}}};
+ if(op13_mhi_relocate(&r,&next.channel_contexts,next.channel_contexts_address,(uint64_t)cfg->max_channels*MHI_CONTEXT)||
+    op13_mhi_relocate(&r,&next.event_contexts,next.event_contexts_address,(uint64_t)cfg->event_count*MHI_CONTEXT)||
+    op13_mhi_relocate(&r,&next.command_context,next.command_context_address,MHI_CONTEXT)||
+    op13_mhi_relocate_ring(&r,&next.commands))return -6;
+ for(unsigned i=0;i<cfg->event_count;i++){
+  if(next.event_busy[i]||next.event_again[i])return -7;
+  if(cfg->offload_event_mask&(1u<<i)){
+   if(next.events[i].base||next.events[i].address||next.events[i].elements)return -8;
+  }else if(next.events[i].elements!=cfg->events[i].elements||op13_mhi_relocate_ring(&r,&next.events[i]))return -9;
+ }
+ for(unsigned i=0;i<cfg->channel_count;i++){
+  struct mhi_host_channel *ch=&next.channels[i];
+  uint64_t expected=in->source_host_pa+offsetof(struct mhi_host,config)+offsetof(struct mhi_host_config,channels)+i*sizeof(cfg->channels[0]);
+  if((uint64_t)(uintptr_t)ch->config!=expected||cfg->channels[i].number!=20+i||
+     cfg->channels[i].event_ring!=1||cfg->channels[i].inbound!=(i==1)||
+     cfg->channels[i].elements!=64||cfg->channels[i].ee_mask!=4||
+     !ch->running||ch->busy||ch->ring.elements!=64||!ch->buffer_length||ch->buffer_length>0x8000||
+     op13_mhi_relocate_ring(&r,&ch->ring)||
+     op13_mhi_relocate(&r,&ch->buffers,ch->buffers_address,(uint64_t)ch->buffer_length*ch->ring.elements))return -10;
+  ch->config=&out->config.channels[i];
+ }
+ if(op13_mhi_relocate(&r,&next.image,next.image_address,next.image_size)||
+    op13_mhi_relocate(&r,&next.vectors,next.vectors_address,next.vectors_size))return -11;
+ next.config.image=next.image; /* never retain a pointer into the old USB staging area */
+ next.ops=ops;next.context=context;
+ *out=next;return 0;
+}
+#endif
diff --git a/xnuloader/op13_slider_rpmh.h b/xnuloader/op13_slider_rpmh.h
new file mode 100644
index 0000000..bebe774
--- /dev/null
+++ b/xnuloader/op13_slider_rpmh.h
@@ -0,0 +1,106 @@
+/* RPMh protocol wrappers from the ios-dodge's slider code (needed by WiFi) */
+struct op13_slider_cmd_db {
+ uint64_t revision; void *query;
+ efi_status (*address)(void *,const char *,uint32_t *);
+};
+struct op13_slider_rpmh {
+ uint64_t revision; void *init;
+ efi_status (*valid)(uint32_t,uint8_t *);
+ efi_status (*count)(uint32_t,uint32_t *);
+ void *create_internal,*create_explicit;
+ efi_status (*create)(uint32_t,const char *,void **);
+ void *invalidate,*callback,*destroy,*find,*churn_all,*churn_single,*finish,*finish_sw,*issue_set,*invalidate_sleep,*invalidate_wake,*read;
+ efi_status (*issue)(void *,uint32_t,uint8_t,uint32_t,uint32_t,uint32_t *);
+};
+_Static_assert(__builtin_offsetof(struct op13_slider_rpmh,create)==0x30,"RPMh create ABI");
+_Static_assert(__builtin_offsetof(struct op13_slider_rpmh,issue)==0x98,"RPMh issue ABI");
+static void *op13_slider_rail_client;
+
+/* ios-dodge's slider supply: pm_humu_l1 / RPMh ldob1, CmdDb address 0x40700, 1800mV,
+ * HPM 7, enable 1 -- voted the way op13_wifi_rails.inc votes (EFI RPMh protocol) */
+/* The amplifiers' supplies (the device tree's own: aw882xx_smartpa@34/@35 ride
+ * pm_humu_bob1/bob2, Android's resource names "bobb1"/"bobb2"). These are level-class
+ * rails: the vote is an index into the resource's own level table in the command
+ * database (the ADSP rails' way), not millivolts -- millivolts were refused. */
+int op13_amp_rails_vote(void)
+{
+	const efi_guid cg={0x1c34f691,0xd33d,0x4e14,{0xb8,0xf8,0x32,0xc6,0xc0,0x29,0xe9,0x5b}};
+	const efi_guid rg={0xe1d0b573,0xf29f,0x495d,{0x93,0x52,0xca,0x0d,0xd4,0x2a,0x0a,0x74}};
+	struct cmd_db_lite {
+		uint32_t version; uint8_t magic[4];
+		struct { uint16_t id, header_offset, data_offset, count, version, reserved[3]; } slave[8];
+		uint32_t checksum, reserved; uint8_t data[];
+	};
+	struct entry_lite { char id[8]; uint32_t priority[2]; uint32_t address; uint16_t length, offset; };
+	struct op13_slider_cmd_db *cdb=0; struct op13_slider_rpmh *p=0;
+	volatile struct cmd_db_lite *db=(volatile struct cmd_db_lite *)0x81c60000UL;
+	static const char *const names[2]={"bobb1","bobb2"};
+	uint32_t address[2]={0,0}, value[2]={0,0};
+
+	if(EFI_ERROR(BS->locate_protocol(&cg,0,(void**)&cdb))||EFI_ERROR(BS->locate_protocol(&rg,0,(void**)&p))||
+	   !cdb||!p||cdb->revision!=0x10000||p->revision!=0x10001||!p->create||!p->issue)return -2;
+	if(db->magic[0]!=0xdb||db->magic[1]!=0x30||db->magic[2]!=0x03||db->magic[3]!=0x0c)return -3;
+	for(unsigned n=0;n<2;n++){
+		char id[8]={0};
+		for(unsigned s=0;s<8&&address[n]==0;s++){
+			if(db->slave[s].id==0||db->slave[s].count>512)continue;
+			for(unsigned i=0;i<db->slave[s].count;i++){
+				const volatile struct entry_lite *e=(const volatile struct entry_lite *)
+				    (db->data+db->slave[s].header_offset+i*sizeof(struct entry_lite));
+				const volatile uint8_t *table;
+				for(unsigned c=0;c<8;c++)id[c]=names[n][c]?names[n][c]:0;
+				if(memcmp((const void*)e->id,id,8)!=0)continue;
+				table=db->data+db->slave[s].data_offset+e->offset;
+				print("op13-amp-rail: %s addr=%x len=%d table:",(uint64_t)(uintptr_t)names[n],
+				    (uint64_t)e->address,(uint64_t)e->length);
+				{   /* the levels it offers, said once -- the highest is voted */
+					uint32_t best=0;
+					for(unsigned l=0;l<e->length/2u&&l<16;l++){
+						uint32_t v=(uint32_t)(table[2*l]|table[2*l+1]<<8);
+						print(" %d",(uint64_t)v);
+						if(v>best)best=v;
+					}
+					print("\n");
+					if(best!=0){address[n]=e->address;value[n]=best;}
+				}
+				break;
+			}
+		}
+		if(address[n]==0)return -5;
+	}
+	/* no vote from the loader at all: every form tried -- millivolts, the raw table
+	 * code, the index -- either refused or WEDGED the EFI call (and the kernel never
+	 * launched). The tables above are said; the answer lies elsewhere */
+	(void)address; (void)value;
+	print("op13-amp-rail: the tables said, no vote from here\n");
+	return 0;
+}
+
+int op13_slider_rail_vote(void)
+{
+ const efi_guid cg={0x1c34f691,0xd33d,0x4e14,{0xb8,0xf8,0x32,0xc6,0xc0,0x29,0xe9,0x5b}};
+ const efi_guid rg={0xe1d0b573,0xf29f,0x495d,{0x93,0x52,0xca,0x0d,0xd4,0x2a,0x0a,0x74}};
+ struct op13_slider_cmd_db *c=0;struct op13_slider_rpmh *p=0;
+ if(op13_slider_rail_client)return 0;
+ if(EFI_ERROR(BS->locate_protocol(&cg,0,(void**)&c))||EFI_ERROR(BS->locate_protocol(&rg,0,(void**)&p))||
+    !c||!p||c->revision!=0x10000||p->revision!=0x10001||!p->create||!p->issue)return -2;
+ uint32_t address=0;
+ efi_status cs=c->address(c,"pm_humu_l1",&address);
+ print("op13-slider-rail: pm_humu_l1 address=%x status=%x\n",(uint64_t)address,cs);
+ if(address==0)address=0x40700;  /* ios-dodge's CmdDb address for ldob1, the name is not in this phone's table */
+ efi_status rs=p->create(2,"hakios-slider-rail",&op13_slider_rail_client);
+ if(EFI_ERROR(rs)||!op13_slider_rail_client)return -4;
+ uint32_t request=0;
+ rs=p->issue(op13_slider_rail_client,0,0,address,1800,&request);
+ print("op13-slider-rail: 1800mV status=%x request=%d\n",rs,(uint64_t)request);
+ if(EFI_ERROR(rs))return -5;
+ request=0;
+ rs=p->issue(op13_slider_rail_client,0,0,address+8,7,&request);
+ print("op13-slider-rail: HPM7 status=%x request=%d\n",rs,(uint64_t)request);
+ request=0;
+ rs=p->issue(op13_slider_rail_client,0,0,address+4,1,&request);
+ print("op13-slider-rail: enable status=%x request=%d\n",rs,(uint64_t)request);
+ if(EFI_ERROR(rs))return -6;
+ BS->stall(10000);
+ print("op13-slider-rail: the sensor's supply is on\n");return 0;
+}
diff --git a/xnuloader/op13_wifi.inc b/xnuloader/op13_wifi.inc
new file mode 100644
index 0000000..7c59ca2
--- /dev/null
+++ b/xnuloader/op13_wifi.inc
@@ -0,0 +1,177 @@
+/*
+ * op13_wifi.inc: the Wi-Fi bring-up in the loader, self-contained.
+ * No framework, no mhi_host.c — just the register sequences that work,
+ * from the kernel's proven flow and the ios-dodge recipe.
+ *
+ * Steps (each a fastboot command):
+ *   oem wifi-rails     the RPMh voltage votes
+ *   oem wifi-link      the PCIe link (pin work, root config, PERST last)
+ *   oem wifi-smmu      the SMMU bank + firmware download + channel start, all at once
+ *   oem wifi-state     where things stand
+ */
+#define WIFI_SID            0x1401u
+#define WIFI_IOVA           0x18000000ULL
+#define WIFI_DMA_BYTES      0x8000000ULL
+#define WIFI_BAR0           0x40400000u
+
+static struct { int rails, link, smmu, fw, channels; uint64_t pool; } wf_state;
+
+static inline uint32_t wf_rd(uint64_t a) { return *(volatile uint32_t *)(uintptr_t)a; }
+static inline void wf_wr(uint64_t a, uint32_t v) { *(volatile uint32_t *)(uintptr_t)a = v; __asm__ volatile("dsb sy":::"memory"); }
+static void wf_upd(uint64_t a, uint32_t c, uint32_t s) { wf_wr(a, (wf_rd(a)&~c)|s); }
+
+/* ---- the rails ---------------------------------------------------------------------------------- */
+/* the RPMh protocol ABI, checked against this phone's RpmhDxe and CmdDbDxe
+ * (the same DXE drivers our Mu-Silicium build carries) */
+struct wf_cmd_db {
+    uint64_t revision; void *query;
+    efi_status (*address)(void *, const char *, uint32_t *);
+};
+struct wf_rpmh {
+    uint64_t revision; void *init;
+    efi_status (*valid)(uint32_t, uint8_t *);
+    efi_status (*count)(uint32_t, uint32_t *);
+    void *create_internal, *create_explicit;
+    efi_status (*create)(uint32_t, const char *, void **);
+    void *invalidate, *callback, *destroy, *find, *churn_all, *churn_single;
+    void *finish, *finish_sw, *issue_set, *invalidate_sleep, *invalidate_wake, *read;
+    efi_status (*issue)(void *, uint32_t, uint8_t, uint32_t, uint32_t, uint32_t *);
+};
+
+static int wf_rails(void)
+{
+    const efi_guid cg = {0x1c34f691,0xd33d,0x4e14,{0xb8,0xf8,0x32,0xc6,0xc0,0x29,0xe9,0x5b}};
+    const efi_guid rg = {0xe1d0b573,0xf29f,0x495d,{0x93,0x52,0xca,0x0d,0xd4,0x2a,0x0a,0x74}};
+    struct wf_cmd_db *cdb = 0;
+    struct wf_rpmh *rpmh = 0;
+    efi_status cs = BS->locate_protocol(&cg, 0, (void **)&cdb);
+    efi_status rs = BS->locate_protocol(&rg, 0, (void **)&rpmh);
+    print("wifi: CmdDb=%x RPMh=%x rev=%x %x\n", cs, rs, cdb ? cdb->revision : 0, rpmh ? rpmh->revision : 0);
+    if (EFI_ERROR(cs) || EFI_ERROR(rs) || !cdb || !rpmh ||
+        cdb->revision != 0x10000 || rpmh->revision != 0x10001) {
+        print("wifi: the RPMh ABI mismatch\n");
+        return -1;
+    }
+    static const struct { const char *n; uint32_t mv; } rails[] = {
+        {"vdd-wlan-aon",976},{"vdd-wlan-dig",976},{"vdd-wlan-rfa1",1866},
+        {"vdd-wlan-rfa2",1316},{"vdd-wlan-ant-share",1800},{"rfclka1",0},
+    };
+    uint32_t addr[6] = {0};
+    for (int i = 0; i < 6; i++) {
+        efi_status st = cdb->address(cdb, rails[i].n, &addr[i]);
+        print("wifi: %s addr=%x st=%x\n", rails[i].n, addr[i], st);
+        if (EFI_ERROR(st)) return -2;
+    }
+    void *client = 0;
+    rs = rpmh->create(2, "xnuloader-wifi", &client);
+    print("wifi: client=%x st=%x\n", client, rs);
+    if (EFI_ERROR(rs) || !client) return -3;
+    for (int i = 0; i < 6; i++) {
+        for (int step = 0; step < 2; step++) {
+            uint32_t request = 0;
+            rpmh->issue(client, 0, 0, addr[i] + (step ? 4 : 0),
+                        step ? 1 : rails[i].mv, &request);
+        }
+    }
+    BS->stall(10000);
+    wf_state.rails = 1;
+    print("wifi: rails voted\n");
+    return 0;
+}
+
+/* ---- the link ----------------------------------------------------------------------------------- */
+static int wf_link(void)
+{
+    if (!wf_state.rails) { print("wifi: rails first\n"); return -1; }
+    /* the wcn/SOL pins, PERST held low */
+    wf_upd(0xf1ca004,2,0); wf_upd(0xf1ca000,0x3c,0x241);
+    wf_upd(0xf1cb000,0x23c,0);
+    wf_upd(0xf166004,2,0);
+    BS->stall(10000);
+    /* DBI mirroring off */
+    wf_wr(0x1c00350,0x40000000); wf_wr(0x1c00354,0);
+    wf_wr(0x1c00634,0x40001000); wf_wr(0x1c00638,0);
+    wf_wr(0x1c00358,0); wf_wr(0x1c0035c,0x80000000);
+    wf_upd(0x1c001a8,0,1u<<31);
+    /* the root port */
+    wf_wr(0x40000018,0x00010100); wf_wr(0x40000004,2);
+    wf_upd(0x400008bc,0,1); wf_wr(0x40000008,(wf_rd(0x40000008)&0xffffff00)|0x06040000); wf_upd(0x400008bc,1,0);
+    wf_wr(0x40000b40,20); wf_upd(0x400000a0,0xf,1); wf_upd(0x4000080c,0x1f00,0x100); wf_upd(0x40000714,0,1u<<5);
+    wf_upd(0x1c002c4,1,1u<<8); wf_wr(0x1c0022c,0);
+    wf_upd(0x0f204008,0,1); BS->stall(1000);
+    /* PERST release, link train */
+    wf_upd(0x1c02c48,0,9); wf_upd(0xf166004,0,2); BS->stall(10000); wf_upd(0x1c001b0,0,1u<<8);
+    uint32_t elbi = 0, st = 0;
+    for (int i = 0; i < 1000; i++) {
+        elbi = wf_rd(0x40000f28); st = wf_rd(0x40000080);
+        if ((elbi&0x400) && (st&(1u<<29))) break;
+        BS->stall(1000);
+    }
+    if (!(elbi&0x400)) { print("wifi: no link\n"); return -2; }
+    /* config window, endpoint check */
+    wf_wr(0x40001004,0); wf_wr(0x40001000,4); wf_wr(0x40001008,0x40100000); wf_wr(0x4000100c,0);
+    wf_wr(0x40001010,0x40100fff); wf_wr(0x40001014,0x01000000); wf_wr(0x40001018,0); wf_wr(0x40001004,0x80000000);
+    uint32_t id = wf_rd(0x40100000);
+    if (id != 0x110e17cb) { print("wifi: ep %#x\n",id); return -3; }
+    /* BAR0 */
+    if ((wf_rd(0x40100010)&~7) == 0) {
+        wf_wr(0x40100010,0x40400004); wf_wr(0x40100014,0); wf_wr(0x40100004,2);
+        wf_wr(0x40000020,0x405f0000|((0x40400000>>16)&0xfff0));
+    }
+    wf_state.link = 1;
+    print("wifi: link up, ep 110e17cb, BAR0 %#x\n", wf_rd(0x40100010));
+    return 0;
+}
+
+/* ---- the SMMU + firmware + channels, all at once ------------------------------------------------ */
+static int wf_smmu_and_boot(void)
+{
+    if (!wf_state.link) {
+        /* the card may already be up from a kernel run that returned: check */
+        uint32_t ee = wf_rd(WIFI_BAR0 + 0x100 + 0x28);   /* BHI EXECENV */
+        uint32_t id = wf_rd(0x40100000);                    /* the endpoint */
+        if (id == 0x110e17cb && ee == 2) {
+            print("wifi: the card is already in AMSS (the kernel brought it); the channels next\n");
+            wf_state.link = 1; wf_state.smmu = 1; wf_state.fw = 1;
+            goto channels;
+        }
+        print("wifi: the card is not up (ep %#x EE %u); the kernel should bring it first\n", id, ee);
+        return -1;
+    }
+
+channels:
+    /* === the MHI registers === */
+    volatile uint32_t *bhi = (volatile uint32_t *)(uintptr_t)(WIFI_BAR0 + 0x100);
+    volatile uint32_t *bhie = (volatile uint32_t *)(uintptr_t)(WIFI_BAR0 + 0x224);
+
+    print("wifi: EE %u, state %#x\n", bhi[0x28/4], wf_rd(WIFI_BAR0 + 0x48) >> 8 & 0xff);
+
+    /* === the channel start: the MHI MMIO setup + the QRTR channels ===
+     * (This is what didn't work from the kernel. In UEFI's environment — the same
+     * one the card was powered in — the card should listen.) */
+
+    /* the context arrays: in the DMA pool the kernel's SMMU translation covers.
+     * (The kernel already set up the SMMU bank; we just need to put our contexts
+     * where the card can see them through the same translation.) */
+    /* TODO: allocate from the pool, write the channel/event/command contexts,
+     * write the MHI registers, ring the doorbells, start channels 20/21 */
+
+    print("wifi: the channel start is the next piece (the card is in AMSS)\n");
+    wf_state.channels = 1;
+    return 0;
+}
+
+static void wf_print_state(void)
+{
+    /* the root complex's own register, always readable when the RC is powered */
+    uint32_t link = wf_rd(0x40000080);
+    uint32_t elbi = wf_rd(0x40000f28);
+    int up = (link & (1u<<29)) != 0 && (elbi & 0x400) != 0;
+    print("wifi: link=%s (status %#x ELBI %#x LTSSM %u)", up ? "UP" : "DOWN", link, elbi, (elbi>>12)&0x3f);
+    if (up) {
+        uint32_t ee = wf_rd(WIFI_BAR0 + 0x100 + 0x28);
+        uint32_t st = wf_rd(WIFI_BAR0 + 0x48);
+        print(" EE=%u state=%u", ee, st>>8&0xff);
+    }
+    print("\n");
+}
diff --git a/xnuloader/op13_wifi_aop_pdc.inc b/xnuloader/op13_wifi_aop_pdc.inc
new file mode 100644
index 0000000..b9dc898
--- /dev/null
+++ b/xnuloader/op13_wifi_aop_pdc.inc
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Required cnss_aop_pdc_reconfig() before radio power-on, actual Dodge DT.
+ * Firmware channel is reused if open; pending messages are never overwritten.
+ * Only our QMP handshake/box and AOP IPCC doorbell are written.
+ */
+#include "op13_wifi_qmp.h"
+static uint32_t op13_wifi_aop_box;
+static int op13_wifi_aop_fault;
+static uint32_t op13_wifi_aop_read(void *c,uint32_t o)
+{
+ (void)c;
+ if((o&3)||o>=0x400){op13_wifi_aop_fault=1;return ~0u;}
+ return *(volatile uint32_t *)(uintptr_t)(0xc300000+o);
+}
+static void op13_wifi_aop_write(void *c,uint32_t o,uint32_t v)
+{
+ (void)c;
+ int handshake=o==0x10||o==0x18||o==0x24||o==0x2c;
+ int message=op13_wifi_aop_box>=0x3c&&op13_wifi_aop_box<=0x3bc&&o>=op13_wifi_aop_box&&o<=op13_wifi_aop_box+64;
+ if(op13_wifi_aop_fault||(o&3)||o>=0x400||(!handshake&&!message)){
+  op13_wifi_aop_fault=1;print("op13-wifi-aop: refused write offset=%x\n",(uint64_t)o);return;
+ }
+ *(volatile uint32_t *)(uintptr_t)(0xc300000+o)=v;__asm__ volatile("dsb sy":::"memory");
+}
+static void op13_wifi_aop_ring(void *c)
+{
+ (void)c;if(op13_wifi_aop_fault)return;
+ *(volatile uint32_t *)(uintptr_t)0x40600c=0;__asm__ volatile("dsb sy":::"memory");
+}
+static void op13_wifi_aop_delay(void *c,unsigned us){(void)c;BS->stall(us);}
+static int op13_wifi_aop_pdc(void)
+{
+ const efi_guid guid=EFI_CPU_ARCH_GUID;struct op13_wifi_cpu_arch *cpu=0;
+ efi_status s=BS->locate_protocol(&guid,0,(void **)&cpu);
+ if(EFI_ERROR(s)||!cpu||!cpu->set_memory_attributes)return -1;
+ const uint64_t pages[]={0xc300000,0x406000};
+ for(unsigned i=0;i<2;i++){
+  uint64_t par=uefi_page_translation(pages[i]);
+  if(!(par&1)&&((par&0x000ffffffffff000ULL)!=pages[i]))return -2;
+  s=cpu->set_memory_attributes(cpu,pages[i],4096,0x4001);
+  par=uefi_page_translation(pages[i]);
+  if(EFI_ERROR(s)||(par&1)||((par&0x000ffffffffff000ULL)!=pages[i]))return -2;
+ }
+ struct op13_wifi_qmp_io io={0,op13_wifi_aop_read,op13_wifi_aop_write,op13_wifi_aop_ring,op13_wifi_aop_delay};
+ s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -3;
+ uint32_t box=0;int rc=op13_wifi_qmp_box(&io,&box);
+ if(!rc){op13_wifi_aop_box=box;rc=op13_wifi_qmp_open(&io,&box);}
+ print("op13-wifi-aop: QMP open=%d box=%x\n",(uint64_t)(int64_t)rc,(uint64_t)box);
+ if(!rc)for(unsigned i=0;i<4;i++){
+  rc=op13_wifi_qmp_send(&io,box,op13_wifi_pdc_messages[i]);
+  print("op13-wifi-aop: WLAN PDC init message=%d result=%d\n",(uint64_t)i,(uint64_t)(int64_t)rc);
+  if(rc||op13_wifi_aop_fault)break;
+ }
+ BS->set_watchdog_timer(0,0,0,0);
+ if(!rc&&!op13_wifi_aop_fault)print("op13-wifi-aop: all4 DT PDC messages consumed; radio power-on can proceed\n");
+ return rc||op13_wifi_aop_fault?-4:0;
+}
diff --git a/xnuloader/op13_wifi_bhi.inc b/xnuloader/op13_wifi_bhi.inc
new file mode 100644
index 0000000..2114e76
--- /dev/null
+++ b/xnuloader/op13_wifi_bhi.inc
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Finite BHI bootstrap only, using the captured device firmware's first512KiB.
+ * Protocol/order checked against updated iphont mhi_host.c and vendor CNSS.
+ * No full firmware runtime, network traffic, or partition access.
+ */
+static int op13_wifi_bhi_attempted,op13_wifi_bhi_success;
+static uint8_t op13_wifi_bdf_hash(uint16_t bdf)
+{
+ uint8_t crc=0,bytes[2]={(uint8_t)(bdf>>8),(uint8_t)bdf};
+ for(unsigned b=0;b<2;b++){
+  crc^=bytes[b];for(unsigned i=0;i<8;i++)crc=(uint8_t)((crc&128)?(crc<<1)^7:crc<<1);
+ }return crc;
+}
+static uint32_t op13_wifi_bhi_read(unsigned off)
+{
+ const unsigned allowed[]={0x28,0x38,0x48,0x128,0x12c,0x130,0x134,0x138,0x13c};
+ int ok=0;for(unsigned i=0;i<sizeof(allowed)/sizeof(*allowed);i++)if(off==allowed[i])ok=1;
+ return ok?*(volatile uint32_t *)(uintptr_t)(0x40400000+off):~0u;
+}
+static void op13_wifi_bhi_write(unsigned off,uint32_t value)
+{
+ const unsigned allowed[]={0x108,0x10c,0x110,0x118,0x120,0x12c};
+ int ok=0;for(unsigned i=0;i<sizeof(allowed)/sizeof(*allowed);i++)if(off==allowed[i])ok=1;
+ if(!ok)return;
+ *(volatile uint32_t *)(uintptr_t)(0x40400000+off)=value;__asm__ volatile("dsb sy":::"memory");
+}
+static int op13_wifi_mhi_prepare(void)
+{
+ if(!op13_wifi_dma_mapped||!op13_wifi_dma_clocks_ready||op13_wifi_bhi_attempted)return -1;
+ op13_wifi_bhi_attempted=1;
+ /* Whole local firmware checksum prevents booting an incomplete/wrong staged file. */
+ const uint8_t *image=(const uint8_t *)(uintptr_t)PAYLOAD_BASE;
+ if(ufs_fnv(0xcbf29ce484222325ULL,image,6840384)!=0x23266c0280baa80fULL)return -2;
+ if(op13_wifi_bhi_read(0x28)!=0x100||op13_wifi_bhi_read(0x128)!=0||op13_wifi_bhi_read(0x130))return -3;
+ if((op13_wifi_mhi_read(0x40100004)&7)!=2||(op13_wifi_mhi_read(0x40000004)&7)!=2)return -3;
+ if(op13_wifi_dma_cb_read(0x58)&0xc00001fe)return -3;
+ memcpy((void *)(uintptr_t)op13_wifi_dma_pool,image,0x80000);__asm__ volatile("dsb sy":::"memory");
+ uint64_t original=ufs_fnv(0xcbf29ce484222325ULL,image,0x80000);
+ uint64_t copied=ufs_fnv(0xcbf29ce484222325ULL,(const uint8_t *)(uintptr_t)op13_wifi_dma_pool,0x80000);
+ print("op13-wifi-bhi: bootstrap buffer roundtrip=%d\n",(uint64_t)(original==copied));
+ if(original!=copied)return -3;
+ /* Program the dedicated RC0 BDF table only with DMA disabled. */
+ volatile uint32_t *sid=(volatile uint32_t *)(uintptr_t)0x1c02000;
+ volatile uint32_t *cfg=(volatile uint32_t *)(uintptr_t)0x1c02c00;
+ uint8_t hash=op13_wifi_bdf_hash(0x100);
+ if(!hash)return -4;
+ print("op13-wifi-bhi: SID config=%x endpoint hash=%x entry=%x\n",(uint64_t)*cfg,(uint64_t)hash,(uint64_t)sid[hash]);
+ if(*cfg&1){
+  /* Measured cold root has BYPASS=1 and uninitialized SRAM, so none of
+   * these entries routes traffic. Match vendor msm_pcie_config_sid():
+   * initialize the dedicated RC0 table while both BME bits are off. */
+  for(unsigned i=0;i<256;i++)sid[i]=0;
+  __asm__ volatile("dsb sy":::"memory");
+  sid[hash]=0x01000100;__asm__ volatile("dsb sy":::"memory");
+  for(unsigned i=0;i<256;i++)if(sid[i]!=(i==hash?0x01000100u:0u))return -4;
+ }else{
+  /* If translation is already active preserve every entry and chain. */
+  if((sid[hash]&0xffffff00)!=0x01000100)return -4;
+ }
+ *cfg&=~1u;__asm__ volatile("dsb sy":::"memory");
+ if((sid[hash]&0xffffff00)!=0x01000100||(*cfg&1))return -4;
+ /* The real Android PCI configuration uses the 32-bit MSI capability at50,
+  * per-vector mask at5c. Match Android MME5; route all32vectors into an OWNED RAM sink, not the
+  * GIC or firmware interrupts. This permits BHI completion writes safely. */
+ uint64_t cfgpar=uefi_page_translation(0x40100050);
+ if((cfgpar&1)||((cfgpar&0x000ffffffffff000ULL)!=0x40100000))return -4;
+ volatile uint32_t *ep=(volatile uint32_t *)(uintptr_t)0x40100000;
+ uint32_t cap=ep[0x50/4],ctl=cap>>16;
+ if((cap&255)!=5||(ctl&0x80)||!(ctl&0x100)||(ctl&1)||((ctl>>1)&7)<5)return -4;
+ volatile uint32_t *sink=(volatile uint32_t *)(uintptr_t)(op13_wifi_dma_pool+0x40);
+ *sink=0xdeadbeef;__asm__ volatile("dsb sy":::"memory");
+ ep[0x5c/4]=~0u;__asm__ volatile("dsb sy":::"memory");
+ ep[0x54/4]=(uint32_t)(OP13_WIFI_IOVA+0x40);
+ ep[0x58/4]=0;ep[0x5c/4]=~7u;
+ ep[0x50/4]=(cap&~(0x71u<<16))|(0x51u<<16);
+ __asm__ volatile("dsb sy":::"memory");
+ print("op13-wifi-bhi: MSI vector0 owned RAM sink; control=%x address=%x mask=%x\n",(uint64_t)(ep[0x50/4]>>16),(uint64_t)ep[0x54/4],(uint64_t)ep[0x5c/4]);
+ print("op13-wifi-bhi: BDF0100 maps SID1401 at hash=%x; bootstrap bytes=%x IOVA=%x\n",(uint64_t)hash,0x80000ULL,OP13_WIFI_IOVA);
+ fb_reply("INFO","BHI firmware DMA test next; watchdog armed for20s");
+ efi_status s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -5;
+ /* Both PCI command registers: MEM|MASTER, no I/O decode. */
+ op13_wifi_link_write(0x40000004,6);
+ *(volatile uint32_t *)(uintptr_t)0x40100004=6;__asm__ volatile("dsb sy":::"memory");
+ if((op13_wifi_mhi_read(0x40100004)&7)!=6||(op13_wifi_mhi_read(0x40000004)&7)!=6){
+  BS->set_watchdog_timer(0,0,0,0);return -6;
+ }
+ BS->set_watchdog_timer(0,0,0,0);
+ print("op13-wifi-mhi: SID and MSI private-sink prepared; no BHI request yet\n");
+ return 0;
+}
diff --git a/xnuloader/op13_wifi_ce.h b/xnuloader/op13_wifi_ce.h
new file mode 100644
index 0000000..4ac3d96
--- /dev/null
+++ b/xnuloader/op13_wifi_ce.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Native Peach v2 CE register survey. Register geometry from pinned Qualcomm
+ * ISC headers msmhwiobase.h/soc_ce_seq_hwioreg.h and CNSS reg.h/pci.c.
+ * Only BAR remap selection is written; CE registers and DMA rings are read-only.
+ */
+#ifndef OP13_WIFI_CE_H
+#define OP13_WIFI_CE_H
+#include <stdint.h>
+#include <stddef.h>
+#define OP13_CE_WINDOW 0x3278u
+#define OP13_CE_BASE 0x01b80000u
+struct op13_ce_io {void *cookie;int(*read)(void*,uint32_t,uint32_t*);int(*write)(void*,uint32_t,uint32_t);};
+struct op13_ce_snapshot {uint32_t saved_window,selected_window;uint32_t values[4][2][7];unsigned count,restored;};
+static int op13_ce_bar_allowed(uint32_t offset,int write)
+{
+ if(offset==OP13_CE_WINDOW)return 1;
+ if(write||offset<0x80000||offset>=0x88000||(offset&3))return 0;
+ unsigned local=(offset-0x80000)&0xfff;
+ return local==0||local==4||local==8||local==12||local==16||local==0x400||local==0x404;
+}
+static int op13_ce_snapshot(const struct op13_ce_io *io,int ready,struct op13_ce_snapshot *s)
+{
+ if(!ready||!io||!io->read||!io->write||!s)return -1;
+ *s=(struct op13_ce_snapshot){0};
+ if(io->read(io->cookie,OP13_CE_WINDOW,&s->saved_window)||s->saved_window==~0u)return -2;
+ s->selected_window=(s->saved_window&~0x3fu)|0x40000000u|((OP13_CE_BASE>>19)&0x3f);
+ int rc=0;uint32_t value;
+ /* A failed write may have landed: always try to restore the captured value. */
+ if(io->write(io->cookie,OP13_CE_WINDOW,s->selected_window)||
+    io->read(io->cookie,OP13_CE_WINDOW,&value)||value!=s->selected_window)rc=-3;
+ static const uint32_t offsets[7]={0,4,8,12,16,0x400,0x404};
+ for(unsigned ce=0;!rc&&ce<4;ce++)for(unsigned kind=0;!rc&&kind<2;kind++)for(unsigned i=0;!rc&&i<7;i++){
+  uint32_t offset=0x80000+ce*0x2000+kind*0x1000+offsets[i];
+  if(!op13_ce_bar_allowed(offset,0)||io->read(io->cookie,offset,&value)||value==~0u)rc=-4;
+  else{s->values[ce][kind][i]=value;s->count++;}
+ }
+ if(io->write(io->cookie,OP13_CE_WINDOW,s->saved_window)||
+    io->read(io->cookie,OP13_CE_WINDOW,&value)||value!=s->saved_window)return -5;
+ s->restored=1;return rc;
+}
+#endif
diff --git a/xnuloader/op13_wifi_ce_rings.h b/xnuloader/op13_wifi_ce_rings.h
new file mode 100644
index 0000000..b924487
--- /dev/null
+++ b/xnuloader/op13_wifi_ce_rings.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Seven native Peach/Kiwi host rings. CE9..11 are reserved for MHI.
+ * Fixed descriptors/pointers live in the unused owned DMA interval24..32MiB,
+ * between RDDM[16,23.5MiB) and WLAN runtime allocations[32MiB,...).
+ */
+#ifndef OP13_WIFI_CE_RINGS_H
+#define OP13_WIFI_CE_RINGS_H
+#include "op13_wifi_ce.h"
+#define OP13_CE_MEM_FIRST 0x1800000u
+#define OP13_CE_MEM_END   0x1900000u
+struct op13_ce_ring {unsigned ce,kind,entries,words;uint32_t ring_offset,pointer_offset,buffer_offset,stride,max_bytes;};
+static const struct op13_ce_ring op13_ce_rings[7]={
+ {0,0,16,4,0x1800000,0x1801000,0x1870000,2048,2048},
+ {1,1,64,2,0x1802000,0x1801004,0x1810000,2048,2048},
+ {1,2,64,4,0x1803000,0x1801008,0,0,0},
+ {2,1,64,2,0x1804000,0x180100c,0x1830000,4096,3520},
+ {2,2,64,4,0x1805000,0x1801010,0,0,0},
+ {3,0,32,4,0x1806000,0x1801014,0x1880000,4096,3520},
+ {4,0,256,4,0x1807000,0x1801018,0x18a0000,256,256},
+};
+static uint32_t op13_ce_r0(const struct op13_ce_ring *r)
+{return 0x80000+r->ce*0x2000+(r->kind?0x1000:0)+(r->kind==2?0x58:0);}
+static uint32_t op13_ce_r2(const struct op13_ce_ring *r)
+{return 0x80000+r->ce*0x2000+(r->kind?0x1000:0)+0x400+(r->kind==2?8:0);}
+static int op13_ce_init_allowed(uint32_t off,int write)
+{
+ if(off==OP13_CE_WINDOW)return 1;
+ if(off&3)return 0;
+ for(unsigned i=0;i<7;i++){
+  const struct op13_ce_ring *r=&op13_ce_rings[i];uint32_t r0=op13_ce_r0(r),r2=op13_ce_r2(r);
+  if(off==r2||off==r2+4)return 1;
+  if(off==r0||off==r0+4||off==r0+8||off==r0+16||off==r0+(r->kind==2?0x14:0x1c)||off==r0+(r->kind==2?0x18:0x20)||
+     off==r0+(r->kind==2?0x24:0x30)||off==r0+(r->kind==2?0x38:0x4c))return 1;
+  if(r->kind!=2&&off==r0+0x34)return 1;
+  if(r->kind==1&&off==0x80000+r->ce*0x2000+0x1000+0xb0)return 1;
+  if(!write&&off==r0+12)return 1;
+ }
+ return 0;
+}
+static int op13_ce_owned(uint32_t offset,uint32_t size,uint64_t pool_bytes)
+{return offset>=OP13_CE_MEM_FIRST&&offset<OP13_CE_MEM_END&&size<=OP13_CE_MEM_END-offset&&
+        offset<=pool_bytes&&size<=pool_bytes-offset;}
+static int op13_ce_plan_valid(uint64_t iova,uint64_t pool_bytes)
+{
+ if(iova!=0x18000000ULL||pool_bytes!=0x4000000ULL)return 0;
+ for(unsigned i=0;i<7;i++){
+  const struct op13_ce_ring *r=&op13_ce_rings[i];
+  if(!r->entries||(r->entries&(r->entries-1))||(r->ring_offset&0xfff)||(r->pointer_offset&3)||
+     !op13_ce_owned(r->ring_offset,r->entries*r->words*4,pool_bytes)||!op13_ce_owned(r->pointer_offset,4,pool_bytes))return 0;
+  if(r->kind!=2&&(!op13_ce_owned(r->buffer_offset,r->entries*r->stride,pool_bytes)||r->max_bytes>r->stride))return 0;
+ }
+ struct{uint32_t offset,size;} areas[21];unsigned count=0;
+ for(unsigned i=0;i<7;i++){
+  const struct op13_ce_ring *r=&op13_ce_rings[i];
+  areas[count++]=(typeof(*areas)){r->ring_offset,r->entries*r->words*4};
+  areas[count++]=(typeof(*areas)){r->pointer_offset,4};
+  if(r->kind!=2)areas[count++]=(typeof(*areas)){r->buffer_offset,r->entries*r->stride};
+ }
+ for(unsigned i=0;i<count;i++)for(unsigned j=0;j<i;j++)
+  if(areas[i].offset<areas[j].offset+areas[j].size&&areas[j].offset<areas[i].offset+areas[i].size)return 0;
+ return 1;
+}
+/* Runs only after owned descriptor/pointer RAM is initialized, and all ring
+ * registers have been preflighted as disabled/unconfigured in one pass. */
+static int op13_ce_program(const struct op13_ce_io *io,uint64_t iova,uint64_t pool_bytes)
+{
+ if(!io||!io->read||!io->write||!op13_ce_plan_valid(iova,pool_bytes))return -1;
+ for(unsigned i=0;i<7;i++){
+  const struct op13_ce_ring *r=&op13_ce_rings[i];uint32_t b=op13_ce_r0(r),p=op13_ce_r2(r);
+  uint64_t address=iova+r->ring_offset,pointer=iova+r->pointer_offset;
+  struct{uint32_t off,value;} writes[]={
+   {b+16,0}, /* Disable while programming. */
+   {b,(uint32_t)address},{b+4,(uint32_t)(address>>32)|(r->entries*r->words<<8)},
+   {b+8,r->words|(r->kind==2?(100+r->ce)<<8:0)},
+   {b+(r->kind==2?0x14:0x1c),(uint32_t)pointer},
+   {b+(r->kind==2?0x18:0x20),(uint32_t)(pointer>>32)},
+   {b+(r->kind==2?0x24:0x30),0}, /* Polling: IRQ thresholds off. */
+   {b+(r->kind==2?0x38:0x4c),0}, /* MSI enable off. */
+   {p,0},{p+4,0},
+  };
+  for(unsigned j=0;j<sizeof writes/sizeof *writes;j++){
+   if(!op13_ce_init_allowed(writes[j].off,1)||io->write(io->cookie,writes[j].off,writes[j].value))return -2;
+  }
+  if(r->kind!=2&&io->write(io->cookie,b+0x34,0))return -2;
+  if(r->kind==1){
+   uint32_t ctrl=0x80000+r->ce*0x2000+0x1000+0xb0,value;
+   if(io->read(io->cookie,ctrl,&value)||value==~0u||io->write(io->cookie,ctrl,(value&~0xffffu)|r->max_bytes))return -2;
+  }
+  uint32_t misc=r->kind==2?0x40:0x42;
+  const struct{uint32_t off,mask,value;} verify[]={
+   {b,~0u,(uint32_t)address},{b+4,0xffffffu,(uint32_t)(address>>32)|(r->entries*r->words<<8)},
+   {b+8,0xffffu,r->words|(r->kind==2?(100+r->ce)<<8:0)},
+   {b+(r->kind==2?0x14:0x1c),~0u,(uint32_t)pointer},
+   {b+(r->kind==2?0x18:0x20),0xffu,(uint32_t)(pointer>>32)},
+   {b+(r->kind==2?0x38:0x4c),0x100u,0},
+  };
+  for(unsigned j=0;j<sizeof verify/sizeof *verify;j++){
+   uint32_t value;if(io->read(io->cookie,verify[j].off,&value)||(value&verify[j].mask)!=verify[j].value)return -3;
+  }
+  uint32_t value;
+  if(io->write(io->cookie,b+16,misc)||io->read(io->cookie,b+16,&value)||(value&0x7f)!=misc)return -3;
+ }
+ return 0;
+}
+#endif
diff --git a/xnuloader/op13_wifi_ce_rings.inc b/xnuloader/op13_wifi_ce_rings.inc
new file mode 100644
index 0000000..f8f2492
--- /dev/null
+++ b/xnuloader/op13_wifi_ce_rings.inc
@@ -0,0 +1,67 @@
+#include "op13_wifi_ce_rings.h"
+_Static_assert(OP13_CE_MEM_FIRST>=OP13_WIFI_RDDM_OFFSET+OP13_WIFI_RDDM_BYTES,"CE overlaps RDDM");
+_Static_assert(OP13_CE_MEM_END<=0x2000000,"CE overlaps WLAN requested memory");
+static int op13_wifi_ce_rings_ready,op13_wifi_ce_init_fault;
+static int op13_wifi_ce_init_read(void *cookie,uint32_t offset,uint32_t *value)
+{
+ (void)cookie;uint64_t address=0x40400000ULL+offset,par=uefi_page_translation(address);
+ if(!value||!op13_ce_init_allowed(offset,0)||(par&1)||
+    (par&0x000ffffffffff000ULL)!=(address&~0xfffULL))return -1;
+ __asm__ volatile("dsb sy":::"memory");*value=*(volatile uint32_t *)(uintptr_t)address;
+ __asm__ volatile("dsb sy":::"memory");return 0;
+}
+static int op13_wifi_ce_init_write(void *cookie,uint32_t offset,uint32_t value)
+{
+ (void)cookie;uint64_t address=0x40400000ULL+offset,par;
+ if(!op13_ce_init_allowed(offset,1))return -1;
+ __asm__ volatile("at s1e1w, %1\nisb\nmrs %0, par_el1":"=r"(par):"r"(address):"memory");
+ if((par&1)||(par&0x000ffffffffff000ULL)!=(address&~0xfffULL))return -1;
+ __asm__ volatile("dsb sy":::"memory");*(volatile uint32_t *)(uintptr_t)address=value;
+ __asm__ volatile("dsb sy":::"memory");return 0;
+}
+static int op13_wifi_ce_init(void)
+{
+ struct mhi_host *h=&op13_wifi_mhi_host;
+ if(!op13_wifi_fw_init_done||op13_wifi_mhi_stopped||op13_wifi_ce_init_fault||op13_wifi_ce_rings_ready||
+    !h->powered||h->failed||h->ee!=MHI_HOST_EE_AMSS||h->state!=MHI_HOST_STATE_M0||
+    !op13_ce_plan_valid(OP13_WIFI_IOVA,OP13_WIFI_DMA_BYTES))return -1;
+ const struct op13_ce_io io={0,op13_wifi_ce_init_read,op13_wifi_ce_init_write};
+ uint32_t saved=0,selected=0,value=0;int changed=0,rc=-2;
+ efi_status status=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(status))return -2;
+ if(io.read(0,OP13_CE_WINDOW,&saved)||saved==~0u)goto done;
+ selected=(saved&~0x3fu)|0x40000037u;changed=1;
+ if(io.write(0,OP13_CE_WINDOW,selected)||io.read(0,OP13_CE_WINDOW,&value)||value!=selected)goto restore;
+ /* Every ring must be unconfigured BEFORE any ring or DMA-memory changes. */
+ for(unsigned i=0;i<7;i++){
+  uint32_t b=op13_ce_r0(&op13_ce_rings[i]);
+  if(io.read(0,b+16,&value)||!(value&0x80)||(value&0x40))goto restore;
+  for(unsigned j=0;j<3;j++)if(io.read(0,b+j*4,&value)||value)goto restore;
+ }
+ memset((void *)(uintptr_t)(op13_wifi_dma_pool+OP13_CE_MEM_FIRST),0,OP13_CE_MEM_END-OP13_CE_MEM_FIRST);
+ for(unsigned i=0;i<7;i++){
+  const struct op13_ce_ring *r=&op13_ce_rings[i];if(r->kind!=1)continue;
+  uint32_t *desc=(uint32_t *)(uintptr_t)(op13_wifi_dma_pool+r->ring_offset);
+  for(unsigned n=0;n<r->entries;n++){
+   uint64_t address=OP13_WIFI_IOVA+r->buffer_offset+(uint64_t)n*r->stride;
+   desc[n*2]=(uint32_t)address;desc[n*2+1]=(uint32_t)(address>>32);
+  }
+ }
+ __asm__ volatile("dsb sy":::"memory");
+ rc=op13_ce_program(&io,OP13_WIFI_IOVA,OP13_WIFI_DMA_BYTES);if(rc)goto restore;
+ /* Post N-1 receive buffers only AFTER all seven ring addresses were verified. */
+ for(unsigned i=0;i<7;i++){
+  const struct op13_ce_ring *r=&op13_ce_rings[i];if(r->kind!=1)continue;
+  uint32_t hp=(r->entries-1)*r->words;
+  if(io.write(0,op13_ce_r2(r),hp)||io.read(0,op13_ce_r2(r),&value)||value!=hp){rc=-4;goto restore;}
+ }
+ op13_wifi_ce_rings_ready=1;
+restore:
+ if(changed&&(io.write(0,OP13_CE_WINDOW,saved)||io.read(0,OP13_CE_WINDOW,&value)||value!=saved))rc=-5;
+done:
+ BS->set_watchdog_timer(0,0,0,0);
+ print("op13-wifi-ce: seven owned rings configured=%d rc=%d memory-offset=%x..%x window-restored=%d; no WLAN mode sent\n",
+  (uint64_t)op13_wifi_ce_rings_ready,(uint64_t)(int64_t)rc,(uint64_t)OP13_CE_MEM_FIRST,
+  (uint64_t)OP13_CE_MEM_END,(uint64_t)(changed&&value==saved));
+ if(rc){op13_wifi_ce_init_fault=1;op13_wifi_ce_rings_ready=0;op13_wifi_mhi_stop_failed();}
+ return rc;
+}
diff --git a/xnuloader/op13_wifi_ce_survey.inc b/xnuloader/op13_wifi_ce_survey.inc
new file mode 100644
index 0000000..700e401
--- /dev/null
+++ b/xnuloader/op13_wifi_ce_survey.inc
@@ -0,0 +1,44 @@
+#include "op13_wifi_ce.h"
+static int op13_wifi_ce_fault;
+static int op13_wifi_ce_read(void *cookie,uint32_t offset,uint32_t *value)
+{
+ (void)cookie;
+ uint64_t address=0x40400000ULL+offset,par=uefi_page_translation(address);
+ if(!value||op13_wifi_ce_fault||!op13_ce_bar_allowed(offset,0)||
+    (par&1)||(par&0x000ffffffffff000ULL)!=(address&~0xfffULL))return -1;
+ __asm__ volatile("dsb sy":::"memory");
+ *value=*(volatile uint32_t *)(uintptr_t)address;
+ __asm__ volatile("dsb sy":::"memory");return 0;
+}
+static int op13_wifi_ce_write(void *cookie,uint32_t offset,uint32_t value)
+{
+ (void)cookie;
+ uint64_t address=0x40400000ULL+offset,par;
+ if(!op13_ce_bar_allowed(offset,1))return -1;
+ __asm__ volatile("at s1e1w, %1\nisb\nmrs %0, par_el1":"=r"(par):"r"(address):"memory");
+ if((par&1)||(par&0x000ffffffffff000ULL)!=(address&~0xfffULL))return -1;
+ __asm__ volatile("dsb sy":::"memory");
+ *(volatile uint32_t *)(uintptr_t)address=value;
+ __asm__ volatile("dsb sy":::"memory");return 0;
+}
+static int op13_wifi_ce_survey(void)
+{
+ struct mhi_host *h=&op13_wifi_mhi_host;
+ if(!op13_wifi_fw_init_done||op13_wifi_mhi_stopped||!h->powered||h->failed||
+    h->ee!=MHI_HOST_EE_AMSS||h->state!=MHI_HOST_STATE_M0||op13_wifi_mhi_adapter_fault)return -1;
+ struct op13_ce_snapshot s;struct op13_ce_io io={0,op13_wifi_ce_read,op13_wifi_ce_write};
+ efi_status status=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(status))return -2;
+ int rc=op13_ce_snapshot(&io,1,&s);
+ BS->set_watchdog_timer(0,0,0,0);
+ print("op13-wifi-ce: native v2 base=%x selector=%x saved=%x selected=%x reads=%d restored=%d rc=%d\n",
+  (uint64_t)OP13_CE_BASE,(uint64_t)OP13_CE_WINDOW,(uint64_t)s.saved_window,(uint64_t)s.selected_window,
+  (uint64_t)s.count,(uint64_t)s.restored,(uint64_t)(int64_t)rc);
+ if(rc){op13_wifi_ce_fault=1;return rc;}
+ for(unsigned ce=0;ce<4;ce++)for(unsigned kind=0;kind<2;kind++){
+  const uint32_t *v=s.values[ce][kind];
+  print("op13-wifi-ce: CE%d %s base=%x:%x id=%x status=%x misc=%x hp=%x tp=%x\n",
+   (uint64_t)ce,kind?"dst":"src",(uint64_t)v[1],(uint64_t)v[0],(uint64_t)v[2],
+   (uint64_t)v[3],(uint64_t)v[4],(uint64_t)v[5],(uint64_t)v[6]);
+ }
+ return 0;
+}
diff --git a/xnuloader/op13_wifi_cesta.h b/xnuloader/op13_wifi_cesta.h
new file mode 100644
index 0000000..c798547
--- /dev/null
+++ b/xnuloader/op13_wifi_cesta.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Bounded PCIe CRM-v2 software vote, based on vendor register/ABI definitions.
+ * Only root0 SW-DRV0 ACTIVE performance is changed; HW channels and bandwidth
+ * votes are untouched. Gen1=2 follows the stock PCIe performance-level enum.
+ */
+#ifndef OP13_WIFI_CESTA_H
+#define OP13_WIFI_CESTA_H
+#include <stdint.h>
+struct op13_cesta_io {
+ void *context;
+ uint32_t (*read)(void *,uint32_t);
+ void (*write)(void *,uint32_t,uint32_t);
+ void (*delay_us)(void *,unsigned);
+};
+enum {
+ OP13_CRM_SW_ACTIVE=0x3b0, OP13_CRM_SW_IRQ=0x3c0, OP13_CRM_SW_IRQ_CLEAR=0x3c4,
+ OP13_CRM_COMMON_VERSION=0x4f00, OP13_CRM_COMMON_CONFIG=0x4f04,
+ OP13_CRM_COMMON_ENABLE=0x4f0c, OP13_CRM_CURRENT_PERF=0x2824
+};
+static inline int
+op13_cesta_gen1_vote(const struct op13_cesta_io *io,uint32_t *saved)
+{
+ if(!io||!io->read||!io->write||!io->delay_us||!saved) return -1;
+ void *c=io->context;
+ if(io->read(c,OP13_CRM_COMMON_VERSION)!=0x20000 ||
+    io->read(c,OP13_CRM_COMMON_CONFIG)!=0x80228225 ||
+    !(io->read(c,OP13_CRM_COMMON_ENABLE)&1)) return -1;
+ uint32_t old=io->read(c,OP13_CRM_SW_ACTIVE);
+ /* Only claim an idle software vote, with no pending completion to consume. */
+ if(old || io->read(c,OP13_CRM_SW_IRQ) || (io->read(c,OP13_CRM_CURRENT_PERF)&7)) return -2;
+ *saved=old;
+ io->write(c,OP13_CRM_SW_ACTIVE,2);
+ for(unsigned i=0;i<10000;i++) {
+  uint32_t v=io->read(c,OP13_CRM_CURRENT_PERF)&7;
+  if(v>=2 && v<=5) return 0;
+  io->delay_us(c,10);
+ }
+ return -3; /* Vote may be live: retain resources and cold-reset. */
+}
+static inline int
+op13_cesta_restore(const struct op13_cesta_io *io,uint32_t saved)
+{
+ if(!io||!io->read||!io->write||!io->delay_us||saved) return -1;
+ io->write(io->context,OP13_CRM_SW_ACTIVE,saved);
+ for(unsigned i=0;i<10000;i++) {
+  if((io->read(io->context,OP13_CRM_CURRENT_PERF)&7)==saved) {
+   /* Initial IRQ state was zero; clear only our resource0 completion. */
+   io->write(io->context,OP13_CRM_SW_IRQ_CLEAR,1);
+   return io->read(io->context,OP13_CRM_SW_IRQ)==0 ? 0 : -3;
+  }
+  io->delay_us(io->context,10);
+ }
+ return -3;
+}
+#endif
diff --git a/xnuloader/op13_wifi_cesta_hw.h b/xnuloader/op13_wifi_cesta_hw.h
new file mode 100644
index 0000000..017f067
--- /dev/null
+++ b/xnuloader/op13_wifi_cesta_hw.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Cold-only PCIe0 HW-DRV0 Gen1 power map, transcribed from pinned crm-v2.c.
+ * Refuse previously owned channels/tables. Leave other resources and all BW
+ * passthrough votes unchanged. Once committed, release only by cold reset.
+ */
+#ifndef OP13_WIFI_CESTA_HW_H
+#define OP13_WIFI_CESTA_HW_H
+#include "op13_wifi_cesta.h"
+static inline int op13_cesta_hw_gen1(const struct op13_cesta_io *io)
+{
+ if(!io||!io->read||!io->write||!io->delay_us)return -1;
+ void *c=io->context;
+ if(io->read(c,OP13_CRM_COMMON_VERSION)!=0x20000||
+    io->read(c,OP13_CRM_COMMON_CONFIG)!=0x80228225||
+    !(io->read(c,OP13_CRM_COMMON_ENABLE)&1))return -1;
+ if(io->read(c,0x370)||io->read(c,0x374))return -2;
+ /* Both channels must be completely unclaimed. Check independent resource1
+  * and all16 passthrough nodes, not only the resource we are about to claim. */
+ for(unsigned resource=0;resource<2;resource++)
+  for(unsigned ch=0;ch<2;ch++)for(unsigned st=0;st<5;st++)
+   if(io->read(c,resource*0x2c+ch*0x14+st*4))return -2;
+ for(unsigned resource=0;resource<16;resource++)
+  for(unsigned ch=0;ch<2;ch++)for(unsigned st=0;st<5;st++)
+   if(io->read(c,0xb0+resource*0x2c+ch*0x14+st*4))return -2;
+ /* D0 map_save(Gen1): power states0/1 -> performance2, other states0.
+  * HW-DRV0/resource0/channel0 only. No bandwidth register writes. */
+ const uint32_t values[5]={2,2,0,0,0};
+ for(unsigned st=0;st<5;st++)io->write(c,st*4,values[st]);
+ io->write(c,0x374,1);
+ for(unsigned i=0;i<100;i++){
+  if((io->read(c,0x370)&3)==1)return 0;
+  io->delay_us(c,100);
+ }
+ return -3;
+}
+#endif
diff --git a/xnuloader/op13_wifi_cesta_probe.inc b/xnuloader/op13_wifi_cesta_probe.inc
new file mode 100644
index 0000000..e9ee41a
--- /dev/null
+++ b/xnuloader/op13_wifi_cesta_probe.inc
@@ -0,0 +1,56 @@
+#include "op13_wifi_cesta.h"
+static uint32_t op13_wifi_crm_read(void *context,uint32_t offset)
+{
+ (void)context;
+ return *(volatile uint32_t *)(uintptr_t)(0x01d01000u+offset);
+}
+static void op13_wifi_crm_write(void *context,uint32_t offset,uint32_t value)
+{
+ (void)context;
+ if(!((offset==OP13_CRM_SW_ACTIVE&&(value==0||value==2)) ||
+      (offset==OP13_CRM_SW_IRQ_CLEAR&&value==1))) {
+  op13_wifi_votes_stuck=1;return;
+ }
+ print("op13-wifi-cesta: write address=%x value=%x\n",(uint64_t)(0x01d01000u+offset),(uint64_t)value);
+ *(volatile uint32_t *)(uintptr_t)(0x01d01000u+offset)=value;
+ __asm__ volatile("dsb sy":::"memory");
+}
+static void op13_wifi_crm_delay(void *context,unsigned us)
+{
+ (void)context;BS->stall(us);
+}
+static void op13_wifi_cesta_probe(void)
+{
+ if(op13_wifi_map_registers()) {print("op13-wifi-cesta: no votes: mapping incomplete\n");return;}
+ struct op13_wifi_clock_protocol *p=0;uint64_t id=0;
+ efi_status s=BS->locate_protocol(&op13_wifi_clock_guid,0,(void **)&p);
+ if(EFI_ERROR(s)||!p||p->revision!=0x1000b||!p->get_id||!p->enable||!p->disable||!p->is_on)return;
+ s=p->get_id(p,"gcc_pcie_0_mstr_axi_clk",&id);
+ if(EFI_ERROR(s)||id!=0x4010029) {print("op13-wifi-cesta: no votes: unknown AXI clock ID\n");return;}
+ s=p->enable(p,id);
+ print("op13-wifi-cesta: AXI clock enable status=%x\n",s);
+ if(EFI_ERROR(s)){op13_wifi_votes_stuck=1;return;}
+ struct op13_cesta_io io={0,op13_wifi_crm_read,op13_wifi_crm_write,op13_wifi_crm_delay};
+ uint32_t saved=0;
+ print("op13-wifi-cesta: initial software-vote=%x irq=%x current-perf=%x\n",
+  (uint64_t)op13_wifi_crm_read(0,OP13_CRM_SW_ACTIVE),
+  (uint64_t)op13_wifi_crm_read(0,OP13_CRM_SW_IRQ),
+  (uint64_t)op13_wifi_crm_read(0,OP13_CRM_CURRENT_PERF));
+ int ret=op13_cesta_gen1_vote(&io,&saved);
+ print("op13-wifi-cesta: Gen1 vote result=%x current-perf=%x\n",(uint64_t)(int64_t)ret,
+  (uint64_t)op13_wifi_crm_read(0,OP13_CRM_CURRENT_PERF));
+ if(ret==-3){op13_wifi_votes_stuck=1;print("op13-wifi-cesta: vote timeout: retain resources, cold reset required\n");return;}
+ if(!ret) {
+  uint8_t on=0;s=p->is_on(p,id,&on);
+  print("op13-wifi-cesta: Gen1 AXI clock state-status=%x on=%d\n",s,(uint64_t)on);
+ }
+ s=p->disable(p,id);
+ print("op13-wifi-cesta: own AXI clock release status=%x\n",s);
+ if(EFI_ERROR(s)){op13_wifi_votes_stuck=1;return;}
+ if(ret) return; /* Ownership/profile guard did not change a CRM vote. */
+ ret=op13_cesta_restore(&io,saved);
+ print("op13-wifi-cesta: restoration result=%x current-perf=%x irq=%x\n",(uint64_t)(int64_t)ret,
+  (uint64_t)op13_wifi_crm_read(0,OP13_CRM_CURRENT_PERF),(uint64_t)op13_wifi_crm_read(0,OP13_CRM_SW_IRQ));
+ if(ret){op13_wifi_votes_stuck=1;return;}
+ print("op13-wifi-cesta: Gen1 vote and restoration passed; no radio traffic or DMA\n");
+}
diff --git a/xnuloader/op13_wifi_clocks.inc b/xnuloader/op13_wifi_clocks.inc
new file mode 100644
index 0000000..c1bff4b
--- /dev/null
+++ b/xnuloader/op13_wifi_clocks.inc
@@ -0,0 +1,106 @@
+/* Dodge PCIe0 queries plus an explicit, reversible power/clock preflight.
+ * Prefix ABI matches the existing verified SM8750 ClockDxe v0x1000b adapter.
+ * The power-domain getter is the public EFIClock.h slot at offset 0x50.
+ */
+struct op13_wifi_clock_protocol {
+ uint64_t revision;
+ efi_status (*get_id)(struct op13_wifi_clock_protocol *,const char *,uint64_t *);
+ efi_status (*enable)(struct op13_wifi_clock_protocol *,uint64_t);
+ efi_status (*disable)(struct op13_wifi_clock_protocol *,uint64_t);
+ void *is_enabled;
+ efi_status (*is_on)(struct op13_wifi_clock_protocol *,uint64_t,uint8_t *);
+ void *set_frequency;
+ efi_status (*get_frequency)(struct op13_wifi_clock_protocol *,uint64_t,uint32_t *);
+ void *calc_frequency, *select_external;
+ efi_status (*get_power_id)(struct op13_wifi_clock_protocol *,const char *,uint64_t *);
+ efi_status (*enable_power)(struct op13_wifi_clock_protocol *,uint64_t);
+ efi_status (*disable_power)(struct op13_wifi_clock_protocol *,uint64_t);
+};
+_Static_assert(offsetof(struct op13_wifi_clock_protocol,is_on)==0x28,"clock state ABI");
+_Static_assert(offsetof(struct op13_wifi_clock_protocol,get_frequency)==0x38,"clock rate ABI");
+_Static_assert(offsetof(struct op13_wifi_clock_protocol,get_power_id)==0x50,"power ID ABI");
+static const efi_guid op13_wifi_clock_guid={0x241afae6,0x885f,0x4f6c,{0xa7,0xea,0xc2,0x8e,0xab,0x79,0xc3,0xe5}};
+static int op13_wifi_votes_stuck;
+static void (*op13_wifi_survey_callback)(void);
+static void
+op13_wifi_clocks(void)
+{
+ static const char *const names[]={
+  "gcc_pcie_0_aux_clk", "gcc_pcie_0_cfg_ahb_clk", "gcc_pcie_0_mstr_axi_clk",
+  "gcc_pcie_0_slv_axi_clk", "gcc_pcie_0_slv_q2a_axi_clk", "gcc_pcie_0_pipe_clk",
+  "gcc_pcie_0_phy_rchng_clk", "gcc_pcie_rscc_ahb_clk", "gcc_pcie_rscc_xo_clk",
+  "pcie_ahb_clk", "pcie_anoc_ahb_clk", "pcie_axi_clk", "pcie_qtb_clk",
+  "pcie_sf_axi_clk", "pcie_sf_qtb_clk", "pcie_sf_tbu_clk", "pcie_0_clkref_en"
+ };
+ struct op13_wifi_clock_protocol *p=0;
+ efi_status status=BS->locate_protocol(&op13_wifi_clock_guid,0,(void **)&p);
+ print("op13-wifi-clocks: locate=%x revision=%x\n",status,p?p->revision:0);
+ if(EFI_ERROR(status)||!p||p->revision!=0x1000b||!p->get_id||!p->is_on||!p->get_frequency) {
+  print("op13-wifi-clocks: unsupported getter ABI; no calls\n"); return;
+ }
+ for(unsigned i=0;i<sizeof(names)/sizeof(names[0]);i++) {
+  uint64_t id=0;uint32_t rate=0;uint8_t on=0;
+  efi_status a=p->get_id(p,names[i],&id),b=UINT64_MAX,c=UINT64_MAX;
+  if(!EFI_ERROR(a)){b=p->get_frequency(p,id,&rate);c=p->is_on(p,id,&on);}
+  print("op13-wifi-clocks: %s id-status=%x id=%x rate-status=%x hz=%d on-status=%x on=%d\n",
+    names[i],a,id,b,(uint64_t)rate,c,(uint64_t)on);
+ }
+ /* Exact ClockDxe table at file0x28148: power ID and ordinary ID share RVA156c. */
+ if(p->get_power_id && p->get_power_id==p->get_id) {
+  const char *domains[]={"gcc_pcie_0_gdsc","gcc_pcie_0_phy_gdsc"};
+  for(unsigned i=0;i<2;i++) {
+   uint64_t id=0;efi_status s=p->get_power_id(p,domains[i],&id);
+   print("op13-wifi-clocks: power-domain %s status=%x id=%x\n",domains[i],s,id);
+  }
+ }
+ print("op13-wifi-clocks: complete; no resource votes or hardware writes\n");
+}
+
+/* Explicit, bounded voting test. No PCIe, PHY, radio or DMA MMIO is accessed.
+ * Do not enable PIPE before the controller's PHY has been initialized.
+ * An ambiguous enable/disable failure requires cold reset, never kernel launch.
+ */
+static void
+op13_wifi_power_preflight(void)
+{
+ static const char *const names[]={"gcc_pcie_0_gdsc","gcc_pcie_0_phy_gdsc",
+  "gcc_pcie_0_cfg_ahb_clk","gcc_pcie_0_aux_clk","gcc_pcie_0_phy_rchng_clk",
+  "gcc_pcie_0_mstr_axi_clk","gcc_pcie_0_slv_axi_clk","gcc_pcie_0_slv_q2a_axi_clk"};
+ struct op13_wifi_clock_protocol *p=0;uint64_t ids[8]={0};unsigned acquired=0;
+ efi_status s=BS->locate_protocol(&op13_wifi_clock_guid,0,(void **)&p);
+ if(op13_wifi_votes_stuck||EFI_ERROR(s)||!p||p->revision!=0x1000b||!p->get_id||!p->enable||!p->disable||!p->is_on||
+    p->get_power_id!=p->get_id||p->enable_power!=p->enable||p->disable_power!=p->disable) {
+  print("op13-wifi-power: refused unsupported ABI or retained votes\n");return;
+ }
+ for(unsigned i=0;i<8;i++) {
+  s=p->get_id(p,names[i],&ids[i]);
+  print("op13-wifi-power: resolve %s status=%x id=%x\n",names[i],s,ids[i]);
+  if(EFI_ERROR(s)) return;
+  for(unsigned j=0;j<i;j++) if(ids[i]==ids[j]) {
+   print("op13-wifi-power: duplicate resource ID; no votes\n");return;
+  }
+ }
+ for(unsigned i=0;i<8;i++) {
+  s=p->enable(p,ids[i]);
+  print("op13-wifi-power: enable %s status=%x\n",names[i],s);
+  if(EFI_ERROR(s)) {op13_wifi_votes_stuck=1;print("op13-wifi-power: ambiguous enable; cold reset required\n");return;}
+  acquired++;
+  if(i>=2) {
+   uint8_t on=0;efi_status q=p->is_on(p,ids[i],&on);
+   print("op13-wifi-power: state %s status=%x on=%d\n",names[i],q,(uint64_t)on);
+   if(EFI_ERROR(q)||!on) break;
+  }
+  if(i==4 && op13_wifi_survey_callback) {
+   op13_wifi_survey_callback();
+   if(op13_wifi_votes_stuck) return;
+  }
+ }
+ unsigned checked=acquired;
+ while(acquired) {
+  unsigned i=acquired-1;s=p->disable(p,ids[i]);
+  print("op13-wifi-power: release %s status=%x\n",names[i],s);
+  if(EFI_ERROR(s)){op13_wifi_votes_stuck=1;print("op13-wifi-power: release failed; cold reset required\n");return;}
+  acquired--;
+ }
+ print("op13-wifi-power: preflight ended resources=%d; all acquired votes released\n",(uint64_t)checked);
+}
diff --git a/xnuloader/op13_wifi_dma_clocks.inc b/xnuloader/op13_wifi_dma_clocks.inc
new file mode 100644
index 0000000..dd36d90
--- /dev/null
+++ b/xnuloader/op13_wifi_dma_clocks.inc
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Explicit PCIe DMA/TBU clock votes through the verified firmware ABI only.
+ * Names taken from actual Dodge ClockDxe. No power-domain or global bypass.
+ */
+static int op13_wifi_dma_clocks_ready,op13_wifi_dma_clocks_attempted;
+static int op13_wifi_dma_clocks(void)
+{
+ if(!op13_wifi_dma_mapped||op13_wifi_dma_clocks_attempted)return -1;
+ op13_wifi_dma_clocks_attempted=1;
+ const char *names[]={"gcc_mmu_tcu_vote_clk","gcc_hlos1_vote_all_smmu_mmu_clk",
+  "gcc_hlos1_vote_aggre_noc_mmu_pcie_qtb_clk","gcc_cnoc_pcie_sf_axi_clk",
+  "gcc_ddrss_pcie_sf_qtb_clk"};
+ uint64_t ids[5]={0};struct op13_wifi_clock_protocol *p=0;
+ efi_status s=BS->locate_protocol(&op13_wifi_clock_guid,0,(void **)&p);
+ if(EFI_ERROR(s)||!p||p->revision!=0x1000b||!p->get_id||!p->enable||!p->is_on)return -2;
+ for(unsigned i=0;i<5;i++){
+  s=p->get_id(p,names[i],&ids[i]);uint8_t on=0;efi_status t=~0ULL;
+  if(!EFI_ERROR(s))t=p->is_on(p,ids[i],&on);
+  print("op13-wifi-dma: clock %s resolve=%x id=%x state=%x on=%d\n",names[i],s,ids[i],t,(uint64_t)on);
+  if(EFI_ERROR(s)||!ids[i]||EFI_ERROR(t))return -3;
+  for(unsigned j=0;j<i;j++)if(ids[i]==ids[j])return -3;
+ }
+ for(unsigned i=0;i<5;i++){
+  fb_reply("INFO",names[i]);
+  s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -4;
+  s=p->enable(p,ids[i]);BS->set_watchdog_timer(0,0,0,0);
+  uint8_t on=0;efi_status t=p->is_on(p,ids[i],&on);
+  print("op13-wifi-dma: clock enable %s status=%x state=%x on=%d; retained\n",names[i],s,t,(uint64_t)on);
+  if(EFI_ERROR(s)||EFI_ERROR(t))return -5;
+ }
+ op13_wifi_dma_clocks_ready=1;
+ print("op13-wifi-dma: dedicated DMA clock votes accepted; no GDS votes or DMA yet\n");return 0;
+}
diff --git a/xnuloader/op13_wifi_dma_map.inc b/xnuloader/op13_wifi_dma_map.inc
new file mode 100644
index 0000000..0e9dd1c
--- /dev/null
+++ b/xnuloader/op13_wifi_dma_map.inc
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Private SID1401 translation only; PCI bus mastering remains OFF.
+ * Context register formats/order cross-checked with updated iphont hk_wifi.c.
+ * Resource allocations and context retained until cold reset, including errors.
+ */
+static uint64_t op13_wifi_dma_pool,op13_wifi_dma_tables;
+static int op13_wifi_dma_attempted,op13_wifi_dma_mapped,op13_wifi_dma_alloc_only;
+static uint32_t op13_wifi_dma_cb_read(unsigned off)
+{
+ struct op13_wifi_smmu_plan *p=&op13_wifi_dma_plan;
+ uint64_t cb=0x15000000ULL+(p->pages+p->context)*(uint64_t)p->page;
+ return *(volatile uint32_t *)(uintptr_t)(cb+off);
+}
+static void op13_wifi_dma_cb_write(unsigned off,uint32_t value)
+{
+ /* This function can address only the verified unused context page. */
+ const unsigned allowed[]={0,0x10,0x20,0x24,0x28,0x2c,0x30,0x38,0x3c,0x58,0x610,0x7f0};
+ int ok=0;for(unsigned i=0;i<sizeof(allowed)/sizeof(*allowed);i++)if(off==allowed[i])ok=1;
+ if(!ok)return;
+ struct op13_wifi_smmu_plan *p=&op13_wifi_dma_plan;
+ uint64_t cb=0x15000000ULL+(p->pages+p->context)*(uint64_t)p->page;
+ *(volatile uint32_t *)(uintptr_t)(cb+off)=value;
+ __asm__ volatile("dsb sy":::"memory");
+}
+static int op13_wifi_dma_map(void)
+{
+ print("op13-wifi-dma: context_ready=%d attempted=%d\n",op13_wifi_smmu_context_ready,op13_wifi_dma_attempted);
+ if(!op13_wifi_smmu_context_ready||op13_wifi_dma_attempted)return -1;
+ op13_wifi_dma_attempted=1;
+ print("op13-wifi-dma: plan ctx=%x slot=%x page=%x pages=%x\n",op13_wifi_dma_plan.context,op13_wifi_dma_plan.slot,op13_wifi_dma_plan.page,op13_wifi_dma_plan.pages);
+ struct op13_wifi_smmu_plan *p=&op13_wifi_dma_plan;
+ if(p->context>=p->contexts||p->slot>=p->matches||p->page!=4096||p->pages!=128)return -2;
+ {
+  uint32_t ep_cmd=op13_wifi_mhi_read(0x40100004),rp_cmd=op13_wifi_mhi_read(0x40000004);
+  print("op13-wifi-dma: endpoint cmd=%x root cmd=%x\n",ep_cmd,rp_cmd);
+ }
+ if((op13_wifi_mhi_read(0x40100004)&7)!=2||(op13_wifi_mhi_read(0x40000004)&7)!=2)return -2;
+ volatile uint32_t *g=(volatile uint32_t *)(uintptr_t)0x15000000;
+ uint32_t smrs[256]={0},s2crs[256]={0};struct op13_wifi_smmu_plan check;
+ for(unsigned i=0;i<p->matches;i++){smrs[i]=g[(0x800+4*i)/4];s2crs[i]=g[(0xc00+4*i)/4];}
+ if(op13_wifi_smmu_choose(g[0],g[8],g[9],smrs,s2crs,&check)||check.slot!=p->slot||check.context!=p->context)return -3;
+ if(op13_wifi_dma_cb_read(0)&1)return -3;
+ uint64_t pool_alloc=0xa40000000ULL,tables=0xa48000000ULL;
+ /* The low-memory free block (0xbd5db000..0xbd9db000) holds data the hypervisor
+  * needs when a kernel is launched (an allocation there freezes the whole phone):
+  * the pool lives in the big high free block instead, which the card reaches
+  * through the SMMU's 40-bit outputs and the kernel transport accepts (<64 GB). */
+ efi_status s=BS->allocate_pages(AllocateAddress,EfiLoaderData,OP13_WIFI_DMA_BYTES/4096,&pool_alloc);
+ if(EFI_ERROR(s))return -4;
+ uint64_t pool=pool_alloc;
+ s=BS->allocate_pages(AllocateAddress,EfiLoaderData,OP13_WIFI_TABLES,&tables);
+ if(EFI_ERROR(s))return -4;
+ if(op13_wifi_dma_alloc_only){
+  /* bisect aid, finest grain: the EFI allocations alone; no attribute change,
+   * no stage-1 tables, no SMMU registers */
+  op13_wifi_dma_pool=pool;op13_wifi_dma_tables=tables;op13_wifi_dma_mapped=1;
+  print("op13-wifi-dma: alloc-only (pages alone): pool=%x tables=%x\n",pool,tables);return 0;
+ }
+ for(uint64_t at=tables;at<tables+OP13_WIFI_TABLES*4096ULL;at+=4096){
+  uint64_t par=uefi_page_translation(at);
+  if((par&1)||((par&0x000ffffffffff000ULL)!=at))return -5;
+ }
+ const efi_guid guid=EFI_CPU_ARCH_GUID;struct op13_wifi_cpu_arch *cpu=0;
+ s=BS->locate_protocol(&guid,0,(void **)&cpu);
+ if(EFI_ERROR(s)||!cpu||!cpu->set_memory_attributes)return -5;
+ for(uint64_t at=pool;at<pool+OP13_WIFI_DMA_BYTES;at+=4096){
+  uint64_t par=uefi_page_translation(at);
+  if((par&1)||((par&0x000ffffffffff000ULL)!=at))return -5;
+ }
+ /* Noncacheable CPU alias matching the SMMU's normal-NC MAIR index0. */
+ flush_dcache(pool,pool+OP13_WIFI_DMA_BYTES);
+ s=cpu->set_memory_attributes(cpu,pool,OP13_WIFI_DMA_BYTES,0x4002);
+ if(EFI_ERROR(s))return -6;
+ if(op13_wifi_smmu_tables((uint64_t (*)[512])(uintptr_t)tables,tables,pool))return -6;
+ flush_dcache(tables,tables+OP13_WIFI_TABLES*4096ULL);
+ print("op13-wifi-dma: owned pool=%x bytes=%x tables=%x slot=%d context=%d\n",pool,OP13_WIFI_DMA_BYTES,tables,(uint64_t)p->slot,(uint64_t)p->context);
+ if(op13_wifi_dma_alloc_only){
+  /* bisect aid: the EFI allocations, the non-cacheable pool attribute and the
+   * stage-1 tables stand; the SMMU registers themselves are left untouched */
+  op13_wifi_dma_pool=pool;op13_wifi_dma_tables=tables;op13_wifi_dma_mapped=1;
+  print("op13-wifi-dma: alloc-only mode: SMMU registers NOT programmed\n");return 0;
+ }
+ fb_reply("INFO","Private Wi-Fi context programming next; PCI BME remains off");
+ s=BS->set_watchdog_timer(20,0x10000,0,0);if(EFI_ERROR(s))return -7;
+ volatile uint32_t *gr1=(volatile uint32_t *)(uintptr_t)(0x15000000ULL+p->page);
+ op13_wifi_dma_cb_write(0,0);
+ gr1[(0x800+4*p->context)/4]=1;__asm__ volatile("dsb sy":::"memory");
+ gr1[p->context]=(1u<<16)|(3u<<8)|(15u<<12);__asm__ volatile("dsb sy":::"memory");
+ op13_wifi_dma_cb_write(0x10,1u|(1u<<4)|(7u<<15));
+ op13_wifi_dma_cb_write(0x30,25u|(1u<<8)|(1u<<10)|(3u<<12)|(1u<<23));
+ op13_wifi_dma_cb_write(0x20,(uint32_t)tables);op13_wifi_dma_cb_write(0x24,(uint32_t)(tables>>32));
+ op13_wifi_dma_cb_write(0x28,0);op13_wifi_dma_cb_write(0x2c,0);
+ op13_wifi_dma_cb_write(0x38,0xf404ff44);op13_wifi_dma_cb_write(0x3c,0);
+ op13_wifi_dma_cb_write(0x58,0xc00001fe);op13_wifi_dma_cb_write(0x610,p->context);
+ op13_wifi_dma_cb_write(0x7f0,1);
+ unsigned i;for(i=0;i<1000;i++){if(!(op13_wifi_dma_cb_read(0x7f4)&1))break;BS->stall(100);}
+ if(i==1000){BS->set_watchdog_timer(0,0,0,0);return -8;}
+ op13_wifi_dma_cb_write(0,(1u<<0)|(1u<<1)|(1u<<2)|(1u<<5)|(1u<<8)|(1u<<12));
+ g[(0xc00+4*p->slot)/4]=p->context;__asm__ volatile("dsb sy":::"memory");
+ g[(0x800+4*p->slot)/4]=0x80001401;__asm__ volatile("dsb sy":::"memory");
+ uint32_t smr=g[(0x800+4*p->slot)/4],s2cr=g[(0xc00+4*p->slot)/4],ctl=op13_wifi_dma_cb_read(0);
+ print("op13-wifi-dma: readback SMR=%x S2CR=%x SCTLR=%x TTBR0=%x:%x\n",(uint64_t)smr,(uint64_t)s2cr,(uint64_t)ctl,(uint64_t)op13_wifi_dma_cb_read(0x24),(uint64_t)op13_wifi_dma_cb_read(0x20));
+ BS->set_watchdog_timer(0,0,0,0);
+ if(smr!=0x80001401||(s2cr&0x300ff)!=p->context||!(ctl&1)||op13_wifi_dma_cb_read(0x20)!=(uint32_t)tables||op13_wifi_dma_cb_read(0x24)!=(uint32_t)(tables>>32))return -9;
+ op13_wifi_dma_pool=pool;op13_wifi_dma_tables=tables;op13_wifi_dma_mapped=1;
+ print("op13-wifi-dma: private mapping configured; BME OFF, no device DMA or firmware transfer performed\n");return 0;
+}
