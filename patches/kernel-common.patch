+			uint32_t was = gpr_dst_port;
+
+			gpr_dst_port = 2;
+			for (unsigned i = 0; i < 2; i++) {
+				rb_reset();
+				at = rb_param_begin(2, 0x08001032u);
+				rb_put32(cores[i]);
+				rb_param_end(at);
+				rb_cmd_end();
+				apr_wait_now = 1500;
