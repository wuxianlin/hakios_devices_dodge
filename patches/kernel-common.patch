+		{ 0x07001000, REACH_IID_PLAY_SHMEM, 1, 1 },               /* the shared-memory write endpoint */
+		{ 0x07001005, REACH_IID_PLAY_DEC, 1, 1 },                 /* the PCM decoder */
+		{ 0x07001003, REACH_IID_PLAY_CNV, 1, 1 },                 /* the PCM converter */
+		{ 0x07001002, REACH_IID_PLAY_VOL, 1, 1 },                 /* the volume control */
+		{ 0x07001015, REACH_IID_PLAY_MFC, 1, 1 },                 /* the multi-format converter */
+		{ 0x0700101a, REACH_IID_PLAY_LOG, 1, 1 },                 /* the data logger: the chain's terminator */
+	};
+	static const struct reach_link play_links[] = {
+		{ REACH_IID_PLAY_SHMEM, REACH_IID_PLAY_DEC },
+		{ REACH_IID_PLAY_DEC, REACH_IID_PLAY_CNV },
+		{ REACH_IID_PLAY_CNV, REACH_IID_PLAY_VOL },
+		{ REACH_IID_PLAY_VOL, REACH_IID_PLAY_MFC },
+		{ REACH_IID_PLAY_MFC, REACH_IID_PLAY_LOG },
+		{ REACH_IID_PLAY_LOG, REACH_IID_SPK_I2S },                /* across the subgraphs, from the chain's end */
