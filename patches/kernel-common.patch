diff --git a/xnuloader/op13_wifi_phy_probe.inc b/xnuloader/op13_wifi_phy_probe.inc
new file mode 100644
index 0000000..739070e
--- /dev/null
+++ b/xnuloader/op13_wifi_phy_probe.inc
@@ -0,0 +1,139 @@
+/* PCIe0 PHY-only bringup: endpoint stays in reset, no DMA or radio firmware.
+ * All setup data comes from the phone FDT and pinned OnePlus PCIe/GCC drivers.
+ * Resource retention is intentional: leave this probe by cold reset only.
+ */
+#include "op13_wifi_phy_data.h"
+#include "op13_wifi_cesta_hw.h"
+static void op13_wifi_hw_write(void *c,uint32_t o,uint32_t v)
+{
+ (void)c;
+ if(!((o<=16&&!(o&3)&&(v==0||v==2))||(o==0x374&&v==1)))return;
+ print("op13-wifi-hw-map: write offset=%x value=%x\n",(uint64_t)o,(uint64_t)v);
+ *(volatile uint32_t *)(uintptr_t)(0x1d01000u+o)=v;__asm__ volatile("dsb sy":::"memory");
+}
+static int op13_wifi_phy_ready,op13_wifi_phy_fault;
+static int op13_wifi_phy_address(uint32_t a)
+{
+ if(a&3)return 0;
+ if(a>=0x01c06000&&a<0x01c08000)return 1;
+ if(a==0x0016b080||a==0x0016b000||a==0x0016c01c||a==0x0f166000||a==0x0f166004)return 1;
+ if(a==0x01c00000||a==0x01c00040||a==0x01c01000||a==0x01c00174)return 1;
+ if(a>=0x01d07000&&a<0x01d07034)return 1;
+ if(a>=0x01d08000&&a<0x01d0801c)return 1;
+ return a==0x01d08040||a==0x01d08048||a==0x01d08090;
+}
+static int op13_wifi_phy_access(uint32_t a)
+{
+ uint64_t par=uefi_page_translation(a);
+ if(!op13_wifi_phy_address(a)||(par&1)||((par&0x000ffffffffff000ULL)!=(a&~0xfffULL))) {
+  op13_wifi_phy_fault=1;print("op13-wifi-phy: refused register=%x PAR=%x\n",(uint64_t)a,par);return 0;
+ }
+ return 1;
+}
+static uint32_t op13_wifi_phy_read(uint32_t a)
+{
+ return op13_wifi_phy_access(a)?*(volatile uint32_t *)(uintptr_t)a:0xffffffffu;
+}
+static void op13_wifi_phy_write(uint32_t a,uint32_t v)
+{
+ if(!op13_wifi_phy_access(a))return;
+ *(volatile uint32_t *)(uintptr_t)a=v;__asm__ volatile("dsb sy":::"memory");
+}
+static void op13_wifi_phy_update(uint32_t a,uint32_t clear,uint32_t set)
+{
+ uint32_t v=op13_wifi_phy_read(a);
+ if(!op13_wifi_phy_fault)op13_wifi_phy_write(a,(v&~clear)|set);
+}
+static void op13_wifi_phy_probe(void)
+{
+ op13_wifi_phy_ready=op13_wifi_phy_fault=0;
+ if(op13_wifi_map_registers())return;
+ struct op13_wifi_clock_protocol *p=0;
+ efi_status s=BS->locate_protocol(&op13_wifi_clock_guid,0,(void **)&p);
+ const char *names[]={"gcc_pcie_0_mstr_axi_clk","gcc_pcie_0_slv_axi_clk", "gcc_pcie_0_slv_q2a_axi_clk",
+  "gcc_pcie_0_pipe_clk","gcc_pcie_0_cfg_ahb_clk","gcc_pcie_0_phy_rchng_clk"};
+ const uint64_t expected[]={0x4010029,0x401002a,0x401002b,0x4010056,0x4010036,0x4010055};
+ uint64_t ids[6]={0};
+ if(EFI_ERROR(s)||!p||p->revision!=0x1000b||!p->get_id||!p->enable||!p->is_on)return;
+ for(unsigned i=0;i<6;i++) {
+  s=p->get_id(p,names[i],&ids[i]);
+  if(EFI_ERROR(s)||ids[i]!=expected[i]){print("op13-wifi-phy: unresolved clock %s\n",names[i]);return;}
+ }
+ for(unsigned i=0;i<sizeof(op13_wifi_phy_sequence)/sizeof(op13_wifi_phy_sequence[0]);i++) {
+  const struct op13_wifi_phy_entry *e=&op13_wifi_phy_sequence[i];
+  if(e->offset>=0x2000||(e->offset&3)||e->delay_us>10000)return;
+ }
+ if(!op13_wifi_phy_access(0x0f166000)||!op13_wifi_phy_access(0x0f166004))return;
+ /* No subsequent loader/kernel run may reuse retained controller state. */
+ op13_wifi_votes_stuck=1;
+ print("op13-wifi-phy: retaining all resources until cold reset; no endpoint/DMA activation\n");
+ print("op13-wifi-phy: PERST102 original config=%x data=%x\n",
+  (uint64_t)op13_wifi_phy_read(0x0f166000),(uint64_t)op13_wifi_phy_read(0x0f166004));
+ op13_wifi_phy_update(0x0f166004,2,0);
+ op13_wifi_phy_update(0x0f166000,0x3ff,0x200); /* GPIO, no pull,2mA,output low */
+ BS->stall(1000);
+ op13_wifi_phy_write(0x01d08040,0);op13_wifi_phy_write(0x01d08048,0);
+ for(unsigned i=0;i<sizeof(op13_wifi_sm_sequence)/sizeof(uint32_t);i++)
+  op13_wifi_phy_write(0x01d07000+4*i,op13_wifi_sm_sequence[i]);
+ for(unsigned i=0;i<sizeof(op13_wifi_sm_branches)/sizeof(uint32_t);i++)
+  op13_wifi_phy_write(0x01d08000+4*i,op13_wifi_sm_branches[i]);
+ op13_wifi_phy_update(0x01d08090,0,1);
+ if(op13_wifi_phy_fault)return;
+ print("op13-wifi-phy: PCIe state-manager sequence loaded\n");
+ struct op13_cesta_io io={0,op13_wifi_crm_read,op13_wifi_crm_write,op13_wifi_crm_delay};
+ uint32_t saved=0;int ret=op13_cesta_gen1_vote(&io,&saved);
+ print("op13-wifi-phy: Gen1 vote result=%x current-perf=%x\n",(uint64_t)(int64_t)ret,
+  (uint64_t)op13_wifi_crm_read(0,OP13_CRM_CURRENT_PERF));
+ if(ret)return;
+ struct op13_cesta_io hwio={0,op13_wifi_crm_read,op13_wifi_hw_write,op13_wifi_crm_delay};
+ print("op13-wifi-hw-map: before busy=%x update=%x power-index=%x\n",
+  (uint64_t)op13_wifi_crm_read(0,0x370),(uint64_t)op13_wifi_crm_read(0,0x374),(uint64_t)op13_wifi_crm_read(0,0x37c));
+ int hwret=op13_cesta_hw_gen1(&hwio);
+ print("op13-wifi-hw-map: result=%d busy=%x update=%x power-index=%x\n",(uint64_t)(int64_t)hwret,
+  (uint64_t)op13_wifi_crm_read(0,0x370),(uint64_t)op13_wifi_crm_read(0,0x374),(uint64_t)op13_wifi_crm_read(0,0x37c));
+ if(hwret)return;
+
+ for(unsigned i=0;i<3;i++) {
+  s=p->enable(p,ids[i]);print("op13-wifi-phy: enable %s status=%x\n",names[i],s);
+  if(EFI_ERROR(s))return;
+ }
+ /* DT reset IDs6/9 map to GCC offsets6b000/6c01c; pulse both in vendor order. */
+ op13_wifi_phy_update(0x0016b000,0,1);op13_wifi_phy_update(0x0016c01c,0,1);BS->stall(1000);
+ op13_wifi_phy_update(0x0016c01c,1,0);op13_wifi_phy_update(0x0016b000,1,0);BS->stall(1000);
+ if(op13_wifi_phy_fault)return;
+ for(unsigned i=4;i<6;i++) {
+  uint8_t on=0;s=p->is_on(p,ids[i],&on);
+  print("op13-wifi-phy: after reset %s status=%x on=%d\n",names[i],s,(uint64_t)on);
+  if(EFI_ERROR(s)||!on)return;
+ }
+ op13_wifi_phy_write(0x01c01000,4);op13_wifi_phy_update(0x01c00040,1,0);
+ op13_wifi_phy_write(0x01c00000,0x365e);op13_wifi_phy_update(0x01c00174,0,1u<<4);
+ for(unsigned i=0;i<sizeof(op13_wifi_phy_sequence)/sizeof(op13_wifi_phy_sequence[0]);i++) {
+  const struct op13_wifi_phy_entry *e=&op13_wifi_phy_sequence[i];
+  op13_wifi_phy_write(0x01c06000+e->offset,e->value);
+  if(op13_wifi_phy_fault)return;
+  if(e->delay_us)BS->stall(e->delay_us);
+ }
+ BS->stall(1000);
+ print("op13-wifi-phy:128 PHY configuration writes completed\n");
+ /* Vendor gcc-sun.c: PIPE mux at GCC+6b080 selects PHY with value0,
+  * TCXO with value2. The PHY must supply the actual PCIe PIPE clock. */
+ print("op13-wifi-phy: PIPE source before=%x\n",(uint64_t)op13_wifi_phy_read(0x0016b080));
+ op13_wifi_phy_update(0x0016b080,3,0);
+ print("op13-wifi-phy: PIPE source after=%x\n",(uint64_t)op13_wifi_phy_read(0x0016b080));
+ if(op13_wifi_phy_fault)return;
+ s=p->enable(p,ids[3]);print("op13-wifi-phy: PIPE enable status=%x\n",s);
+ if(EFI_ERROR(s))return;
+ uint32_t status=0xffffffffu;
+ for(unsigned i=0;i<1000;i++) {
+  status=op13_wifi_phy_read(0x01c06414);
+  if(op13_wifi_phy_fault)return;
+  if(!(status&(1u<<6))) {op13_wifi_phy_ready=1;break;}
+  BS->stall(100);
+ }
+ print("op13-wifi-phy: PHY ready=%d status=%x; endpoint remains in reset\n",(uint64_t)op13_wifi_phy_ready,(uint64_t)status);
+ for(unsigned i=0;i<4;i++) {
+  uint8_t on=0;s=p->is_on(p,ids[i],&on);
+  print("op13-wifi-phy: final %s status=%x on=%d\n",names[i],s,(uint64_t)on);
+ }
+}
diff --git a/xnuloader/op13_wifi_pmu.h b/xnuloader/op13_wifi_pmu.h
new file mode 100644
index 0000000..951612a
--- /dev/null
+++ b/xnuloader/op13_wifi_pmu.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Native CNSS OL-CPR wire format and Dodge DT mapping, independently encoded.
+ * Plan every rail before writes. Firmware input never selects arbitrary rails.
+ */
+#ifndef OP13_WIFI_PMU_H
+#define OP13_WIFI_PMU_H
+#include "op13_wifi_qmi.h"
+static const char *const op13_pmu_pins[]={
+ "VDDD_AON_0P9","VDDA_RFA_1P9","VDDA_RFA_1P3","VDDA_RFA_0P9",
+ "VDDD_WLMX_0P9","VDDD_WLCX_0P9","VDDD_BTCX_0P9","VDDD_BTCMX_0P9",
+ "VDDA_PCIE_1P2","VDDA_PCIE_0P9"
+};
+static const unsigned op13_pmu_rail[]={0,2,3,0,1,0,0,0,3,3};
+static const char *const op13_pmu_rails[]={"s5f","s4d","s3g","s7i"};
+/* Actual phone DT regulator limits, mV. Conservative for sleep as well. */
+static const unsigned op13_pmu_min[]={500,500,1856,1224};
+static const unsigned op13_pmu_max[]={1000,1036,2000,1340};
+struct op13_pmu {
+ unsigned count;
+ struct {unsigned pin,wake_valid,wake,sleep_valid,sleep;} item[16];
+};
+struct op13_pmu_plan {unsigned mv[4][2];};
+static int op13_pmu_decode(const uint8_t *v,size_t n,struct op13_pmu *out)
+{
+ struct op13_pmu p={0};unsigned seen=0;
+ if(!n||!v[0]||v[0]>16||n!=1+48u*v[0])return -1;
+ p.count=v[0];
+ for(unsigned i=0;i<p.count;i++){
+  const uint8_t *s=v+1+48*i;unsigned pin;
+  for(pin=0;pin<10;pin++){
+   unsigned j=0;while(j<32&&op13_pmu_pins[pin][j]&&s[j]==(uint8_t)op13_pmu_pins[pin][j])j++;
+   if(j<32&&!op13_pmu_pins[pin][j]&&!s[j])break;
+  }
+  if(pin==10||(seen&(1u<<pin)))return -1;seen|=1u<<pin;
+  p.item[i].pin=pin;p.item[i].wake_valid=op13_qrtr_u32(s+32);p.item[i].wake=op13_qrtr_u32(s+36);
+  p.item[i].sleep_valid=op13_qrtr_u32(s+40);p.item[i].sleep=op13_qrtr_u32(s+44);
+  if(p.item[i].wake_valid>1||p.item[i].sleep_valid>1)return -1;
+ }
+ *out=p;return 0;
+}
+static int op13_pmu_plan(const struct op13_pmu *p,struct op13_pmu_plan *out)
+{
+ struct op13_pmu_plan plan={0};
+ if(!p->count||p->count>16)return -1;
+ for(unsigned i=0;i<p->count;i++){
+  if(p->item[i].pin>=10||p->item[i].wake_valid>1||p->item[i].sleep_valid>1)return -1;
+  unsigned rail=op13_pmu_rail[p->item[i].pin];
+  for(unsigned sleep=0;sleep<2;sleep++){
+   if(!(sleep?p->item[i].sleep_valid:p->item[i].wake_valid))continue;
+   unsigned raw=sleep?p->item[i].sleep:p->item[i].wake;
+   if(raw<100||raw>2000)return -1;
+   /* Native roundup(voltage,4) -16 + (wake?30:10), then maximum per rail. */
+   unsigned mv=((raw+3)&~3u)-16+(sleep?10:30);
+   if(mv>plan.mv[rail][sleep])plan.mv[rail][sleep]=mv;
+  }
+ }
+ for(unsigned r=0;r<4;r++)for(unsigned s=0;s<2;s++)
+  if(plan.mv[r][s]&&(plan.mv[r][s]<op13_pmu_min[r]||plan.mv[r][s]>op13_pmu_max[r]))return -2;
+ *out=plan;return 0;
+}
+static int op13_pmu_message(char out[64],unsigned rail,unsigned sleep,unsigned mv)
+{
+ if(rail>=4||sleep>1||mv<op13_pmu_min[rail]||mv>op13_pmu_max[rail])return -1;
+ const char *parts[]={"{class: wlan_pdc, ss: ",rail==1?"bb":"rf",", res: ",op13_pmu_rails[rail],".v, ",sleep?"dwnval":"upval",": "};
+ unsigned at=0;for(unsigned i=0;i<7;i++)for(unsigned j=0;parts[i][j];j++){if(at>=55)return -1;out[at++]=parts[i][j];}
+ char digits[4];unsigned count=0;do{digits[count++]='0'+mv%10;mv/=10;}while(mv&&count<4);
+ while(count)out[at++]=digits[--count];out[at++]='}';out[at]=0;return 0;
+}
+#endif
diff --git a/xnuloader/op13_wifi_qmi.h b/xnuloader/op13_wifi_qmi.h
new file mode 100644
index 0000000..c9804cd
--- /dev/null
+++ b/xnuloader/op13_wifi_qmi.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Read-only WLFW capability query and bounded QMI TLV decoding.
+ * Message ID/layout checked against native CNSS wlan_firmware_service_v01.
+ */
+#ifndef OP13_WIFI_QMI_H
+#define OP13_WIFI_QMI_H
+#include "op13_wifi_qrtr.h"
+struct op13_qmi_cap {
+ uint32_t transaction,message,flags,result,error,chip,family,board,soc;
+ unsigned has_result,has_chip,has_board,has_soc;
+};
+static uint32_t op13_qmi_u16(const uint8_t *p)
+{return (uint32_t)p[0]|(uint32_t)p[1]<<8;}
+static int op13_qmi_cap_decode(const uint8_t *b,size_t n,struct op13_qmi_cap *out)
+{
+ struct op13_qmi_cap p={0};
+ if(n<7)return -1;
+ p.flags=b[0];p.transaction=op13_qmi_u16(b+1);p.message=op13_qmi_u16(b+3);
+ size_t length=op13_qmi_u16(b+5),at=7;
+ if(length!=n-7||p.flags!=2||p.message!=0x24)return -1;
+ while(at<n){
+  if(n-at<3)return -1;
+  unsigned type=b[at];size_t len=op13_qmi_u16(b+at+1);at+=3;
+  if(len>n-at)return -1;
+  if(type==2){if(len!=4||p.has_result)return -1;p.has_result=1;p.result=op13_qmi_u16(b+at);p.error=op13_qmi_u16(b+at+2);}
+  if(type==0x10){if(len!=8||p.has_chip)return -1;p.has_chip=1;p.chip=op13_qrtr_u32(b+at);p.family=op13_qrtr_u32(b+at+4);}
+  if(type==0x11){if(len!=4||p.has_board)return -1;p.has_board=1;p.board=op13_qrtr_u32(b+at);}
+  if(type==0x12){if(len!=4||p.has_soc)return -1;p.has_soc=1;p.soc=op13_qrtr_u32(b+at);}
+  at+=len;
+ }
+ if(!p.has_result)return -1;
+ *out=p;return 0;
+}
+static void op13_qmi_cap_request(uint8_t b[40],uint32_t node,uint32_t port)
+{
+ for(unsigned i=0;i<40;i++)b[i]=0;
+ op13_qrtr_put(b,1);op13_qrtr_put(b+4,1);op13_qrtr_put(b+8,1);op13_qrtr_put(b+12,0x4000);
+ op13_qrtr_put(b+20,7);op13_qrtr_put(b+24,node);op13_qrtr_put(b+28,port);
+ b[33]=1;b[35]=0x24;
+}
+#endif
