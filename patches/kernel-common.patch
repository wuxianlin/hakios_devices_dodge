+	w[0] = (40u << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = src_port;
+	w[3] = 1;
+	w[5] = opcode;
+	w[6] = 0;
+	w[7] = 0;
+	w[8] = handle;
+	w[9] = length;
+	lck_mtx_lock(&apr_lock);
