+			{ 0x07001000, REACH_IID_PLAY_SHMEM, 1, 1 },
+		};
+		static const struct reach_link inner_links[] = {
+			{ REACH_IID_PLAY_SHMEM, REACH_IID_PLAY_DEC },
+			{ REACH_IID_PLAY_DEC, REACH_IID_PLAY_CNV },
+		};
