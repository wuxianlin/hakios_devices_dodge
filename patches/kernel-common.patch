+static void
+send_slider(IOHIDServiceClientRef buttons, const struct hakios_touch *t)
+{
+	/* ios-dodge's alert slider: a telephony ringer-switch event is what iOS natively
+	 * understands (the middle position is the switch ON: silent), plus a notification
+	 * with the three-way position for whoever wants the third state (top: DND) */
+	static const char *const names[] = { "?", "down: ring", "in the middle: silent", "up: ring, Do Not Disturb" };
+	static int token = NOTIFY_TOKEN_INVALID;
+	IOHIDEventRef event;
+
+	if (t->finger < HAKIOS_SLIDER_DOWN || t->finger > HAKIOS_SLIDER_UP) {
+		return;
+	}
+	event = IOHIDEventCreateKeyboardEvent(NULL, t->time, HID_PAGE_TELEPHONY, HID_USAGE_RINGER_SWITCH,
+	    t->finger != HAKIOS_SLIDER_MIDDLE, 0);
+	if (event == NULL) {
+		return;
+	}
+	IOHIDEventSetIntegerValue(event, FIELD_IS_BUILT_IN, 1);
+	IOHIDVirtualServiceClientDispatchEvent(buttons, event);
+	CFRelease(event);
+	if (token == NOTIFY_TOKEN_INVALID && notify_register_check("com.hakios.slider", &token) != NOTIFY_STATUS_OK) {
+		token = NOTIFY_TOKEN_INVALID;
+	}
+	if (token != NOTIFY_TOKEN_INVALID) {
+		notify_set_state(token, t->finger);
+		notify_post("com.hakios.slider");
+	}
+	say("hakios: input: the alert slider is %s\n", names[t->finger]);
+}
