+	}
+
+	{
+		uint32_t step = 0;
+
+		PE_parse_boot_argn("sound_step", &step, sizeof(step));
+		if (step == 6) {
+			say("sound: STEP 6: the flow stops here, the first period WRITTEN, the amplifiers never touched\n");
