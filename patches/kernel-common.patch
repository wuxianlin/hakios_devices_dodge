diff --git a/userland/src/sleeper.c b/userland/src/sleeper.c
new file mode 100644
index 0000000..1f22787
--- /dev/null
+++ b/userland/src/sleeper.c
@@ -0,0 +1,28 @@
+/*
+ * /sbin/launchd of root-wifi: the Wi-Fi runs boot with no resident image (the
+ * big system image's upload is what the dying runs all had in common), so
+ * nothing hands process 1 to anything -- this program IS the boot's whole
+ * userspace.  Those runs' work is all in the kernel (the pcie thread's
+ * ladder); process 1 only has to exist and not exit: without it the kernel
+ * panics at kern_exec.c:7154 about half a minute in, which froze the ladder
+ * right at [T3] -- after the markers, before the doorbell -- every time.
+ */
+#include "mini.h"
+
+int
+main(int argc, char **argv, char **envp)
+{
+	int fd = open("/dev/console", O_RDWR, 0);
+
+	(void)argc, (void)argv, (void)envp;
+	dup2(fd, 0);
+	dup2(fd, 1);
+	dup2(fd, 2);
+	if (fd > 2) {
+		close(fd);
+	}
+	printf("sleeper: process 1 standing in for launchd; the kernel has the run\n");
+	for (;;) {
+		usleep(1000000);
+	}
+}
