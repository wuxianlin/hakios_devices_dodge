diff --git a/userland/src/inject_fpvolume.c b/userland/src/inject_fpvolume.c
new file mode 100644
index 0000000..4cf2901
--- /dev/null
+++ b/userland/src/inject_fpvolume.c
@@ -0,0 +1,105 @@
+/*
+ * libhakios.fpvolume.dylib, inserted into fileproviderd (etc/inject.conf): /private/var accepted as a
+ * volume for FileProvider's domains -- the LocalStorage domain is the "On My iPhone" of the Files
+ * application, and the place a download is given.
+ *
+ * fileproviderd keeps every domain on a volume it has accepted, and it accepts one only in
+ * -[FPDVolume initWithVolumeInfo:knownRole:volumeManager:] -- its "volumeInfo" is a const struct
+ * statfs * (type encoding r^{statfs=...}) --, which asks FPVolumeFPFSSupported
+ * (FileProvider.framework): read-write, local, not quarantined, and f_fstypename "apfs". The home
+ * volume is the one under /private/var/mobile. Here that is the memory filesystem this kernel puts
+ * on /private/var (it brings up no storage), so it is refused. -[FPDServer _setup] then goes on
+ * with no volume: fileproviderctl dump lists providers and no domain, Files has no "On My
+ * iPhone", and a download has nowhere to go.
+ *
+ * FileProviderDaemon reaches FPVolumeFPFSSupported and statfs_ext through the shared cache's direct
+ * branches, so neither can be interposed. The method that asks is replaced instead, and for
+ * /private/var it gets a copy of the statfs whose type reads "apfs"; the other three conditions are
+ * still checked on the real flags. LocalStorage is not an FPFS provider (-[FPDProvider _supportsFPFS]
+ * is NO for it), so its domain needs nothing else of APFS -- only what its extension asks of the
+ * volume's filesystem through fsctl(2) and fcntl(2), which the memory filesystem answers
+ * (xnu/files/bsd/miscfs/ramfs/ramfs.c).
+ *
+ * (The same fix the REDMI K90 port carries as libredwood-fpvolume.dylib, its inject_fpvolume.c.)
+ */
+#include <dlfcn.h>
+#include <objc/runtime.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mount.h>
+
+typedef id (*init_with_statfs_t)(id, SEL, struct statfs *, unsigned, id);
+
+static init_with_statfs_t original;
+
+static id
+init_with_statfs(id self, SEL cmd, struct statfs *fs, unsigned role, id manager)
+{
+	struct statfs copy;
+
+	if (fs == NULL || (strcmp(fs->f_fstypename, "hfs") != 0 && strcmp(fs->f_fstypename, "ramfs") != 0) ||
+	    strcmp(fs->f_mntonname, "/private/var") != 0) {
+		return original(self, cmd, fs, role, manager);
+	}
+	copy = *fs;
+	strlcpy(copy.f_fstypename, "apfs", sizeof(copy.f_fstypename));
+	fprintf(stderr, "hakios-fpvolume: /private/var (%s) offered to FPDVolume as apfs, role %u\n", fs->f_fstypename, role);
+	return original(self, cmd, &copy, role, manager);
+}
+
+/* the class may not be in the process yet when this library is loaded (measured: an inserted
+ * library's constructor runs before the daemon has loaded FileProvider), so ask, load FileProvider,
+ * and if it is still not there, ask again from a thread of our own until it is */
+static int
+install_once(void)
+{
+	Class volume = objc_getClass("FPDVolume");
+	Method method;
+
+	if (volume == Nil) {
+		void *h = dlopen("/System/Library/PrivateFrameworks/FileProvider.framework/FileProvider", RTLD_NOW);
+
+		if (h == NULL) {
+			h = dlopen("/System/Library/Frameworks/FileProvider.framework/FileProvider", RTLD_NOW);
+		}
+		if (h == NULL) {
+			h = dlopen("/System/Library/PrivateFrameworks/FileProviderDaemon.framework/FileProviderDaemon", RTLD_NOW);
+		}
+		volume = objc_getClass("FPDVolume");
+	}
+	method = volume != Nil ? class_getInstanceMethod(volume, sel_registerName("initWithVolumeInfo:knownRole:volumeManager:")) : NULL;
+	if (method == NULL) {
+		return 0;
+	}
+	original = (init_with_statfs_t)method_setImplementation(method, (IMP)init_with_statfs);
+	fprintf(stderr, "hakios-fpvolume: -[FPDVolume initWithVolumeInfo:knownRole:volumeManager:] replaced\n");
+	return 1;
+}
+
+static void *
+wait_and_install(__unused void *argument)
+{
+	for (int i = 0; i < 600; i++) {          /* 30 s: the daemon's setup begins at once after this */
+		if (install_once()) {
+			return NULL;
+		}
+		usleep(50 * 1000);
+	}
+	fprintf(stderr, "hakios-fpvolume: FPDVolume never appeared, nothing replaced\n");
+	return NULL;
+}
+
+__attribute__((constructor)) static void
+fpvolume_start(void)
+{
+	pthread_t thread;
+
+	if (install_once()) {
+		return;
+	}
+	if (pthread_create(&thread, NULL, wait_and_install, NULL) != 0) {
+		fprintf(stderr, "hakios-fpvolume: no thread to wait for FPDVolume with\n");
+	}
+}
diff --git a/userland/src/inject_sb.c b/userland/src/inject_sb.c
