+			}
+			bzero(packet, sizeof(packet));
+			total = 24 + 16 + bounds[i];
+			packet[0] = (total << 8) | (6u << 4);
+			packet[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+			packet[2] = 0x2012;                     /* the device graph's client port */
+			packet[3] = 1;
+			packet[4] = token = apr_next_token++;
+			packet[5] = APM_CMD_GRAPH_OPEN;
+			packet[8] = 0;                          /* in band */
+			packet[9] = bounds[i];
+			memcpy(pk + 40, graph, bounds[i]);
+			lck_mtx_lock(&apr_lock);
+			apr_answer.there = false;
+			apr_waited_for = token;
+			if (apr_channel_send(packet, total) == 0) {
+				apr_out++;
+				for (uint32_t t = 0; t < 2500 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+					sleep_ms(20);
+				}
+				answered = os_atomic_load(&apr_answer.there, acquire);
+			}
+			lck_mtx_unlock(&apr_lock);
+			printf("adsp: the prefix of %u blocks (%u bytes): %s the status %u\n",
+			    i + 1, bounds[i], answered ? "answered;" : "no answer;", apr_answer.words[1]);
+			sleep_ms(200);
+		}
+
