+	}
+	if (apm_graph_table[variant].sg_count == 2) {
+		w[at++] = module_base[0] + apm_graph_table[0].sg[0].count - 1; w[at++] = 1; w[at++] = module_base[1]; w[at++] = 1;
+		conns++;
+	}
+	if ((at - began) & 1) {
+		w[at++] = 0;
+	}
+	w[size_at] = conns;
+	w[began + 3] = (at - began) * 4 - 16;
+
+	w[block] = (at - block - 1) * 4;
+	total = at * 4;
+	w[0] = (total << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = apm_graph_table[variant].port;
+	w[3] = APM_MODULE_INSTANCE_ID;
+	w[5] = APM_CMD_GRAPH_OPEN;
+	return total;
+}
+
+/* the speaker use case, composed of the phone's own ACDB graphs, in three variants (hakios.apm.graph.c) */
+extern const uint8_t *const hakios_apm_speaker_graphs[4];
+extern const uint8_t hakios_apm_speaker_graph2b[2144];
+extern const uint8_t hakios_apm_speaker_graph2c[2288];
+extern const uint8_t hakios_apm_graph_bisB[2256];
+extern const uint8_t hakios_apm_graph_bisC[2224];
+extern const uint8_t hakios_apm_graph_bisD[328];
+extern const char *const hakios_apm_speaker_graph_names[4];
+extern const uint32_t hakios_apm_speaker_graph_ports[4];
+extern void flush_dcache64(addr64_t addr, unsigned count, int phys);
+
+/* adsp_apm_graph=1: graphs opened in the APM -- each row of the table above, sent as the packet
+ * itself carries the payload; then, if none is taken, the payload in shared memory the way the
+ * phone's own HAL sends it. A status word of zero is acceptance.
+ */
+/* The AMDB registration: the prerequisite every graph open has been refused for.  The phone's
+ * audio HAL composes 156 bytes (amdb_module_registration_t: the domain, the count, then each
+ * module's interface 2/version 3, its type, id, and the .so name with its tag) at boot, maps
+ * its ION pool with APM_CMD_SHARED_MEM_MAP, and sends AMDB_CMD_REGISTER_MODULES carrying
+ * (0, 0, the pool handle, 156).  Our chain reboots WARM from Android: the pool at PA
+ * 0x11fff0000 (the address the HAL's own map request named, read off the phone) keeps its
+ * bytes -- recover the blob from the Android session's RAM, copy it into this kernel's own
+ * DSP-shared window at the far end, map THAT, register, and read the basic result. */
+#define AMDB_CMD_REGISTER_MODULES       0x0100101E
+#define GPR_IBASIC_RSP_RESULT           0x02001005
+
+/* APM_CMD_CLOSE_ALL: the phone's own first ask after SPF is ready -- a header alone, to the
+ * APM's control port 3.  What exactly it clears is the APM's own business; the HAL does it. */
+static void
+apm_close_all(void)
+{
+	uint32_t w[8], token;
+
+	bzero(w, sizeof(w));
+	w[0] = (24u << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = 0x0003;
+	w[3] = 1;
+	w[4] = token = apr_next_token++;
+	w[5] = 0x01001013;                              /* APM_CMD_CLOSE_ALL */
+	lck_mtx_lock(&apr_lock);
+	apr_answer.there = false;
+	apr_waited_for = token;
+	if (apr_channel_send(w, 24) == 0) {
+		apr_out++;
+		for (uint32_t t = 0; t < 1000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+			sleep_ms(20);
+		}
+		printf("adsp: CLOSE_ALL: %s (the status %u)\n",
+		    os_atomic_load(&apr_answer.there, acquire) ? "answered" : "no answer in a second",
+		    apr_answer.words[1]);
+	}
+	lck_mtx_unlock(&apr_lock);
+}
+
+/* The hardware resource asks the phone's own HAL makes before ANY graph: PRM_CMD_REQUEST_HW_RSC
+ * to the Proxy Resource Manager (port 7, instance 2), payloads byte-faithful from the capture.
+ * Without them the graphs' codec-dma resources are not granted and every open fails. */
+static void
+apm_prm_requests(void)
+{
+	static const struct {
+		uint32_t dlen;
+		uint32_t payload[9];
+	} asks[] = {
+		{ 60, { 0x00000000, 0x00000000, 0x00000000, 0x00000014, 0x00000002, 0x08001A6E, 0x00000004, 0x00000000, 0x00000001 } },
+		{ 60, { 0x00000000, 0x00000000, 0x00000000, 0x00000014, 0x00000002, 0x08001032, 0x00000004, 0x00000000, 0x00000002 } },
+	};
+
+	for (unsigned r = 0; r < sizeof(asks) / sizeof(asks[0]); r++) {
+		uint32_t w[15], token;
+
+		bzero(w, sizeof(w));
+		w[0] = (asks[r].dlen << 8) | (6u << 4);
+		w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		w[2] = 0x0007;                                  /* the PRM service */
+		w[3] = 2;                                       /* instance 2, as the HAL */
+		w[4] = token = apr_next_token++;
+		w[5] = 0x0100100F;                              /* PRM_CMD_REQUEST_HW_RSC */
+		memcpy(&w[6], asks[r].payload, sizeof(asks[r].payload));
+		lck_mtx_lock(&apr_lock);
+		apr_answer.there = false;
+		apr_waited_for = token;
+		if (apr_channel_send(w, asks[r].dlen) == 0) {
+			apr_out++;
+			for (uint32_t t = 0; t < 2000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+				sleep_ms(20);
+			}
+			printf("adsp: the resource %#x ask: %s\n", asks[r].payload[5],
+			    os_atomic_load(&apr_answer.there, acquire) ? "ANSWERED" : "no answer in two seconds");
+		}
+		lck_mtx_unlock(&apr_lock);
+		sleep_ms(100);
+	}
+}
+
+/* One page of our DSP-shared window mapped with APM_CMD_SHARED_MEM_REGIONS once: the graphs'
+ * out-of-band payloads and the AMDB blob both ride it (the phone's own HAL sends every graph
+ * this way -- payload in the pool, the packet carrying only (0, 0, handle, size); inline
+ * payloads, which mainline Linux sends, are answered with AR_EFAILED by this build). */
+static struct {
+	uint64_t pa;
+	uint32_t handle;
+} graph_pool[8];
+static unsigned graph_pool_n;
+
+static uint32_t
+apm_shmem_map(uint64_t pa, uint32_t size)
+{
+	uint32_t w[16], token;
+
+	for (unsigned i = 0; i < graph_pool_n; i++) {
+		if (graph_pool[i].pa == pa) {
+			return graph_pool[i].handle;
+		}
+	}
+	bzero(w, sizeof(w));
+	w[0] = (44u << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = 0x2002;                                    /* the APM service's port */
+	w[3] = 1;
+	w[4] = token = apr_next_token++;
+	w[5] = APM_CMD_SHARED_MEM_MAP;
+	w[6] = (1u << 16) | 3u;                           /* one region, pool 3 */
+	w[7] = 4;                                         /* offset mode, as the phone's own asks */
+	w[8] = (uint32_t)pa;
+	w[9] = (uint32_t)(pa >> 32);
+	w[10] = size;
+	lck_mtx_lock(&apr_lock);
+	apr_answer.there = false;
+	apr_waited_for = token;
+	if (apr_channel_send(w, 44) == 0) {
+		apr_out++;
+		for (uint32_t t = 0; t < 2000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+			sleep_ms(20);
+		}
+		if (os_atomic_load(&apr_answer.there, acquire) &&
+		    apr_answer.opcode == APM_CMD_RSP_SHARED_MEM_MAP && apr_answer.length >= 4 && graph_pool_n < 8) {
+			graph_pool[graph_pool_n].pa = pa;
+			graph_pool[graph_pool_n].handle = apr_answer.words[0];
+			graph_pool_n++;
+		}
+	}
+	lck_mtx_unlock(&apr_lock);
+	printf("adsp: the pool page %#llx mapped: handle %#x\n", pa,
+	    graph_pool_n ? graph_pool[graph_pool_n - 1].handle : 0);
+	return graph_pool_n ? graph_pool[graph_pool_n - 1].handle : 0;
+}
+
+static void
+apm_amdb_register(void)
+{
+	/* The registration data, VERBATIM: the phone's blob is exactly these 156 bytes -- the
+	 * MODM chunk of its ODM ACDB (/odm/etc/acdbdata/acdb_cal.acdb at 0x38468e; the chunk
+	 * the GSL's ACDB_CMD_GET_AMDB_REGISTRATION_DATA_V2 reads, gsl_dynamic_module_mgr.c
+	 * builds the send from it).  Three modules for ADSP: nlc_bgth_v1_5.so ("nlc"),
+	 * capi_v3_oprec.so ("capi_v3_oprec"), libktveffect.so -- interface 2, CAPI v3, type 2. */
+	static const uint8_t reg_blob[156] = {
+	0x02, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00,
+	0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x03, 0x00,
+	0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x11,
+	0x10, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x6e, 0x6c, 0x63, 0x5f, 0x62, 0x67, 0x74, 0x68,
+	0x5f, 0x76, 0x31, 0x5f, 0x35, 0x2e, 0x73, 0x6f,
+	0x6e, 0x6c, 0x63, 0x00, 0x02, 0x00, 0x03, 0x00,
+	0x02, 0x00, 0x00, 0x00, 0x0b, 0x0b, 0x02, 0x10,
+	0x10, 0x00, 0x0d, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x63, 0x61, 0x70, 0x69, 0x5f, 0x76, 0x33, 0x5f,
+	0x6f, 0x70, 0x72, 0x65, 0x63, 0x2e, 0x73, 0x6f,
+	0x63, 0x61, 0x70, 0x69, 0x5f, 0x76, 0x33, 0x5f,
+	0x6f, 0x70, 0x72, 0x65, 0x63, 0x00, 0x00, 0x00,
+	0x02, 0x00, 0x03, 0x00, 0x02, 0x00, 0x00, 0x00,
+	0xf0, 0xb9, 0x00, 0x17, 0x0f, 0x00, 0x0e, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x6c, 0x69, 0x62, 0x6b,
+	0x74, 0x76, 0x65, 0x66, 0x66, 0x65, 0x63, 0x74,
+	0x2e, 0x73, 0x6f, 0x63, 0x61, 0x70, 0x69, 0x5f,
+	0x6b, 0x74, 0x76, 0x65, 0x66, 0x66, 0x65, 0x63,
+	0x74, 0x00, 0x00, 0x00,
+	};
+	uint32_t w[16], token, handle = 0;
+	uint64_t stage_pa = smem_phys + 0x1ff000;
+	volatile uint32_t *stage = (volatile uint32_t *)ml_io_map(stage_pa, 0x1000);
+
+	if (stage == NULL) {
+		printf("adsp: the staging page is not mapped\n");
+		return;
+	}
+	for (uint32_t i = 0; i < 156 / 4; i++) {
+		stage[i] = ((const uint32_t *)reg_blob)[i];
+	}
+	printf("adsp: the AMDB blob staged: 156 bytes, 3 modules (nlc_bgth_v1_5, capi_v3_oprec, libktveffect)\n");
+
+	handle = apm_shmem_map(stage_pa, 0x1000);
+	if (handle == 0) {
+		printf("adsp: no handle: the registration is not sent\n");
+		return;
+	}
+
+	/* the registration itself: (0, 0, the handle, 156) to the AMDB service, port 0x2005,
+	 * instance 3 -- exactly the packet the phone's own HAL was caught sending */
+	bzero(w, sizeof(w));
+	w[0] = (40u << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = 0x2005;
+	w[3] = 3;
+	w[4] = token = apr_next_token++;
+	w[5] = AMDB_CMD_REGISTER_MODULES;
+	/* the payload descriptor the way the mapped pool wants it: the address is the handle's
+	 * own (the high word carries it, the low the offset within the pool) -- zeros were
+	 * answered with "bad parameter" */
+	w[6] = 0;
+	w[7] = handle;
+	w[8] = handle;
+	w[9] = 156;
+	lck_mtx_lock(&apr_lock);
+	apr_answer.there = false;
+	apr_waited_for = token;
+	if (apr_channel_send(w, 40) == 0) {
+		apr_out++;
+		for (uint32_t t = 0; t < 3000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+			sleep_ms(20);
+		}
+		if (os_atomic_load(&apr_answer.there, acquire)) {
+			printf("adsp: THE REGISTRATION ANSWERED: opcode %#x: the echoed command %#x, the status %u (%s)\n",
+			    apr_answer.opcode, apr_answer.words[0], apr_answer.words[1],
+			    apr_answer.words[1] == 0 ? "ACCEPTED" : "refused");
+		} else {
+			printf("adsp: the registration: no answer in three seconds\n");
+		}
+	}
+	lck_mtx_unlock(&apr_lock);
+
+	/* and the registration IN BAND: the same DSP handler takes a zero handle as "the payload
+	 * follows the command header in the packet itself" (spf_svc_get_cmd_payload_addr's first
+	 * branch) -- no pool, no mapping, the 156 bytes ride the packet */
+	{
+		uint32_t inb[50];
+
+		bzero(inb, sizeof(inb));
+		inb[0] = ((24u + 16u + 156u) << 8) | (6u << 4);
+		inb[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		inb[2] = 0x2005;
+		inb[3] = 3;
+		inb[4] = token = apr_next_token++;
+		inb[5] = AMDB_CMD_REGISTER_MODULES;
+		inb[6] = 0;                          /* payload address lsw */
+		inb[7] = 0;                          /* payload address msw */
+		inb[8] = 0;                          /* handle ZERO: in band */
+		inb[9] = 156;
+		memcpy(&inb[10], reg_blob, 156);
+		lck_mtx_lock(&apr_lock);
+		apr_answer.there = false;
+		apr_waited_for = token;
+		if (apr_channel_send(inb, 24 + 16 + 156) == 0) {
+			apr_out++;
+			for (uint32_t t = 0; t < 3000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+				sleep_ms(20);
+			}
+			if (os_atomic_load(&apr_answer.there, acquire)) {
+				printf("adsp: THE IN-BAND REGISTRATION: opcode %#x: the echoed command %#x, the status %u (%s)\n",
+				    apr_answer.opcode, apr_answer.words[0], apr_answer.words[1],
+				    apr_answer.words[1] == 0 ? "ACCEPTED" : "refused");
+			} else {
+				printf("adsp: the in-band registration: no answer in three seconds\n");
+			}
+		}
+		lck_mtx_unlock(&apr_lock);
+	}
+
+	/* THE REAL VENDOR REGISTRATION, derived from the ADSP image's own loadable-module
+	 * manifest (adsp.b39 @0x565318+): the phone's graph has two DYNAMIC modules our
+	 * graphs could never instantiate -- 0x070010E2 "capi_spv5" in spv5_module.so.1 (the
+	 * speaker-protection v5 endpoint) and 0x0700105B "capi_cfcm" in CFCM.so.1.  The
+	 * image's manifest is the {module_id, 1, lib_ptr, tag_ptr, qos} table; the AMDB
+	 * must see module_id -> file/tag before it will dlopen them at graph open.  Entries
+	 * are PACKED: 4 (iface) + 20 (capi header) + file + tag, advanced exactly. */
+	{
+		static const struct {
+			uint32_t type;
+			uint32_t id;
+			const char *file;
+			const char *tag;
+		} mods[2] = {
+			{ 10 /* AMDB_MODULE_TYPE_PP */, 0x070010E2, "spv5_module.so.1", "capi_spv5" },
+			{ 10 /* AMDB_MODULE_TYPE_PP */, 0x0700105B, "CFCM.so.1",        "capi_cfcm" },
+		};
+		uint8_t ext[12 + 64 + 48];
+		uint32_t at = 12;
+
+		ext[0] = 2; ext[1] = 0; ext[2] = 0; ext[3] = 0;        /* proc_domain ADSP */
+		ext[4] = 2; ext[5] = 0; ext[6] = 0; ext[7] = 0;        /* num_modules */
+		ext[8] = 1; ext[9] = 0; ext[10] = 0; ext[11] = 0;      /* struct_version */
+		for (unsigned i = 0; i < 2; i++) {
+			uint16_t head16[2] = { 2, 3 };                     /* CAPI interface, version 3 */
+			uint16_t lens[2] = { (uint16_t)strlen(mods[i].file), (uint16_t)strlen(mods[i].tag) };
+			uint32_t err = 0;
+
+			memcpy(ext + at, head16, 4);
+			memcpy(ext + at + 4, &mods[i].type, 4);
+			memcpy(ext + at + 8, &mods[i].id, 4);
+			memcpy(ext + at + 12, lens, 4);
+			memcpy(ext + at + 16, &err, 4);
+			memcpy(ext + at + 20, mods[i].file, lens[0]);
+			memcpy(ext + at + 20 + lens[0], mods[i].tag, lens[1]);
+			at += 4 + 20 + lens[0] + lens[1];                  /* packed: the walker's math */
+		}
+		{
+			uint32_t inb[96];                   /* 24+16+236 bytes = 69 words: 64 was one short and
+			                                     * overflowed into the next stack frame */
+			bzero(inb, sizeof(inb));
+			inb[0] = ((24u + 16u + at) << 8) | (6u << 4);
+			inb[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+			inb[2] = 0x2005;
+			inb[3] = 3;
+			inb[4] = token = apr_next_token++;
+			inb[5] = AMDB_CMD_REGISTER_MODULES;
+			inb[8] = 0;                                       /* in band */
+			inb[9] = at;
+			memcpy(&inb[10], ext, at);
+			lck_mtx_lock(&apr_lock);
+			apr_answer.there = false;
+			apr_waited_for = token;
+			if (apr_channel_send(inb, 24 + 16 + at) == 0) {
+				apr_out++;
+				for (uint32_t t = 0; t < 3000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+					sleep_ms(20);
+				}
+				if (os_atomic_load(&apr_answer.there, acquire)) {
+					printf("adsp: THE VENDOR REGISTRATION: the status %u -- 0 means all eight took,\n"
+					    "adsp:   31 (AR_EALREADY) means built into the image, other values name the trouble\n",
+					    apr_answer.words[1]);
+				} else {
+					printf("adsp: the vendor registration: no answer\n");
+				}
+			}
+			lck_mtx_unlock(&apr_lock);
+		}
+	}
+}
+
+static void
+apm_graph_open_probe(void)
+{
+	/* Each variant's modules: {module id, in ports, out ports}. The first is the production
+	 * stream sub-graph of the reference topologies (linux-msm/audioreach-topology): the
+	 * shared-memory WRITE endpoint -- the apps side writes, the DSP reads -- then the PCM
+	 * decoder, the PCM converter, and the logger; the chain joined port 1 to port 1. The
+	 * sub-graph asks for low latency (perf 2) in the RX direction (2) as a playback (scenario
+	 * 1); the container is a codec-dma class one (cap 2 -- the other candidates are tried
+	 * beside it: the "GC" type of the newer stacks 0x0B001001, and the plain post-processing
+	 * class 1) at the stream position (1) with 8 KiB of stack on the audio DSP (domain 2).
+	 */
+	static const struct {
+		uint32_t sg, cont, perf, direction, scenario, cap, pos, stack, domain, port;
+		struct {
+			uint32_t id, in_ports, out_ports;
+		} modules[6];
+		uint32_t count;
+		const char *what;
+	} table[] = {
+		{ 0x4001, 0x5001, 2, 2, 1, 2, 1, 8192, 2, 0x2010,
+		    { { 0x07001000, 0, 1 }, { 0x07001005, 1, 1 }, { 0x07001003, 1, 1 }, { 0x0700101A, 1, 1 } }, 4,
+		    "the production stream sub-graph, from a graph client's port (0x2010)" },
+		{ 0x4101, 0x5101, 2, 2, 1, 2, 1, 8192, 2, 0x2003,
+		    { { 0x07001000, 0, 1 }, { 0x07001005, 1, 1 }, { 0x07001003, 1, 1 }, { 0x0700101A, 1, 1 } }, 4,
+		    "the same, from GSL's main port (0x2003)" },
+		{ 0x4201, 0x5201, 2, 2, 1, 2, 1, 8192, 2, 0x17,
+		    { { 0x07001000, 0, 1 }, { 0x07001005, 1, 1 }, { 0x07001003, 1, 1 }, { 0x0700101A, 1, 1 } }, 4,
+		    "the same, from the audio packet service's port (0x17)" },
+		{ 0x4301, 0x5301, 2, 2, 1, 0x0B001001, 1, 8192, 2, 0x2011,
+		    { { 0x07001000, 0, 1 }, { 0x07001005, 1, 1 }, { 0x07001003, 1, 1 }, { 0x0700101A, 1, 1 } }, 4,
+		    "the same, in a GC container, from another graph port (0x2011)" },
+	};
+	uint32_t buffer[224];
+
+	for (uint32_t variant = 0; variant < sizeof(apm_graph_table) / sizeof(apm_graph_table[0]); variant++) {
+		uint32_t total, token;
+		int error;
+
+		bzero(buffer, sizeof(buffer));
+		total = apm_graph_build(variant, buffer);
+		printf("adsp: the graph, variant %u (%s): %u bytes\n", variant, apm_graph_table[variant].what, total);
+		lck_mtx_lock(&apr_lock);
+		token = apr_next_token++;
+		buffer[4] = token;
+		apr_answer.there = false;
+		apr_waited_for = token;
+		error = apr_channel_send(buffer, total);
+		if (error != 0) {
+			printf("adsp: the graph, variant %u: NOT SENT (%d)\n", variant, error);
+		} else {
+			apr_out++;
+			for (uint32_t waited = 0; waited < 3000; waited += 20) {
+				if (os_atomic_load(&apr_answer.there, acquire)) {
+					printf("adsp: THE GRAPH (variant %u) IS ANSWERED: opcode %#x, %u bytes: the echoed command %#x,"
