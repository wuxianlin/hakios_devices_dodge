 		}
+		/* the resident image (md0) is several APFS containers back to back (the boot
+		 * volume, the small image the payload would else carry, the cryptexes), and
+		 * the first container alone is the boot volume, which has no fw/.  A run
+		 * without a ramdisk of its own (XL_RAMDISK=none) still needs the small
+		 * image's fw/, so every later container is tried too: each starts with an
+		 * NXSB superblock of its own, and the ones in between are gigabytes apart,
+		 * so the scan is a walk of superblocks a megabyte or more from each other */
+		if (disk == 0) {
+			static bool scanned_empty;       /* once per boot when there is nothing there: the image does not move */
+
+			if (!scanned_empty) {
+				bool found = false;
+
+				for (uint64_t off = 0x100000; off + 4096 <= length; off += 4096) {
+					if (memcmp((void *)(base + off), "NXSB", 4) != 0) {
+						continue;
+					}
+					data = apfs_file(disk, (const uint8_t *)base + off, length - off, dir, name, size);
