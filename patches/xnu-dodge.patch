+/*
+ * The phone's speaker use case, composed of its own ACDB graphs and sent the way its own audio
+ * sends a graph: the payload not in the packet but in memory APM maps once, every variant of the
+ * ask written into the same page.
+ */
+static void
+apm_graph_composed_probe(void)
+{
+	/* the four graphs sent INLINE, whole: a gpr header, the APM command header with no mapping
+	 * (the payload rides the packet), and the payload itself */
+	for (uint32_t variant = 0; variant < 4; variant++) {
+		const uint8_t *graph = hakios_apm_speaker_graphs[variant];
+		uint32_t length = (uint32_t)(sizeof(uint32_t) * 6 + 16);   /* set per variant below */
+		uint8_t packet[3100];
+		uint32_t *w = (uint32_t *)packet, total, token;
+		int error;
+		bool answered = false;
+
+		total = 40 + (uint32_t)strlen("") + 0;                     /* placeholder, fixed below */
+		/* compute the payload length from the externed arrays via a helper: lengths are baked
+		 * per variant at build time by the emitter; store them here */
+		static const uint32_t lengths[4] = { 472, 640, 2416, 2824 };
+		total = 40 + lengths[variant];
+		bzero(packet, sizeof(packet));
+		w[0] = (total << 8) | (6u << 4);
+		w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		w[2] = hakios_apm_speaker_graph_ports[variant];
+		w[3] = APM_MODULE_INSTANCE_ID;
+		w[5] = APM_CMD_GRAPH_OPEN;
+		w[6] = 0;                                                 /* payload in the packet: no address */
+		w[7] = 0;
+		w[8] = 0;                                                 /* no mapping */
+		w[9] = lengths[variant];
+		memcpy(packet + 40, graph, lengths[variant]);            /* the blob's first word is the first
+		                                                         * block's module_instance_id (1 = the
+		                                                         * APM itself), NOT a version: skipping it
+		                                                         * broke every block after */
+		printf("adsp: the graph (%s): %u bytes inline, from port %#x\n",
+		    hakios_apm_speaker_graph_names[variant], total, hakios_apm_speaker_graph_ports[variant]);
+		lck_mtx_lock(&apr_lock);
+		token = apr_next_token++;
+		w[4] = token;
+		apr_answer.there = false;
+		apr_waited_for = token;
+		error = apr_channel_send(packet, total);
+		if (error != 0) {
+			printf("adsp: the graph (%s): NOT SENT (%d)\n", hakios_apm_speaker_graph_names[variant], error);
+		} else {
+			apr_out++;
+			for (uint32_t waited = 0; waited < 4000 && !answered; waited += 20) {
+				if (os_atomic_load(&apr_answer.there, acquire)) {
+					answered = true;
+					{
+						char l[180];
+						snprintf(l, sizeof(l), "adsp: THE GRAPH (%s) IS ANSWERED: the status %u -- %s\n", hakios_apm_speaker_graph_names[variant], apr_answer.words[1], apr_answer.words[1] == 0 ? "ACCEPTED" : "refused");
+						say_line(l, true);
+					}
+				}
+				sleep_ms(20);
+			}
+			if (!answered) {
+				{
+					char l[160];
+					snprintf(l, sizeof(l), "adsp: the graph (%s): no answer in four seconds\n", hakios_apm_speaker_graph_names[variant]);
+					say_line(l, true);
+				}
+			}
+		}
+		lck_mtx_unlock(&apr_lock);
+		sleep_ms(300);
+	}
+
+	/* the discriminator: a graph open with GARBAGE in the payload.  A parser that is
+	 * reached answers AR_EBADPARAM (2); the same EFAILED (1) as the real graphs would mean
+	 * the command dies before any payload is looked at */
