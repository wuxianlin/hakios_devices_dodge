+bool
+hakios_adsp_oob_send(uint32_t src_port, uint32_t opcode, const void *payload, uint32_t length, uint32_t ms,
+    struct hakios_apr_answer *answer)
+{
+	/* IN-BAND, exactly as K90's own working graphs go: the payload (the sound driver's
+	 * rb, whose FIRST SIXTEEN BYTES ARE the apm_cmd_header with mem_map_handle zero)
+	 * rides the packet itself, right after the six-word GPR header. The out-of-band
+	 * staging this form used to do was refused not at the fetch -- the offset-mode
+	 * lookup is sound (it never crashed the DSP) -- but at the parse: the staged copy
+	 * carried the rb's own sixteen-byte header in front of the graph, so the APM read
+	 * sixteen zero bytes as the graph's first parameter and failed (status 1, every
+	 * time). In-band the header the APM reads IS the rb's, and the graph follows it. */
+	static uint32_t pkt[6 + 256];
+	uint32_t token;
+	bool answered = false;
+
+	if (length == 0 || length > 1024) {
+		return false;
+	}
+	lck_mtx_lock(&apr_lock);
+	bzero(pkt, 24);
+	pkt[0] = ((24u + length) << 8) | (6u << 4);
+	pkt[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	pkt[2] = src_port;
+	pkt[3] = hakios_adsp_oob_dstport;
+	pkt[5] = opcode;
+	memcpy(&pkt[6], payload, length);
+	token = apr_next_token++;
+	pkt[4] = token;
+	apr_answer.there = false;
+	apr_waited_for = token;
