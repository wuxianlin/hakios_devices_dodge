+/* The tone's staging page (the out-of-band graphs' own, 0x1fe000 in the shared
+ * memory) and ITS map handle: the sound driver's writes go through it -- the module
+ * answers 'no memory' to a handle it does not know (the sound's own map's). */
+void
+hakios_adsp_tone_page(volatile uint32_t **page, uint32_t *handle)
+{
+	static volatile uint32_t *stage;
+	static uint32_t h;
+
+	if (stage == NULL) {
+		uint64_t pa = smem_phys + 0x1fe000;
+
+		stage = (volatile uint32_t *)ml_io_map(pa, 0x1000);
+		h = apm_shmem_map(pa, 0x1000);
+	}
+	*page = stage;
+	*handle = h;
+}
+
+uint64_t
+hakios_adsp_smem_phys(void)
+{
+	/* the DDR staging is DEADLY on this phone: the map command with a DDR address
+	 * faults the DSP at map time (posal touches the page), SMMU cover or not -- the
+	 * only surviving sound rounds are the ones where it never ran. Default OFF;
+	 * adsp_ddr=1 brings it back for experiments */
+	uint32_t ddr = 0;
+
+	PE_parse_boot_argn("adsp_ddr", &ddr, sizeof(ddr));
+	hakios_adsp_ddr_staging = ddr != 0;
+	return smem_phys;
+}
+
+/* Whether the audio DSP answers at all: asked by the sound path before anything of ours is
+ * set up -- after a panic the loader relaunches bare and the DSP is gone, and the SMMU
+ * writes (and the teardown's) on dead hardware were the data abort. */
+bool
+hakios_adsp_alive(void)
+{
+	if (bridge_on) {
+		extern bool batt_dsp_audio_up(void);
+		/* the battery's own APM poll says READY a few seconds after its link; waited for,
+		 * for the sound's one ask must not lose to the poll's tail */
+		for (unsigned ms = 0; ms < 30000 && !batt_dsp_audio_up(); ms += 100) {
+			sleep_ms(100);
+		}
+		return batt_dsp_audio_up();
+	}
+	if (!glink.up || !glink.channel[CHANNEL_APR].open) {
+		return false;
+	}
+	if (apr_is_gpr) {
+		return hakios_adsp_apr(0, 0, 0, APM_CMD_GET_SPF_STATE, NULL, 0, 500, NULL);
+	}
+	return hakios_adsp_apr(APR_SVC_ADSP_CORE, 0, 0, AVCS_CMD_ADSP_EVENT_GET_STATE, NULL, 0, 500, NULL);
+}
