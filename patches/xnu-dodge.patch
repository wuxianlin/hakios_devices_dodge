+			say("sound: %s: the A form REFUSED: %s (status %u)\n", what, dsp_error(answer->words[1]),
+			    answer->words[1]);
+			/* the C form: the same offset-mode map, but the descriptor's address is the
+			 * page's OWN OFFSET within the shared memory -- the DSP hands every map of
+			 * ours the SAME handle (a pool-wide node), so "offset zero" names the pool's
+			 * base, not our page, and the APM reads the wrong bytes as the payload */
