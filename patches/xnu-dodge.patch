+		bad[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		bad[2] = 0x2011;                                  /* src: a graph client port */
+		bad[3] = 1;                                       /* dst: the APM */
+		bad[4] = token = apr_next_token++;
+		bad[5] = APM_CMD_GRAPH_OPEN;
+		bad[8] = 0;                                       /* in band */
+		bad[9] = 128;                                     /* payload size */
+		lck_mtx_lock(&apr_lock);
+		apr_answer.there = false;
+		apr_waited_for = token;
+		if (apr_channel_send(bad, 24 + 16 + 128) == 0) {
+			apr_out++;
+			for (uint32_t t = 0; t < 2000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+				sleep_ms(20);
+			}
+			printf("adsp: THE GARBAGE GRAPH: %s (the status %u: 2=EBADPARAM means the parser looked,"
+			    " 1=EFAILED means it died before)\n",
+			    os_atomic_load(&apr_answer.there, acquire) ? "answered" : "no answer",
+			    apr_answer.words[1]);
