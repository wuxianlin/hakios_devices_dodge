+hakios_adsp_oob_send_b(uint32_t src_port, uint32_t opcode, const void *payload, uint32_t length, uint32_t ms,
+    struct hakios_apr_answer *answer)
+{
+	static volatile uint32_t *stage;
+	static uint32_t handle;
+	uint32_t w[16], token;      /* sixteen: the map block uses through w[10] (ten ran past, and the stack protector caught it) */
+	bool answered = false;
+
+	if (length == 0 || length > 0x1000) {
+		return false;
+	}
+	if (stage == NULL) {
+		uint64_t stage_pa = smem_phys + 0x1fc000;
+
+		stage = (volatile uint32_t *)ml_io_map(stage_pa, 0x1000);
+		w[6] = (1u << 16) | 3u;                           /* one region, pool 3 */
+		w[7] = 0;                                         /* property 0: a plain physical map */
+		w[8] = (uint32_t)stage_pa;
+		w[9] = (uint32_t)(stage_pa >> 32);
+		w[10] = 0x1000;
+		lck_mtx_lock(&apr_lock);
+		w[0] = (44u << 8) | (6u << 4);
+		w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+		w[2] = 0x2002;
+		w[3] = 1;
+		w[4] = token = apr_next_token++;
+		w[5] = APM_CMD_SHARED_MEM_MAP;
+		apr_answer.there = false;
+		apr_waited_for = token;
+		if (apr_channel_send(w, 44) == 0) {
+			apr_out++;
+			for (uint32_t t = 0; t < 2000 && !os_atomic_load(&apr_answer.there, acquire); t += 20) {
+				sleep_ms(20);
+			}
+			if (os_atomic_load(&apr_answer.there, acquire) && apr_answer.opcode == APM_CMD_RSP_SHARED_MEM_MAP) {
+				handle = apr_answer.words[0];
+			}
+		}
+		lck_mtx_unlock(&apr_lock);
+		if (stage == NULL || handle == 0) {
+			return false;
+		}
+	}
+	for (uint32_t i = 0; i < (length + 3) / 4; i++) {
+		stage[i] = ((const uint32_t *)payload)[i];
+	}
+	__asm__ volatile ("dsb sy");
+	bzero(w, sizeof(w));
+	w[0] = (40u << 8) | (6u << 4);
+	w[1] = (GPR_DOMAIN_ID_APPS << 8) | GPR_DOMAIN_ID_ADSP;
+	w[2] = src_port;
+	w[3] = 1;
+	w[5] = opcode;
+	{
+		uint64_t stage_pa = smem_phys + 0x1fc000;
+
+		w[6] = (uint32_t)stage_pa;                   /* the REAL address: a plain map is looked up by it */
+		w[7] = (uint32_t)(stage_pa >> 32);
+	}
+	w[8] = handle;
+	w[9] = length;
+	lck_mtx_lock(&apr_lock);
+	token = apr_next_token++;
+	w[4] = token;
+	apr_answer.there = false;
+	apr_waited_for = token;
+	if (apr_channel_send(w, 40) == 0) {
+		apr_out++;
+		for (uint32_t t = 0; t < ms && !answered; t += 20) {
+			answered = os_atomic_load(&apr_answer.there, acquire) && apr_answer.token == token;
+			if (!answered) {
+				lck_mtx_unlock(&apr_lock);
+				sleep_ms(20);
+				lck_mtx_lock(&apr_lock);
+			}
+		}
+		if (answered && answer != NULL) {
+			memcpy(answer, &apr_answer, sizeof(*answer));
+		}
+	}
+	lck_mtx_unlock(&apr_lock);
+	return answered;
+}
+
+/* The E form: the payload staged in the LOWDMA window -- real DDR, like every page
+ * the HAL itself maps (all of ours were the shared memory). */
+bool
+hakios_adsp_oob_send_e(uint32_t src_port, uint32_t opcode, const void *payload, uint32_t length, uint32_t ms,
+    struct hakios_apr_answer *answer)
+{
+	static volatile uint32_t *stage;
+	static uint32_t handle;
+	uint32_t w[16], token;
